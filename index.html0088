<script type="module">
/* ============================================================
   تنظیمات فایربیس
   ============================================================ */
const firebaseConfig = {
  apiKey: "AIzaSyA493Bu5c0KulCIJzobNvXmQDsw5AkkuJI",
  authDomain: "soperprochat-12.firebaseapp.com",
  projectId: "soperprochat-12",
  storageBucket: "soperprochat-12.firebasestorage.app",
  messagingSenderId: "542316141846",
  appId: "1:542316141846:web:65ff7dd0ac182447aa4437"
};
const ADMIN_ID = "hakem";

/* لود کتابخانه‌ی فایربیس از چند منبع (اگر یکی فیلتر بود سراغ بعدی) */
const SDK_V = '10.12.2';
const SDK_SRC = [
  n => `https://www.gstatic.com/firebasejs/${SDK_V}/firebase-${n}.js`,
  n => `https://cdn.jsdelivr.net/npm/firebase@${SDK_V}/${n}/+esm`
];
let SDK_ = null;
for (const f of SDK_SRC) {
  try { const [app, auth, firestore] = await Promise.all(['app', 'auth', 'firestore'].map(n => import(f(n)))); SDK_ = { app, auth, firestore }; break; } catch (e) { /* منبع بعدی */ }
}
if (!SDK_) {
  document.body.insertAdjacentHTML('afterbegin', '<div style="position:fixed;inset:0;z-index:99999;background:#050505;color:#f3ead0;display:grid;place-items:center;text-align:center;padding:24px;line-height:2;font-family:Tahoma,sans-serif">اتصال برقرار نشد 😕<br>فیلترشکن را روشن کن و صفحه را دوباره باز کن.<br><button onclick="location.reload()" style="margin-top:12px;background:#d4af37;color:#3a2800;border-radius:10px;padding:10px 22px;font-weight:700">تلاش دوباره</button></div>');
  throw new Error('firebase sdk blocked');
}
const {initializeApp} = SDK_.app;
const {getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged, signOut, setPersistence, indexedDBLocalPersistence, browserLocalPersistence,
  sendEmailVerification, sendPasswordResetEmail, EmailAuthProvider, reauthenticateWithCredential, updatePassword, updateProfile} = SDK_.auth;
const {getFirestore, initializeFirestore, persistentLocalCache, persistentMultipleTabManager, FieldPath, arrayUnion, arrayRemove,
  doc, getDoc, getDocs, writeBatch, deleteDoc, setDoc, updateDoc, addDoc, collection, query, where, orderBy, limitToLast, onSnapshot,
  serverTimestamp, runTransaction, deleteField, increment, disableNetwork, enableNetwork} = SDK_.firestore;

const $ = id => document.getElementById(id);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
/* ورود دائمی: یک بار وارد شد، تا خروج دستی داخل می‌ماند */
const persistReady = setPersistence(auth, indexedDBLocalPersistence).catch(() => setPersistence(auth, browserLocalPersistence)).catch(() => {});
let db;
try { db = initializeFirestore(app, { localCache: persistentLocalCache({ tabManager: persistentMultipleTabManager() }), experimentalForceLongPolling: true }); }
catch { try { db = initializeFirestore(app, { experimentalForceLongPolling: true }); } catch { db = getFirestore(app); } }

let me = null, users = {}, rooms = {}, room = 'public', msgs = [];
let replyTo = null, editing = null, filter = '';
let unsubMsgs = null, unsubUsers = null, unsubRooms = null, unsubPublic = null, unsubStories = null, beat = null, hdrT = null, netT = null;
let usersSig = '', typingSent = 0;
const prevLast = {}, drafts = {};
let soundOn = localStorage.getItem('snd') !== '0';
const setTheme = t => { document.documentElement.dataset.theme = t; localStorage.setItem('theme', t); };
setTheme(localStorage.getItem('theme') || 'gold');

/* ---------- کمک‌ها ---------- */
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const linkify = s => esc(s).replace(/(https?:\/\/[^\s<]+)/g, u => `<a href="${u}" target="_blank" rel="noopener noreferrer">${u}</a>`);
const fa = n => String(n).replace(/\d/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
const toast = t => { const d = document.createElement('div'); d.id = 'toast'; d.textContent = t; document.body.appendChild(d); setTimeout(() => d.remove(), 2600); };
const net = show => $('net').classList.toggle('hidden', !show);
window.addEventListener('offline', () => net(true));
window.addEventListener('online', () => net(false));
const hhmm = ms => fa(new Date(ms).toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' }));
const avatarHtml = u => { const src = u?.photo || (me && u?.uid === me.uid ? u.photoPending : ''); return src ? `<img src="${src}" alt="">` : esc(Array.from((u?.name || '?').trim())[0] || '?'); };
const isOnline = u => u?.lastSeen?.toMillis && Date.now() - u.lastSeen.toMillis() < 70000;
function lastSeenText(u) {
  if (!u) return '';
  if (isOnline(u)) return 'آنلاین';
  const t = u.lastSeen?.toMillis?.(); if (!t) return 'آفلاین';
  const m = Math.floor((Date.now() - t) / 60000);
  if (m < 60) return `آخرین بازدید ${fa(Math.max(1, m))} دقیقه پیش`;
  if (m < 1440) return `آخرین بازدید ${fa(Math.floor(m / 60))} ساعت پیش`;
  return `آخرین بازدید ${fa(Math.floor(m / 1440))} روز پیش`;
}
const isAdmin = () => me && me.handle === ADMIN_ID;
const dmId = (a, b) => 'dm_' + [a, b].sort().join('_');
const roomType = id => id === 'public' ? 'public' : id === 'channel' ? 'channel' : id.startsWith('saved_') ? 'saved' : id.startsWith('dm_') ? 'dm' : 'group';
const dmPeerId = id => id.split('_').slice(1).find(x => x !== me.uid);
const membersOf = id => { const t = roomType(id); return t === 'dm' ? id.split('_').slice(1) : t === 'saved' ? [id.slice(6)] : null; };
const savedId = () => 'saved_' + me.uid;
const onlineCount = () => Object.values(users).filter(isOnline).length;

const BANNERS = { sunset: ['#ff7e5f', '#b24592'], ocean: ['#2193b0', '#6dd5ed'], emerald: ['#11998e', '#38ef7d'], raspberry: ['#8e3a59', '#d9739a'], night: ['#232526', '#556270'], gold: ['#b8860b', '#f5d77a'], violet: ['#6a11cb', '#e100ff'], fire: ['#f12711', '#f5af19'] };
const FRAMES = { none: 'بدون', gold: 'طلایی', neon: 'نئون', rainbow: 'رنگین‌کمان', fire: 'آتش', ice: 'یخی' };
const frameCls = u => u?.frame && u.frame !== 'none' ? 'f-' + u.frame : '';
const autoBanner = uid => Object.keys(BANNERS)[[...String(uid)].reduce((a, c) => a + c.charCodeAt(0), 0) % Object.keys(BANNERS).length];
const joinedDays = u => { const t = u?.createdAt?.toMillis?.(); return t ? Math.max(0, Math.floor((Date.now() - t) / 864e5)) : 0; };
const pointsOf = u => (u?.msgCount || 0) * 3 + joinedDays(u) * 5;
const levelOf = p => 1 + Math.floor(p / 100);
const titleOf = u => u.title || (lv => lv >= 15 ? 'فرعون 👑' : lv >= 10 ? 'افسانه‌ای' : lv >= 6 ? 'حرفه‌ای' : lv >= 3 ? 'فعال' : 'تازه‌وارد')(levelOf(pointsOf(u)));

/* وضعیت چت خصوصی: none | wait | incoming | declined | declinedByMe | ok */
function dmState(id) {
  const r = rooms[id]; if (!r) return 'none';
  const st = r.status || 'accepted';
  if (st === 'accepted') return 'ok';
  if (st === 'pending') return r.requester === me.uid ? 'wait' : 'incoming';
  if (st === 'declined') return r.requester === me.uid ? 'declined' : 'declinedByMe';
  return 'ok';
}
/* ظرفیت دوستان: ۲ دوست رایگان؛ هر ۵ دوست بیشتر ۲۰۰ سکه (در تنظیمات) */
const FRIEND_BASE = 2, FRIEND_PACK = 5, FRIEND_PRICE = 200;
const friendCap = u => (u && u.handle === ADMIN_ID) ? Infinity : FRIEND_BASE + FRIEND_PACK * ((u && u.friendSlots) || 0);
const friendUsed = () => Object.keys(rooms).filter(id => roomType(id) === 'dm' && ['ok', 'wait'].includes(dmState(id))).length;
const capText = u => friendCap(u) === Infinity ? 'نامحدود' : fa(friendCap(u));
async function buyFriendSlots(back) {
  try {
    await runTransaction(db, async tx => {
      const ref = doc(db, 'users', me.uid), u = (await tx.get(ref)).data();
      if (coinsOf(u) < FRIEND_PRICE) throw 'poor';
      selfOpAt = Date.now();
      tx.update(ref, { friendSlots: increment(1), spent: increment(FRIEND_PRICE) });
    });
    me.friendSlots = (me.friendSlots || 0) + 1; me.spent = (me.spent || 0) + FRIEND_PRICE;   // نمایش فوری
    toast(`🤝 ظرفیت دوستان ${fa(FRIEND_PACK)} تا زیاد شد`);
    if (back) $('btnSettings').click(); else closeModal();
  } catch (e) { toast(e === 'poor' ? 'سکه‌ی کافی نداری (۲۰۰ سکه لازم است)' : 'خرید انجام نشد'); }
}
function friendFullModal() {
  openModal(`<div style="font-size:2.6rem">🤝</div><h3>ظرفیت دوستان پر است</h3>
    <p style="color:var(--mut);line-height:2;font-size:.9rem">ظرفیت تو ${capText(me)} دوست است و ${fa(friendUsed())} تا پر شده.<br>هر ${fa(FRIEND_PACK)} دوست بیشتر: 🪙 ${fa(FRIEND_PRICE)} (موجودی تو: 🪙 ${fa(coinsOf(me))})</p>
    <div class="acts2"><button class="btn" id="fBuy">خرید ظرفیت (🪙 ${fa(FRIEND_PRICE)})</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal; $('fBuy').onclick = () => buyFriendSlots(false);
}
async function sendRequest(note) {
  if (friendUsed() >= friendCap(me)) return friendFullModal();
  const pid = dmPeerId(room);
  try {
    await setDoc(doc(db, 'rooms', room), { type: 'dm', members: [me.uid, pid], status: 'pending', requester: me.uid, note: (note || '').trim().slice(0, 100), requestedAt: Date.now() });
    toast('درخواست ارسال شد');
  } catch { toast('ارسال نشد. قوانین Firestore را بررسی کنید.'); }
}
const respond = (id, ok) => {
  if (ok && friendUsed() >= friendCap(me)) return friendFullModal();
  return updateDoc(doc(db, 'rooms', id), { status: ok ? 'accepted' : 'declined' }).catch(() => toast('انجام نشد'));
};

let gateKey = '';
function renderGate() {
  if (!me) return;
  const g = $('dmGate'), st = isMuted(me) ? 'muted' : (room === 'channel' && !isAdmin()) ? 'ro' : (roomType(room) === 'dm' ? dmState(room) : 'ok');
  g.classList.toggle('hidden', st === 'ok'); $('composer').classList.toggle('hidden', st !== 'ok');
  if (st === 'ok') { gateKey = ''; return; }
  const r = rooms[room] || {}, key = room + st + (r.note || '') + (users[dmPeerId(room)]?.name || '');
  if (key === gateKey) return; gateKey = key;
  const nm = esc(users[dmPeerId(room)]?.name || 'کاربر');
  const note = r.note ? `<div class="gnote">«${esc(r.note)}»</div>` : '';
  const map = {
    none: `<div class="gico">💌</div><b>چت خصوصی با ${nm}</b><p>برای شروع باید درخواست بفرستی تا او بپذیرد.</p><input id="gNote" maxlength="100" placeholder="پیام معرفی (اختیاری)"><button class="btn" id="gSend">ارسال درخواست</button>`,
    wait: `<div class="gico">⏳</div><b>منتظر پذیرش ${nm}</b><p>درخواست شما ارسال شد.</p>${note}`,
    incoming: `<div class="gico">🔔</div><b>${nm} می‌خواهد با تو چت خصوصی کند</b>${note}<div class="gbtns"><button class="btn" id="gAcc">قبول</button><button class="btn danger" id="gDec">رد</button></div>`,
    declined: `<div class="gico">🚫</div><b>درخواست شما پذیرفته نشد</b>`,
    declinedByMe: `<div class="gico">🚫</div><b>این درخواست را رد کردی</b><button class="btn ghost" id="gAcc">پذیرفتن</button>`
  };
  map.muted = `<div class="gico">🔇</div><b>شما ساکت شده‌اید</b><p>${(me.mutedUntil || 0) > Date.now() + 3e11 ? 'تا اطلاع بعدی نمی‌توانید پیام بدهید.' : 'تا ساعت ' + hhmm(me.mutedUntil) + ' نمی‌توانید پیام بدهید.'}</p>`;
  map.ro = `<div class="gico">📣</div><b>کانال فقط‌خواندنی است</b><p>اطلاعیه‌ها و آپدیت‌های رسمی اینجا خودکار منتشر می‌شوند.</p>`;
  g.innerHTML = map[st];
  $('gSend')?.addEventListener('click', () => sendRequest($('gNote').value));
  $('gAcc')?.addEventListener('click', () => respond(room, true));
  $('gDec')?.addEventListener('click', () => respond(room, false));
}
function reqRow(id) {
  const r = rooms[id], u = users[r.requester];
  return `<div class="row req ${room === id ? 'on' : ''}" data-room="${id}" role="button" tabindex="0">
    <div class="av ${frameCls(u)}">${avatarHtml(u)}</div><div class="nm"><b>${esc(u?.name || 'کاربر')}</b><small>${esc(r.note || 'درخواست چت خصوصی')}</small></div>
    <div class="reqbtns"><button class="icon ok" data-acc="${id}" aria-label="قبول">✓</button><button class="icon no" data-dec="${id}" aria-label="رد">✕</button></div></div>`;
}


function shrinkImage(file, max, q = .78) {
  return new Promise((res, rej) => {
    const img = new Image(), url = URL.createObjectURL(file);
    img.onload = () => {
      const k = Math.min(1, max / Math.max(img.width, img.height));
      const c = document.createElement('canvas'); c.width = img.width * k; c.height = img.height * k;
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      URL.revokeObjectURL(url); res(c.toDataURL('image/jpeg', q));
    };
    img.onerror = rej; img.src = url;
  });
}

/* ---------- ورود و ثبت نام با آیدی و رمز ---------- */
let mode = 'login', unsubSess = null, pingN = 0;
const emailOf = h => `${h}@prochat.app`;                       // فایربیس ایمیل می‌خواهد؛ از روی آیدی ساخته می‌شود
const enDigits = v => v.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));
const hid = u => u && u.handle ? '@' + esc(u.handle) : '<span style="opacity:.6">بدون آیدی</span>';
const fmtT = t => t?.toDate ? t.toDate().toLocaleString('fa-IR', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
function setMode(m) {
  mode = m;
  $('tabLogin').classList.toggle('on', m === 'login'); $('tabReg').classList.toggle('on', m === 'reg');
  $('fName').classList.toggle('hidden', m !== 'reg');
  $('authBtn').textContent = m === 'reg' ? 'ساخت حساب' : 'ورود';
  $('inPass').autocomplete = m === 'reg' ? 'new-password' : 'current-password';
  $('authErr').textContent = '';
}
$('tabLogin').onclick = () => setMode('login'); $('tabReg').onclick = () => setMode('reg');
const authMsg = c => ({
  'auth/email-already-in-use': 'این آیدی قبلا گرفته شده است.',
  'auth/invalid-credential': 'آیدی یا رمز عبور اشتباه است.',
  'auth/wrong-password': 'رمز عبور اشتباه است.',
  'auth/user-not-found': 'کاربری با این آیدی پیدا نشد.',
  'auth/invalid-email': 'آیدی معتبر نیست.',
  'auth/weak-password': 'رمز عبور باید حداقل ۶ کاراکتر باشد.',
  'auth/network-request-failed': 'به فایربیس وصل نمی‌شود. اگر VPN ندارید روشنش کنید.',
  'auth/operation-not-allowed': 'در Firebase روش Email/Password را فعال کنید.',
  'auth/requires-recent-login': 'برای این کار یک بار خارج و دوباره وارد شو.',
  'auth/user-disabled': 'این حساب غیرفعال شده است.',
  'auth/too-many-requests': 'تلاش زیاد. چند دقیقه بعد دوباره امتحان کنید.',
  'permission-denied': 'اجازه‌ی انجام این کار نیست (قوانین Firestore را بررسی کن).'
}[c] || 'خطا: ' + c);

$('authBtn').onclick = async () => {
  const h = $('inId').value.trim().toLowerCase(), pass = $('inPass').value, name = $('inName').value.trim();
  $('authErr').textContent = '';
  if (!/^[a-z0-9_]{3,20}$/.test(h)) return $('authErr').textContent = 'آیدی باید ۳ تا ۲۰ حرف انگلیسی، عدد یا _ باشد.';
  if (mode === 'reg') {
    if (!name) return $('authErr').textContent = 'نام نمایشی را وارد کنید.';
    if (badCheck(name) || badCheck(h) || h === ADMIN_ID) return $('authErr').textContent = 'این نام یا آیدی مجاز نیست.';
  }
  $('authBtn').disabled = true;
  try {
    if (mode === 'reg') {
      const cred = await createUserWithEmailAndPassword(auth, emailOf(h), pass);
      try {
        await runTransaction(db, async tx => {
          const hr = doc(db, 'handles', h);
          if ((await tx.get(hr)).exists()) throw 'taken';
          tx.set(hr, { uid: cred.user.uid });
          tx.set(doc(db, 'users', cred.user.uid), { uid: cred.user.uid, name, handle: h, photo: '', bio: '', banned: false, lastSeen: serverTimestamp(), createdAt: serverTimestamp() });
        });
      } catch (e) { try { await cred.user.delete(); } catch {} throw { code: e === 'taken' ? 'auth/email-already-in-use' : (e.code || 'x') }; }
    } else await signInWithEmailAndPassword(auth, emailOf(h), pass);
  } catch (e) { $('authErr').textContent = authMsg(e.code); }
  $('authBtn').disabled = false;
};
[$('inId'), $('inPass'), $('inName')].forEach(i => i.addEventListener('keydown', e => e.key === 'Enter' && $('authBtn').click()));

const showAuthScreen = () => { $('splash').classList.add('hidden'); $('auth').classList.remove('hidden'); };
const keepIn = on => { try { on ? localStorage.setItem('pc_auto', '1') : localStorage.removeItem('pc_auto'); } catch {} };
/* اگر به هر دلیل ورود بازیابی نشد، بعد از ۱۲ ثانیه صفحه ورود نشان داده شود */
setTimeout(() => { if (!me && !$('splash').classList.contains('hidden')) showAuthScreen(); }, 12000);

/* ---------- نشست‌ها (دستگاه‌های وارد شده) ---------- */
const deviceLabel = () => {
  const ua = navigator.userAgent;
  const os = /Android/i.test(ua) ? 'Android' : /iPhone|iPad|iPod/i.test(ua) ? 'iOS' : /Windows/i.test(ua) ? 'Windows' : /Mac OS/i.test(ua) ? 'macOS' : /Linux/i.test(ua) ? 'Linux' : 'دستگاه نامشخص';
  const br = /Edg\//.test(ua) ? 'Edge' : /OPR\/|Opera/.test(ua) ? 'Opera' : /SamsungBrowser/.test(ua) ? 'Samsung Internet' : /Firefox\//.test(ua) ? 'Firefox' : /Chrome\//.test(ua) ? 'Chrome' : /Safari\//.test(ua) ? 'Safari' : 'مرورگر';
  return os + ' • ' + br;
};
const sessRef = id => doc(db, 'users', me.uid, 'sessions', id);
function startSession() {
  let sid = localStorage.getItem('pc_sid');
  if (!sid || localStorage.getItem('pc_sid_uid') !== me.uid) {
    sid = 's' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
    localStorage.setItem('pc_sid', sid); localStorage.setItem('pc_sid_uid', me.uid);
    setDoc(sessRef(sid), { device: deviceLabel(), createdAt: serverTimestamp(), lastActive: serverTimestamp(), revoked: false, ended: false }).catch(() => {});
  } else setDoc(sessRef(sid), { device: deviceLabel(), lastActive: serverTimestamp() }, { merge: true }).catch(() => {});
  unsubSess?.();
  unsubSess = onSnapshot(sessRef(sid), s => { if (s.exists() && s.data().revoked) { toast('از این دستگاه خارج شدی'); endSession(false); } }, () => {});
}
async function endSession(mark = true) {
  const sid = localStorage.getItem('pc_sid');
  if (mark && sid && me) { try { await updateDoc(sessRef(sid), { ended: true, lastActive: serverTimestamp() }); } catch {} }
  localStorage.removeItem('pc_sid'); localStorage.removeItem('pc_sid_uid'); keepIn(false);
  await signOut(auth);
}

/* ---------- ورود به برنامه ---------- */
async function boot(u) {
  if (!u) { keepIn(false); stopAll(); $('app').classList.add('hidden'); showAuthScreen(); return; }
  if (me && me.uid === u.uid) return;
  keepIn(true);
  let snap;
  for (let t = 0; t < 8; t++) {                       // بعد از ثبت نام، چند لحظه صبر می‌کنیم تا پروفایل ساخته شود
    try { snap = await getDoc(doc(db, 'users', u.uid)); }
    catch { net(true); $('splash').classList.add('hidden'); $('app').classList.remove('hidden'); return; }
    if (snap.exists()) break;
    await new Promise(r => setTimeout(r, 500));
  }
  if (!snap.exists()) { keepIn(false); showAuthScreen(); return; }
  me = snap.data();
  if (me.banned) { await signOut(auth); return alert('حساب شما مسدود شده است.'); }
  $('auth').classList.add('hidden'); $('splash').classList.add('hidden'); $('app').classList.remove('hidden');
  paintMe(); startPresence(); startSession(); listenAll(); listenGroupReqs(); listenBotCfg(); listenStats(); listenGifts(); listenMarket(); botStart(); openRoom('public'); autoAnnounce();
}
onAuthStateChanged(auth, boot);
function stopAll() { qzStop(); unsubClans?.(); unsubClans = null; clanList = []; unsubGifts?.(); unsubMarket?.(); unsubSales?.(); marketList = []; unsubSess?.(); unsubSess = null; unsubStories?.(); unsubStories = null; stories = {}; stopReqs(); unsubMsgs?.(); unsubUsers?.(); unsubRooms?.(); unsubPublic?.(); unsubChannel?.(); npStop(); clearInterval(beat); clearInterval(hdrT); me = null; users = {}; rooms = {}; }
$('btnLogout').onclick = () => endSession(true);
function paintMe() {
  $('meAv').innerHTML = `<div class="av ${frameCls(me)}">${avatarHtml(me)}</div>${me.vip ? '<i class="crown">👑</i>' : ''}`;
  const p = pointsOf(me);
  $('meName').innerHTML = esc(me.name) + (me.vip ? ' <span class="nmc">👑</span>' : '') + roleBadges(me);
  $('meCoins').textContent = fa(coinsOf(me)); $('meLvl').textContent = 'Level ' + fa(levelOf(p));
  $('meXp').style.width = (p % 100) + '%'; $('meXpT').textContent = fa(p % 100) + '/' + fa(100);
  $('btnAdmin').classList.toggle('hidden', !(isAdmin() || me.mod)); giftWatch(); paintClan();
}

function startPresence() {
  const ping = () => {
    if (!me) return;
    updateDoc(doc(db, 'users', me.uid), { lastSeen: serverTimestamp() }).catch(() => {});
    if (pingN++ % 10 === 0) { const sid = localStorage.getItem('pc_sid'); if (sid) updateDoc(sessRef(sid), { lastActive: serverTimestamp() }).catch(() => {}); }
  };
  ping(); clearInterval(beat); beat = setInterval(ping, 30000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { ping(); markRead(); } });
}

/* ---------- گوش دادن به داده‌ها ---------- */
function listenAll() {
  listenStories();
  unsubUsers = onSnapshot(collection(db, 'users'), s => {
    clearTimeout(netT);
    if (s.metadata.fromCache) netT = setTimeout(() => net(true), 8000); else net(false);
    users = {}; s.forEach(d => users[d.id] = d.data());
    if (users[me.uid]) { me = users[me.uid]; if (me.banned) signOut(auth); paintMe(); }
    renderList(); renderHeader(); if (!$('shop').classList.contains('hidden')) renderShop(); updateAdmBadge(); if (!$('admin').classList.contains('hidden')) renderAdmin(); setTimeout(maybeWelcome, 700);
    const sig = Object.values(users).map(u => u.uid + u.name + (u.photo || '').length + (u.frame || '') + (u.msgCount || 0)).join('|');
    if (sig !== usersSig) { usersSig = sig; renderMsgs(); }
  }, () => net(true));

  let firstR = true;
  unsubRooms = onSnapshot(query(collection(db, 'rooms'), where('members', 'array-contains', me.uid)), s => {
    s.docChanges().forEach(c => { if (c.type === 'removed') delete rooms[c.doc.id]; else roomUpdated(c.doc.id, c.doc.data(), firstR); });
    firstR = false; renderList(); renderHeader(); renderPin();
  }, () => net(true));

  let firstP = true;
  unsubPublic = onSnapshot(doc(db, 'rooms', 'public'), s => {
    if (s.exists()) roomUpdated('public', s.data(), firstP);
    firstP = false; renderList(); renderHeader(); renderPin();
  });
  listenClans();
  let firstC = true;
  unsubChannel = onSnapshot(doc(db, 'rooms', 'channel'), s => {
    if (s.exists()) roomUpdated('channel', s.data(), firstC);
    firstC = false; renderList(); renderHeader(); renderPin();
  }, () => {});
  clearInterval(hdrT); hdrT = setInterval(() => { renderList(); renderHeader(); }, 2000);
}

function roomUpdated(id, data, first) {
  const was = rooms[id]; rooms[id] = data;
  if (data.status === 'pending' && data.requester !== me.uid && !first && was?.status !== 'pending') { beep(); toast(`${users[data.requester]?.name || 'کسی'} درخواست چت خصوصی داد 🔔`); }
  if (was?.status === 'pending' && data.status === 'accepted' && data.requester === me.uid) toast('درخواست چت شما پذیرفته شد 🎉');
  const l = data.last;
  if (l && !first && l.t > (prevLast[id] || 0) && l.uid !== me.uid && !(id === room && !document.hidden)) {
    beep();
    if (document.hidden && 'Notification' in window && Notification.permission === 'granted') {
      try { new Notification(l.name || 'پیام جدید', { body: l.text }); } catch {}
    } else if (id !== room) toast(`${l.name}: ${l.text}`);
  }
  if (l) prevLast[id] = Math.max(prevLast[id] || 0, l.t);
  if (id === room) markRead();
}
function markRead() {
  if (!me || document.hidden) return;
  const r = rooms[room], l = r?.last;
  if (r && ((r.unread?.[me.uid] || 0) > 0 || (l && l.uid !== me.uid && l.t > (r.read?.[me.uid] || 0))))
    setDoc(doc(db, 'rooms', room), { read: { [me.uid]: Date.now() }, unread: { [me.uid]: 0 } }, { merge: true }).catch(() => {});
}

/* ---------- اطلاعات گفتگو ---------- */
function typers(id) {
  const t = rooms[id]?.typing || {};
  const n = Object.entries(t).filter(([k, v]) => k !== me.uid && Date.now() - v < 4500).map(([k]) => users[k]?.name).filter(Boolean);
  return n.length ? n.slice(0, 2).join('، ') + ' در حال نوشتن…' : '';
}
function info(id) {
  const t = roomType(id), r = rooms[id] || {};
  if (t === 'channel') return { title: 'کانال رسمی پرو چت', av: `<img src="${CH_PHOTO}" alt="">`, sub: 'اطلاعیه‌ها و آپدیت‌های رسمی', badges: '<i class="vb blue">✔</i>', ring: '#4da3ff' };
  if (t === 'public') return { title: 'چت روم عمومی پرو چت', av: '★', sub: fa(onlineCount()) + ' نفر آنلاین', badges: '<i class="vb green" style="border-radius:50%">✔</i>', ring: 'var(--gold)', online: true };
  if (t === 'saved') return { title: 'پیام‌های ذخیره‌شده', av: '🔖', sub: 'فقط برای شما', ring: '#ff4d6d' };
  if (t === 'dm') { const u = users[dmPeerId(id)]; return { title: u?.name || 'کاربر', av: u ? avatarHtml(u) : '?', sub: lastSeenText(u), user: u, badges: roleBadges(u), ring: ringOf(u?.uid), online: isOnline(u) }; }
  return { title: r.name || 'کلن', av: r.photo ? `<img src="${r.photo}" alt="">` : esc(r.emoji || '👥'), sub: fa((r.members || []).length) + ' عضو' + (r.handle ? ' • @' + r.handle : r.deal ? ' • معامله' : ''), group: true, ring: ringOf(id) };
}

/* ---------- لیست کناری ---------- */
$('userSearch').oninput = renderList;
const RING = ['#2ec4ff', '#8b5cf6', '#ff8a00', '#ff4d6d', '#38d26b', '#ffd400'];
const ringOf = k => RING[[...String(k || 'x')].reduce((a, c) => a + c.charCodeAt(0), 0) % RING.length];
function avw(inner, u, cls = '') {
  return `<div class="avw"><div class="av ${cls} ${frameCls(u)}" style="--ring:${ringOf(u?.uid)}">${inner}</div>${isOnline(u) ? '<i class="odot on"></i>' : ''}</div>`;
}
let topTab = 'chats', subTab = 'rooms', onlyUnread = false, lastListHtml = '';
function unreadOf(id) {
  if (id === room && !document.hidden) return 0;
  const r = rooms[id] || {}, n = r.unread?.[me.uid] || 0, l = r.last;
  if (n > 0) return n;
  return (l && l.uid !== me.uid && l.t > (r.read?.[me.uid] || 0)) ? -1 : 0;
}
const badgeHtml = n => n > 0 ? `<span class="badge">${n > 99 ? '۹۹+' : fa(n)}</span>` : n < 0 ? '<span class="badge dotb"></span>' : '';
/* نشان‌های کنار نام: تیک آبی = مدیر، سپر سبز = ناظر، ستاره = VIP */
const roleBadges = u => !u ? '' : (u.handle === ADMIN_ID ? '<i class="vb blue" title="مدیر">✔</i>' : '') + (u.mod ? '<i class="vb green" title="ناظر">🛡</i>' : '') + (u.vip ? '<i class="vb gold" title="VIP">★</i>' : '');
const CH_PHOTO = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f5d77a"/><stop offset="1" stop-color="#8a6d12"/></linearGradient></defs><rect width="100" height="100" fill="#0b0903"/><circle cx="50" cy="50" r="38" fill="url(#g)"/><text x="50" y="66" font-size="48" font-weight="800" text-anchor="middle" fill="#1a1400" font-family="Arial">P</text></svg>');
const CH_U = { name: 'کانال رسمی پرو چت', handle: 'prochat', photo: CH_PHOTO, uid: 'channel' };
function chatRow(id) {
  const t = roomType(id), i = info(id), r = rooms[id] || {}, l = r.last, n = unreadOf(id), ty = typers(id);
  const st0 = t === 'dm' ? dmState(id) : 'ok';
  let prev = ty ? `<small class="typing">${esc(ty)}</small>` : l
    ? `<small>${esc((l.uid === me.uid && t !== 'channel' ? 'شما: ' : (t === 'dm' || t === 'channel') ? '' : l.name + ': ') + l.text)}</small>`
    : `<small>${t === 'public' ? 'گفتگوی همه' : t === 'channel' ? 'اطلاعیه‌ها و آپدیت‌های رسمی' : 'هنوز پیامی نیست'}</small>`;
  if (st0 === 'wait') prev = '<small>⏳ در انتظار پذیرش…</small>';
  let av, cls = 'rc', tag = '';
  if (t === 'channel') { av = `<div class="avw"><div class="av" style="--ring:#4da3ff"><img src="${CH_PHOTO}" alt=""></div></div>`; cls += ' ch'; tag = '<span class="tag">کانال</span>'; }
  else if (t === 'public') { av = `<div class="avw"><div class="av ring-gold">★</div>${onlineCount() ? '<i class="odot on"></i>' : ''}</div>`; cls += ' pub'; tag = '<span class="tag">عمومی ‹</span>'; }
  else if (t === 'saved') { av = `<div class="avw"><div class="av" style="--ring:#ff4d6d">🔖</div></div>`; cls += ' sv'; tag = '<span class="tag">ذخیره</span>'; }
  else if (t === 'dm') av = avw(i.av, i.user);
  else { av = `<div class="avw"><div class="av" style="--ring:${ringOf(id)}">${i.av}</div></div>`; tag = r.deal ? '<span class="tag">🤝 معامله</span>' : '<span class="tag">کلن</span>'; }
  return `<button class="row ${cls} ${room === id ? 'on' : ''}" data-room="${id}">${av}
    <div class="nm"><b>${esc(i.title)}${i.badges || ''}</b>${prev}</div>
    <div class="rt">${l ? `<small>${hhmm(l.t)}</small>` : ''}${badgeHtml(n)}${tag}</div></button>`;
}
const userRow = (u, attr) => `<button class="row rc" ${attr}="${u.uid}">${avw(avatarHtml(u), u)}
  <div class="nm"><b>${esc(u.name)} ${esc(u.badge || '')}${roleBadges(u)}</b><small>${esc(titleOf(u))} • ${esc(lastSeenText(u))}</small></div></button>`;
const guideHtml = () => [
  ['🎮', 'کوییز و بازی‌ها', 'با دکمه‌ی وسط وارد «بازی‌ها» شو. «کلاسیک» ۴ نفره است (۱۰ سوال، ۲۰ ثانیه) و در «حذفی» ۶ نفره، هر کس غلط بزند حذف می‌شود. جواب سریع‌تر = امتیاز بیشتر (۱۰ / ۷ / ۵). برنده سکه می‌گیرد.'],
  ['💬', 'چت رومها و پیوی', 'چت روم عمومی برای همه است. برای پیوی باید درخواست بدهی و طرف قبول کند. «کلن» را فقط VIPها می‌سازند (تا ۳۰ نفر، با آیدی و پروفایل مخصوص)؛ بقیه از «جستجو» عضو کلن‌ها می‌شوند. ظرفیت دوستان ۲ نفر است و از «تنظیمات» قابل افزایش است.'],
  ['🎁', 'هدیه و بازار', 'از روی پروفایل هر کاربر می‌توانی سکه یا کارت هدیه بدهی. کارت‌ها را در «فروشگاه ← بازار» بفروش یا بخر.'],
  ['🎤', 'صدا، موزیک و بازی در چت', 'در هر چت دکمه‌ی ＋ را بزن: ایموجی، عکس، بازی (تاس، شیر یا خط، دعوت به کوییز)، ضبط صدا و ارسال موزیک.'],
  ['🎨', 'زمینه‌ی چت', 'با دکمه‌ی 🎨 بالای هر چت یا از «تنظیمات»، زمینه‌ی دلخواهت را انتخاب یا دانلود کن.'],
  ['📣', 'کانال رسمی', 'هر آپدیت و تغییر تازه‌ی برنامه خودکار در «کانال رسمی پرو چت» اعلام می‌شود.'],
].map(([i, t, d]) => `<div class="gd"><div class="gdi">${i}</div><div><b>${t}</b><p>${d}</p></div></div>`).join('');
function renderList() {
  if (!me) return;
  paintClan();
  const q = $('userSearch').value.trim().toLowerCase();
  const reqIds = Object.keys(rooms).filter(id => roomType(id) === 'dm' && dmState(id) === 'incoming');
  for (const id of ['bellN', 'reqN']) { $(id).textContent = fa(reqIds.length); $(id).classList.toggle('hidden', !reqIds.length); }
  const chatIds = Object.keys(rooms).filter(id => id !== 'public' && id !== 'channel' && roomType(id) !== 'saved' && (roomType(id) === 'group' || (dmState(id) === 'wait' || (dmState(id) === 'ok' && (rooms[id].last || id === room)))));
  const tot = ['channel', 'public', ...chatIds].reduce((a, id) => a + (unreadOf(id) > 0 ? unreadOf(id) : unreadOf(id) < 0 ? 1 : 0), 0);
  $('navN').textContent = tot > 99 ? '۹۹+' : fa(tot); $('navN').classList.toggle('hidden', !tot);
  const groups = chatIds.filter(id => roomType(id) === 'group'), dms = chatIds.filter(id => roomType(id) === 'dm');
  const srt = x => x.sort((a, b) => (rooms[b].last?.t || rooms[b].requestedAt || 0) - (rooms[a].last?.t || rooms[a].requestedAt || 0));
  const un = id => !onlyUnread || unreadOf(id) !== 0;
  document.querySelectorAll('#topTabs [data-tt]').forEach(b => b.classList.toggle('on', b.dataset.tt === topTab));
  document.querySelectorAll('#subTabs [data-st]').forEach(b => b.classList.toggle('on', b.dataset.st === subTab));
  $('btnFilter').classList.toggle('on', onlyUnread);
  $('subTabs').classList.toggle('hidden', topTab !== 'chats');
  $('homeTop').classList.toggle('hidden', topTab !== 'chats' || subTab !== 'rooms');
  $('searchW').classList.toggle('hidden', topTab !== 'search');
  const allUsers = Object.values(users).filter(u => u.uid !== me.uid).sort((a, b) => (isOnline(b) - isOnline(a)) || a.name.localeCompare(b.name, 'fa'));
  let h = '';
  if (topTab === 'chats' && subTab === 'rooms') {
    h += ['channel', 'public', savedId()].filter(un).map(chatRow).join('');
    h += srt(groups.filter(un)).map(chatRow).join('');
    h += '<button class="row newg" data-newg="1"><i class="vipb">VIP</i><span>＋ ساخت کلن جدید</span></button>';
    if (onlyUnread && !groups.some(un) && !['channel', 'public', savedId()].some(un)) h = '<p class="empty" style="padding:22px">همه‌ی پیام‌ها خوانده شده‌اند ✅</p>';
  } else if (topTab === 'chats') {
    const d = srt(dms.filter(un));
    h += d.length ? d.map(chatRow).join('') : `<p class="empty" style="padding:22px 10px">${onlyUnread ? 'همه‌ی پیام‌ها خوانده شده‌اند ✅' : 'هنوز پیوی نداری 👤<br>از «جستجو» یه کاربر پیدا کن و درخواست چت بده.'}</p>${onlyUnread ? '' : '<button class="btn" data-go="search" style="margin-top:6px">🔍 رفتن به جستجو</button>'}`;
  } else if (topTab === 'search') {
    if (q) {
      const rs = ['channel', 'public', savedId(), ...chatIds].filter(id => info(id).title.toLowerCase().includes(q));
      const us = allUsers.filter(u => u.name.toLowerCase().includes(q) || (u.handle || '').includes(q)), cs = clanList.filter(c => (c.name || '').toLowerCase().includes(q) || c.handle.includes(q));
      if (rs.length) h += '<div class="sec">گفتگوها</div>' + rs.map(chatRow).join('');
      if (cs.length) h += '<div class="sec">🏰 کلن‌ها</div>' + cs.map(clanRow).join('');
      if (us.length) h += '<div class="sec">کاربران</div>' + us.map(u => userRow(u, 'data-p')).join('');
      if (!h) h = '<p class="empty" style="padding:22px">چیزی پیدا نشد</p>';
    } else h += (clanList.length ? '<div class="sec">🏰 کلن‌ها</div>' + clanList.slice(0, 30).map(clanRow).join('') : '') + `<div class="sec">${fa(onlineCount())} نفر آنلاین</div>` + (allUsers.length ? allUsers.map(u => userRow(u, 'data-p')).join('') : '<p class="empty" style="padding:22px">کاربری نیست</p>');
  } else if (topTab === 'guide') {
    h = guideHtml();
  } else {
    const waits = Object.keys(rooms).filter(id => roomType(id) === 'dm' && dmState(id) === 'wait');
    h += reqIds.length ? '<div class="sec">درخواست‌های دریافتی</div>' + reqIds.map(reqRow).join('') : '<p class="empty" style="padding:22px">درخواستی نداری 🎉</p>';
    if (waits.length) h += '<div class="sec">درخواست‌های ارسالی (در انتظار پذیرش)</div>' + waits.map(chatRow).join('');
  }
  if (h !== lastListHtml) { lastListHtml = h; $('list').innerHTML = h; }
}
function setTopTab(t) {
  topTab = t; $('sideScroll').scrollTop = 0; lastListHtml = '';
  if (t === 'search') setTimeout(() => $('userSearch').focus(), 60);
  renderList();
}
/* سازگاری با کدهای قدیمی */
function setSideTab(tb) { if (tb === 'groups') { subTab = 'rooms'; setTopTab('chats'); } else if (tb === 'discover') setTopTab('search'); else setTopTab('chats'); }
$('topTabs').onclick = e => { const b = e.target.closest('[data-tt]'); if (b) setTopTab(b.dataset.tt); };
$('subTabs').onclick = e => { const b = e.target.closest('[data-st]'); if (b) { subTab = b.dataset.st; lastListHtml = ''; renderList(); } };
$('list').addEventListener('click', e => { const g = e.target.closest('[data-go]'); if (g) return setTopTab(g.dataset.go); const c = e.target.closest('[data-clan]'); if (c) clanCard(c.dataset.clan); });
$('nav').onclick = e => {
  const b = e.target.closest('[data-n]'); if (!b) return;
  const n = b.dataset.n;
  if (n === 'board') return boardModal();
  if (n === 'shop') return $('btnShop').click();
  if (n === 'settings') return $('btnSettings').click();
  setTopTab('chats');
};
$('btnFilter').onclick = () => { onlyUnread = !onlyUnread; toast(onlyUnread ? 'فقط خوانده‌نشده‌ها' : 'همه‌ی گفتگوها'); lastListHtml = ''; renderList(); };
$('btnBell').onclick = () => setTopTab('reqs');
$('chipCoin').onclick = () => $('btnShop').click();
$('meAv').onclick = () => showProfile(me.uid);
/* لیدربورد */
function boardModal(tab = 'pts') {
  const key = { pts: u => pointsOf(u), quiz: u => u.quizPts || 0, msg: u => u.msgCount || 0 }[tab], unit = { pts: 'امتیاز', quiz: 'امتیاز کوییز', msg: 'پیام' }[tab];
  const top = Object.values(users).filter(u => !u.banned).map(u => ({ u, v: key(u) })).filter(x => x.v > 0).sort((a, b) => b.v - a.v).slice(0, 20), md = ['🥇', '🥈', '🥉'];
  openModal(`<h3>🏆 لیدربورد</h3><div class="lb-tabs"><button data-lb="pts" class="${tab === 'pts' ? 'on' : ''}">⭐ امتیاز</button><button data-lb="quiz" class="${tab === 'quiz' ? 'on' : ''}">🧠 کوییز</button><button data-lb="msg" class="${tab === 'msg' ? 'on' : ''}">💬 پیام</button></div>
    <div class="lb-list">${top.map((x, i) => `<button class="lb-row ${x.u.uid === me.uid ? 'me' : ''}" data-p="${x.u.uid}"><span class="md">${md[i] || fa(i + 1)}</span><div class="av sm">${avatarHtml(x.u)}</div><b>${esc(x.u.name)}${roleBadges(x.u)}</b><i>${fa(x.v)} <small>${unit}</small></i></button>`).join('') || '<p class="empty" style="padding:24px">هنوز کسی امتیازی ندارد</p>'}</div>
    <div class="acts2"><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('modalCard').querySelectorAll('[data-lb]').forEach(b => b.onclick = () => boardModal(b.dataset.lb));
  $('modalCard').querySelectorAll('[data-p]').forEach(b => b.onclick = () => showProfile(b.dataset.p));
}


/* خوش‌آمدگویی: عکس پروفایل از گالری */
let welcomed = false;
function maybeWelcome() {
  if (welcomed || !me || me.photo || localStorage.getItem('skipPhoto_' + me.uid)) return; welcomed = true;
  openModal(`<div style="font-size:3rem">📸</div><h3>خوش آمدی ${esc(me.name)}!</h3>
    <p style="color:var(--mut);margin:6px 0 14px">یه عکس پروفایل از گالری انتخاب کن تا بقیه تو رو بشناسن.</p>
    <div class="av lg" style="margin:0 auto 14px">${avatarHtml(me)}</div>
    <label class="btn" for="fileAvatar" style="display:block;cursor:pointer;text-align:center">📷 انتخاب عکس از گالری</label>
    <div class="acts2"><button class="btn ghost" id="wLater">بعدا</button></div>`);
  $('fileAvatar').onchange = async e => {
    const f = e.target.files[0]; e.target.value = ''; if (!f) return;
    try { const p = await shrinkImage(f, 256, .8); await updateDoc(doc(db, 'users', me.uid), isStaff() ? { photo: p } : { photoPending: p, photoRejected: 0 }); closeModal(); toast(isStaff() ? 'عکس پروفایل ذخیره شد ✨' : 'عکس برای تایید ناظر ارسال شد ⏳'); }
    catch { toast('عکس خوانده نشد. یک عکس JPG یا PNG انتخاب کنید.'); }
  };
  $('wLater').onclick = () => { localStorage.setItem('skipPhoto_' + me.uid, '1'); closeModal(); };
}

$('list').onclick = e => {
  const dl = e.target.closest('[data-del]'); if (dl) { e.stopPropagation(); deleteChat(dl.dataset.del); return; }
  const pf = e.target.closest('[data-p]'); if (pf) { showProfile(pf.dataset.p); return; }
  if (e.target.closest('[data-newg]')) { $('btnNewGroup').click(); return; }
  const ac = e.target.closest('[data-acc]'); if (ac) { respond(ac.dataset.acc, true); return; }
  const dc = e.target.closest('[data-dec]'); if (dc) { respond(dc.dataset.dec, false); return; }
  const r = e.target.closest('.row'); if (!r) return;
  openRoom(r.dataset.room || dmId(me.uid, r.dataset.uid));
};

/* ---------- باز کردن گفتگو ---------- */
function openRoom(id) {
  drafts[room] = $('inMsg').value;
  room = id; msgs = []; lastMsgsHtml = ''; npStop(); cancelCtx(); filter = ''; $('msgSearch').value = '';
  $('inMsg').value = drafts[id] || ''; $('emojiPanel').classList.add('hidden');
  pushChatState(); $('app').classList.add('chat'); applyWall(); attachToggle(false);
  unsubMsgs?.();
  unsubMsgs = onSnapshot(query(collection(db, 'rooms', id, 'msgs'), orderBy('createdAt'), limitToLast(300)), s => {
    const atBottom = $('msgs').scrollHeight - $('msgs').scrollTop - $('msgs').clientHeight < 120;
    msgs = s.docs.map(d => ({ id: d.id, ...d.data() }));
    renderMsgs(atBottom);
  }, e => toast('دسترسی به این گفتگو ممکن نیست'));
  renderHeader(); renderList(); renderPin(); renderMsgs(true); markRead();
}
$('back').onclick = () => { if (history.state?.chat) history.back(); else $('app').classList.remove('chat'); };

function renderHeader() {
  if (!me) return;
  const i = info(room), ty = typers(room);
  $('hAv').innerHTML = i.av; $('hAv').style.setProperty('--ring', i.ring || 'var(--gold)');
  $('hTitle').innerHTML = esc(i.title) + (i.badges || '');
  $('hSub').textContent = ty || i.sub; $('hSub').className = ty ? 'typing' : (i.online ? 'on' : '');
  $('btnDelChat').classList.toggle('hidden', !(roomType(room) === 'dm' && dmState(room) === 'ok'));
  renderGate();
}
$('hInfo').onclick = () => {
  const i = info(room);
  if (i.user) showProfile(i.user.uid); else if (i.group) showGroup();
};

/* ---------- سنجاق ---------- */
const canPin = () => (room !== 'public' && room !== 'channel') || isAdmin();
function renderPin() {
  const p = rooms[room]?.pinned;
  $('pinbar').classList.toggle('hidden', !p);
  if (p) $('pinTxt').textContent = p.text;
  $('unpin').classList.toggle('hidden', !canPin());
}
$('pinbar').onclick = e => { if (e.target.closest('#unpin')) return; const p = rooms[room]?.pinned; if (p) jumpTo(p.id); };
$('unpin').onclick = () => setDoc(doc(db, 'rooms', room), { pinned: deleteField() }, { merge: true });

/* ---------- نمایش پیام‌ها ---------- */
const BIG = /^[\p{Extended_Pictographic}\u200d\ufe0f\s]{1,12}$/u;
function dayLabel(ms) {
  const d = new Date(ms), t = new Date(), y = new Date(Date.now() - 864e5);
  if (d.toDateString() === t.toDateString()) return 'امروز';
  if (d.toDateString() === y.toDateString()) return 'دیروز';
  return fa(d.toLocaleDateString('fa-IR', { month: 'long', day: 'numeric' }));
}
function renderMsgs(scroll) {
  if (!me) return;
  const f = filter.trim().toLowerCase(), keep = $('msgs').scrollTop;
  const list = msgs.filter(m => !f || (m.text || '').toLowerCase().includes(f) || (m.name || '').toLowerCase().includes(f));
  if (!list.length) { lastMsgsHtml = ''; $('msgs').innerHTML = `<div class="empty">${f ? 'پیامی با این عبارت پیدا نشد' : 'هنوز پیامی نیست.<br>اولین پیام را بفرستید 👋'}</div>`; return; }
  const type = roomType(room), peerRead = type === 'dm' ? (rooms[room]?.read?.[dmPeerId(room)] || 0) : 0;
  let lastDay = '', h = '';
  for (const m of list) {
    const ms = m.createdAt?.toMillis?.() || Date.now();
    const dl = dayLabel(ms); if (dl !== lastDay) { h += `<div class="day">${dl}</div>`; lastDay = dl; }
    const mine = m.uid === me.uid && !m.bot && !m.official, u = m.bot ? BOT_U : m.official ? CH_U : (users[m.uid] || m), can = (m.uid === me.uid && !m.bot) || isAdmin();
    const big = !m.deleted && m.text && !m.img && !m.audio && !m.replyTo && !m.fwd && BIG.test(m.text);
    const rx = m.deleted ? '' : Object.entries(m.reactions || {}).filter(([, a]) => a?.length).map(([e, a]) =>
      `<button class="chip ${a.includes(me.uid) ? 'me' : ''}" data-r="${e}">${e} ${fa(a.length)}</button>`).join('');
    let body;
    if (m.deleted) body = `<div class="txt deleted">این پیام حذف شد</div>`;
    else body = (m.fwd ? `<div class="fwd">↪ فوروارد از ${esc(m.fwd.name)}</div>` : '')
      + (m.replyTo ? `<div class="quote" data-jump="${m.replyTo.id}"><b>${esc(m.replyTo.name)}</b>${esc(m.replyTo.text)}</div>` : '')
      + (m.text ? `<div class="txt">${linkify(m.text)}</div>` : '')
      + (m.img ? `<img class="pic" src="${m.img}" alt="تصویر ارسالی">` : '')
      + (m.audio ? apHtml(m) : '') + (m.game ? gameCardHtml(m) : '');
    const tick = !mine || m.deleted ? '' : !m.createdAt ? '<span class="tick">🕓</span>'
      : type === 'dm' ? `<span class="tick ${peerRead >= ms ? 'seen' : ''}">${peerRead >= ms ? '✓✓' : '✓'}</span>` : '<span class="tick">✓</span>';
    const acts = m.deleted ? '' : `<div class="acts">
      <button data-a="react" title="واکنش">😊</button><button data-a="reply" title="پاسخ">↩</button><button data-a="fwd" title="فوروارد">↪</button>
      ${m.text ? '<button data-a="copy" title="کپی">⧉</button>' : ''}${canPin() ? '<button data-a="pin" title="سنجاق">📌</button>' : ''}
      ${mine && m.text ? '<button data-a="edit" title="ویرایش">✎</button>' : ''}${can ? '<button data-a="del" title="حذف">🗑</button>' : ''}${!mine && !m.bot && !m.official ? '<button data-a="report" title="گزارش">🚩</button>' : ''}</div>`;
    const showName = !mine && (type === 'public' || type === 'group' || type === 'channel');
    h += `<div class="msg ${mine ? 'mine' : ''} ${big ? 'big' : ''}" id="m_${m.id}" data-id="${m.id}">
      ${mine || type === 'dm' || type === 'saved' ? '' : `<div class="av sm ${frameCls(u)}" data-prof="${m.bot || m.official ? '' : m.uid}" style="cursor:pointer">${avatarHtml(u)}</div>`}
      <div class="bub ${m.release ? 'rel' : ''}">${acts}
        ${showName ? `<div class="who" data-prof="${m.bot || m.official ? '' : m.uid}">${esc(u.name || m.name)}${m.bot ? '<span class="vipb" style="background:#4da3ff;color:#fff">BOT</span>' : u.vip ? '<span class="vipb">VIP</span>' : ''}<small>@${esc(u.handle || m.handle)}</small></div>` : ''}
        ${body}${rx ? `<div class="rx">${rx}</div>` : ''}
        <div class="meta">${m.edited && !m.deleted ? '<span>ویرایش‌شده</span>' : ''}<span>${hhmm(ms)}</span>${tick}</div>
      </div>${m.deleted ? '' : '<button class="rq" data-a="reply" aria-label="پاسخ">↩</button>'}</div>`;
  }
  if (h === lastMsgsHtml) { if (scroll) $('msgs').scrollTop = $('msgs').scrollHeight; return; }   // تغییری نبود: دوباره‌سازی نکن
  lastMsgsHtml = h; $('msgs').innerHTML = h; apSync();
  if (scroll) $('msgs').scrollTop = $('msgs').scrollHeight; else $('msgs').scrollTop = keep;
}
function jumpTo(id) {
  const el = $('m_' + id); if (!el) return toast('پیام در ۳۰۰ پیام اخیر نیست');
  el.scrollIntoView({ block: 'center' }); el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 1300);
}
function previewOf(m) { return m.text || (m.img ? '🖼 تصویر' : m.audio ? (m.music ? '🎵 موزیک' : '🎤 پیام صوتی') : m.game ? '🎮 دعوت به بازی' : ''); }

$('msgs').onclick = e => {
  const t = e.target;
  const apb = t.closest('[data-ap]'); if (apb) return apToggle(apb.closest('.msg').dataset.id);
  const aw = t.closest('[data-aw]'); if (aw) { const r = aw.getBoundingClientRect(); return apSeek(aw.closest('.msg').dataset.id, (e.clientX - r.left) / r.width); }
  const gj = t.closest('[data-gj]'); if (gj) return qzJoinCode(gj.dataset.gj);
  const chip = t.closest('[data-r]');
  if (chip) return toggleReact(t.closest('.msg').dataset.id, chip.dataset.r);
  if (t.closest('[data-jump]')) return jumpTo(t.closest('[data-jump]').dataset.jump);
  if (t.classList.contains('pic')) { $('lightbox').querySelector('img').src = t.src; return $('lightbox').classList.remove('hidden'); }
  if (t.closest('a')) return;
  const pr = t.closest('[data-prof]'); if (pr) return showProfile(pr.dataset.prof);
  const a = t.closest('[data-a]'), box = t.closest('.msg');
  if (!box) return;
  if (!a) { document.querySelectorAll('.msg.sel').forEach(x => x !== box && x.classList.remove('sel')); box.classList.toggle('sel'); return; }
  const m = msgs.find(x => x.id === box.dataset.id); if (!m) return;
  const ref = doc(db, 'rooms', room, 'msgs', m.id), act = a.dataset.a;
  box.classList.remove('sel');
  if (act === 'copy') { navigator.clipboard?.writeText(m.text).then(() => toast('کپی شد')); return; }
  if (act === 'react') {
    openModal(`<h3>واکنش</h3><div class="rpick">${['❤️','😂','👍','🔥','😮','😢','👏','🙏'].map(x => `<button data-e="${x}">${x}</button>`).join('')}</div>`);
    $('modalCard').querySelectorAll('[data-e]').forEach(b => b.onclick = () => { closeModal(); toggleReact(m.id, b.dataset.e); }); return;
  }
  if (act === 'fwd') return forwardModal(m);
  if (act === 'report') return reportModal(m);
  if (act === 'reply') { replyTo = { id: m.id, name: m.bot ? 'ربات پرو چت' : (users[m.uid] || m).name, text: previewOf(m) }; editing = null; showCtx('پاسخ به ' + replyTo.name + ': ' + replyTo.text); $('inMsg').focus(); }
  if (act === 'edit') { editing = m; replyTo = null; $('inMsg').value = m.text; showCtx('ویرایش پیام'); $('inMsg').focus(); }
  if (act === 'del' && confirm('این پیام حذف شود؟')) updateDoc(ref, { deleted: true, text: '', img: '', audio: '' });
  if (act === 'pin') setDoc(doc(db, 'rooms', room), { pinned: { id: m.id, text: previewOf(m) } }, { merge: true }).then(() => toast('پیام سنجاق شد'));
};
$('lightbox').onclick = () => $('lightbox').classList.add('hidden');
function toggleReact(id, emoji) {
  const m = msgs.find(x => x.id === id); if (!m) return;
  const has = (m.reactions?.[emoji] || []).includes(me.uid);
  updateDoc(doc(db, 'rooms', room, 'msgs', id), new FieldPath('reactions', emoji), has ? arrayRemove(me.uid) : arrayUnion(me.uid)).catch(() => toast('ثبت نشد'));
}

/* جستجوی پیام */
$('btnSearch').onclick = () => {
  $('msgSearchWrap').classList.toggle('hidden');
  if (!$('msgSearchWrap').classList.contains('hidden')) $('msgSearch').focus(); else { filter = ''; $('msgSearch').value = ''; renderMsgs(); }
};
$('msgSearch').oninput = e => { filter = e.target.value; renderMsgs(); };

/* ---------- ارسال ---------- */
function showCtx(t) { $('ctxTxt').textContent = t; $('ctx').classList.remove('hidden'); }
function cancelCtx() { replyTo = null; if (editing) $('inMsg').value = ''; editing = null; $('ctx').classList.add('hidden'); }
$('ctxX').onclick = cancelCtx;

async function post(roomId, data) {
  const base = { uid: me.uid, name: me.name, handle: me.handle, createdAt: serverTimestamp(), ...data, ...(roomId === 'channel' ? { official: true } : {}) };
  await addDoc(collection(db, 'rooms', roomId, 'msgs'), base);
  const t = Date.now();
  const meta = { last: { text: previewOf(data).slice(0, 60), name: data.bot ? 'ربات' : roomId === 'channel' ? 'پرو چت' : me.name, uid: me.uid, t }, read: { [me.uid]: t } };
  const mem = membersOf(roomId); if (mem) meta.members = mem;
  if (roomType(roomId) !== 'saved') {
    const rc = (roomType(roomId) === 'public' || roomType(roomId) === 'channel') ? Object.keys(users) : (mem || rooms[roomId]?.members || []);
    const un = { [me.uid]: 0 }; rc.forEach(x => { if (x !== me.uid) un[x] = increment(1); });
    meta.unread = un;
  }
  await setDoc(doc(db, 'rooms', roomId), meta, { merge: true });
  if (!data.bot) updateDoc(doc(db, 'users', me.uid), { msgCount: increment(1) }).catch(() => {});
}
async function sendMsg(extra = {}) {
  const text = extra.text ?? $('inMsg').value.trim();
  if (!text && !extra.img && !extra.audio && !extra.game) return;
  if (isMuted(me)) return toast('🔇 شما ساکت شده‌اید');
  if (text && !isAdmin() && !extra.bot && badCheck(text)) return toast('🤖 پیام شما حاوی کلمات نامناسب است و ارسال نشد');
  if (editing) {
    await updateDoc(doc(db, 'rooms', room, 'msgs', editing.id), { text, edited: true });
    cancelCtx(); $('inMsg').value = ''; return;
  }
  const data = { ...extra, text: text || '' };
  if (replyTo) data.replyTo = replyTo;
  $('inMsg').value = ''; $('inMsg').style.height = 'auto'; delete drafts[room]; cancelCtx();
  try { await post(room, data); } catch (e) { toast('ارسال نشد: ' + (e.code || e.message)); return; }
  $('msgs').scrollTop = $('msgs').scrollHeight;
  if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission();
}
$('btnSend').onclick = () => sendMsg();
$('inMsg').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey && !('ontouchstart' in window)) { e.preventDefault(); sendMsg(); } });
$('inMsg').addEventListener('input', e => {
  e.target.style.height = 'auto'; e.target.style.height = Math.min(120, e.target.scrollHeight) + 'px';
  if (roomType(room) === 'saved' || (roomType(room) === 'dm' && dmState(room) !== 'ok') || Date.now() - typingSent < 2500) return; typingSent = Date.now();
  setDoc(doc(db, 'rooms', room), { typing: { [me.uid]: Date.now() } }, { merge: true }).catch(() => {});
});

/* فوروارد */
function forwardModal(m) {
  const ids = ['public', savedId(), ...Object.keys(rooms).filter(id => id !== 'public' && id !== 'channel' && roomType(id) !== 'saved')];
  openModal(`<h3>فوروارد به…</h3><div class="pick">${ids.map(id => `<label data-f="${id}"><div class="av sm">${info(id).av}</div><b>${esc(info(id).title)}</b></label>`).join('')}</div>
    <div class="acts2"><button class="btn ghost" id="mClose">انصراف</button></div>`);
  $('mClose').onclick = closeModal;
  $('modalCard').querySelectorAll('[data-f]').forEach(l => l.onclick = async () => {
    closeModal();
    const d = { text: m.text || '', fwd: { name: (users[m.uid] || m).name } };
    if (m.img) d.img = m.img; if (m.audio) d.audio = m.audio;
    try { await post(l.dataset.f, d); toast('فوروارد شد'); } catch { toast('ارسال نشد'); }
  });
}

/* عکس */
$('btnImg').onclick = () => $('fileImg').click();
$('fileImg').onchange = async e => {
  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
  try { sendMsg({ img: await shrinkImage(f, 900), text: $('inMsg').value.trim() }); } catch { toast('تصویر خوانده نشد'); }
};

/* پیام صوتی: نوار موج زنده + لغو + ارسال (کد جدید پایین فایل) */
/* ایموجی، صدا، اسکرول */
const EMOJIS = Array.from('😀😂🤣😍😘😎🤩🥳😭😡😱🤔🙄😅😉😴👍👎👏🙏💪🤝🔥❤️💔✨🎉🌹☕⚽🎵🏆💯🤲😇🥰😋🤗🫡💀👀🙈');
$('emojiPanel').innerHTML = EMOJIS.map(e => `<button type="button">${e}</button>`).join('');
$('btnEmoji').onclick = () => $('emojiPanel').classList.toggle('hidden');
$('emojiPanel').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  const i = $('inMsg'), p = i.selectionStart ?? i.value.length;
  i.value = i.value.slice(0, p) + b.textContent + i.value.slice(i.selectionEnd ?? p); i.focus();
  i.selectionStart = i.selectionEnd = p + b.textContent.length;
};
function beep() {
  if (!soundOn) return;
  try {
    const c = new (window.AudioContext || window.webkitAudioContext)(), o = c.createOscillator(), g = c.createGain();
    o.frequency.value = 880; g.gain.value = .05; o.connect(g); g.connect(c.destination); o.start(); o.stop(c.currentTime + .12);
    setTimeout(() => c.close(), 400);
  } catch {}
}
$('msgs').addEventListener('scroll', () => $('toBottom').classList.toggle('hidden', $('msgs').scrollHeight - $('msgs').scrollTop - $('msgs').clientHeight < 300));
$('toBottom').onclick = () => { $('msgs').scrollTop = $('msgs').scrollHeight; };

/* ---------- مودال‌ها ---------- */
function openModal(html, cls = '') { $('modalCard').className = 'card ' + cls; $('modalCard').innerHTML = html; $('modal').classList.remove('hidden'); }
function closeModal() { $('modal').classList.add('hidden'); stopMusic(); }
$('modal').onclick = e => { if (e.target === $('modal')) closeModal(); };

/* پروفایل */
function profileTop(u, edit) {
  const b = BANNERS[u.banner] || BANNERS[autoBanner(u.uid)];
  const pts = pointsOf(u), lv = levelOf(pts);
  const charms = (u.charms || []).slice(0, 3).map((c, i) => `<span class="charm c${i}" data-charm="${esc(c)}">${esc(c)}</span>`).join('');
  return `<div class="pf-top" style="background:linear-gradient(160deg,${b[0]},${b[1]})">
    <div class="pf-pat">${esc(u.pattern || '✨').repeat(90)}</div>${fxHtml(u.fx)}${charms}
    <div class="pf-row">
      <div class="stat"><b>${fa(pts)}</b><small>⭐ امتیاز</small></div>
      <div class="frame ${frameCls(u)}">${edit ? `<label for="fileAvatar" class="av-edit"><div class="av lg" id="pfAv">${avatarHtml(u)}</div><span class="camb">📷</span></label>` : `<div class="av lg" id="pfAv">${avatarHtml(u)}</div>`}</div>
      <div class="stat"><b>${fa(lv)}</b><small>🏅 سطح</small></div>
    </div>
    <div class="pf-name">${esc(u.name || '')} ${esc(u.badge || '')}${u.vip ? '<span class="vipb">VIP</span>' : ''}${u.mod ? '<span class="vipb" style="background:#38d26b;color:#04210f">ناظر</span>' : ''}</div>
    <div class="pf-id">${hid(u)}</div>
    <div class="pf-title">${esc(titleOf(u))}</div>
  </div>`;
}
/* دوستان = کسانی که چت خصوصی‌شان با هم پذیرفته شده */
function friendsOf(uid) {
  if (!me || uid !== me.uid) return null;
  return Object.entries(rooms).filter(([id, r]) => id.startsWith('dm_') && (r.status || 'accepted') === 'accepted')
    .map(([id]) => users[dmPeerId(id)]).filter(Boolean).sort((a, b) => (a.name || '').localeCompare(b.name || '', 'fa'));
}
function friendsHtml(uid) {
  const f = friendsOf(uid);
  if (f === null) {
    const st = dmState(dmId(me.uid, uid));
    return `<div class="pf-empty">${st === 'ok' ? '🤝 شما با این کاربر دوست هستید.' : 'با این کاربر هنوز دوست نیستی.<br>با «درخواست چت خصوصی» می‌توانی دوست شوی.'}<br><small>لیست دوستان فقط برای صاحب پروفایل نمایش داده می‌شود.</small></div>`;
  }
  if (!f.length) return '<div class="pf-empty">هنوز دوستی نداری 😅<br>به کسی درخواست چت خصوصی بده؛ بعد از پذیرش، اینجا دوست شما می‌شود.</div>';
  return `<div class="sec-t">🤝 دوستان (${fa(f.length)}) • ظرفیت: ${fa(friendUsed())} از ${capText(me)} (افزایش در تنظیمات)</div>` + f.map(u => `<button class="fr-row" data-fr="${u.uid}"><div class="av ${frameCls(u)}">${avatarHtml(u)}</div><div class="nm"><b>${esc(u.name || '')} ${esc(u.badge || '')}</b><small>${isOnline(u) ? '🟢 آنلاین' : lastSeenText(u)}</small></div></button>`).join('');
}
const GAMES = [
  { k: 'dice', e: '🎲', n: 'تاس شانس', d: 'یک تاس ۱ تا ۶ بنداز', how: 'در چت عمومی بنویس /dice یا /تاس تا ربات برایت تاس بیندازد.', run: 'همین‌جا بنداز' },
  { k: 'coin', e: '🪙', n: 'شیر یا خط', d: 'تصمیم‌گیری با سکه', how: 'در چت عمومی بنویس /coin یا /شیرخط تا ربات سکه بیندازد.', run: 'سکه بنداز' },
  { k: 'joke', e: '😂', n: 'جوک', d: 'ربات برایت جوک می‌گوید', how: 'در چت عمومی بنویس /joke یا /جوک.', run: 'یک جوک بگو' },
  { k: 'top', e: '🏆', n: 'برترین‌های چت', d: 'فعال‌ترین کاربران', how: 'رتبه‌بندی بر اساس تعداد پیام‌هاست. در چت بنویس /top یا /برترین.', run: 'نمایش برترین‌ها' },
  { k: 'cards', e: '🎴', n: 'کارت‌های کلکسیون', d: 'جمع کردن کارت‌های کمیاب', how: 'با سکه از فروشگاه کارت بخر. کارت‌ها از معمولی تا افسانه‌ای هستند و در پروفایلت نمایش داده می‌شوند.', run: 'باز کردن فروشگاه' },
  { k: 'daily', e: '🎁', n: 'جایزه‌ی روزانه', d: '۵۰ سکه‌ی رایگان', how: 'هر ۲۰ ساعت یک بار می‌توانی ۵۰ سکه‌ی رایگان بگیری و برای خرید کارت خرج کنی.', run: 'گرفتن جایزه' }
];
const QZ_INFO = {
  football: 'از روی یک توضیح کوتاه، اسم فوتبالیست را از بین ۴ گزینه پیدا کن.',
  cinema: 'از روی یک توضیح کوتاه، اسم بازیگر سینما را از بین ۴ گزینه پیدا کن.',
  countries: 'پرچم یا پایتخت را ببین و اسم کشور را از بین ۴ گزینه پیدا کن.'
};
const agoText = t => { const m = Math.floor(Math.max(0, Date.now() - t) / 60000); if (m < 1) return 'چند لحظه پیش'; if (m < 60) return fa(m) + ' دقیقه پیش'; const h = Math.floor(m / 60); return h < 24 ? fa(h) + ' ساعت پیش' : fa(Math.floor(h / 24)) + ' روز پیش'; };
const qzStat = (u, cat) => (u && u.qz && u.qz[cat]) || {};
const qzLastText = l => !l ? 'هنوز بازی نکرده' : `${l.win ? '🏆 برنده شد' : 'رتبه‌ی ' + fa(l.rank) + ' از ' + fa(l.players)} • ${fa(l.score)} امتیاز • ${QZ_MODES[l.mode]?.n || ''} • ${agoText(l.at)}`;
function gamesHtml(u) {
  const qrow = ([k, c]) => { const st = qzStat(u, k);
    return `<button class="fr-row" data-game="${k}"><span style="font-size:1.7rem">${c.ic}</span><div class="nm"><b>${c.n}</b><small>${st.games ? fa(st.games) + ' بازی • ' + fa(st.wins || 0) + ' برد<br>آخرین: ' + qzLastText(st.last) : 'هنوز بازی نکرده'}</small></div><span style="color:var(--mut)">‹</span></button>`; };
  return `<div class="pf-cards"><div class="pc"><div class="pci">🏆</div><b>${fa(u.quizPts || 0)}</b><small>امتیاز کوییز</small></div><div class="pc"><div class="pci">🪙</div><b>${fa(coinsOf(u))}</b><small>سکه</small></div></div>
    <div class="sec-t">🧠 بازی‌های کوییز (برای دیدن آخرین بازی و جدول، روی هر کدام بزن)</div>` +
    Object.entries(QZ_CATS).map(qrow).join('') +
    `<div class="sec-t" style="margin-top:12px">🎲 سرگرمی‌ها</div>` +
    GAMES.map(g => `<button class="fr-row" data-game="${g.k}"><span style="font-size:1.7rem">${g.e}</span><div class="nm"><b>${g.n}</b><small>${g.d}</small></div><span style="color:var(--mut)">‹</span></button>`).join('');
}
function showQuizGame(cat, uid) {
  const c = QZ_CATS[cat], u = users[uid] || me, st = qzStat(u, cat), self = uid === me.uid;
  const top = Object.values(users).filter(x => (x.qz?.[cat]?.pts || 0) > 0).sort((a, b) => b.qz[cat].pts - a.qz[cat].pts)[0];
  openModal(`<div style="text-align:center;font-size:3rem">${c.ic}</div><h3 style="text-align:center">کوییز ${c.n}</h3>
    <p style="color:var(--mut);line-height:2;font-size:.88rem">${QZ_INFO[cat]}<br>🎨 کلاسیک: تا ۴ نفر، ۱۰ سوال • ⚔️ حذفی: تا ۶ نفر، اشتباه یعنی حذف. هر سوال ۲۰ ثانیه است و جواب سریع‌تر امتیاز بیشتری دارد (تا ۱۰).</p>
    <div class="sec-t">${self ? 'آمار تو' : 'آمار ' + esc(u.name || '')}</div>
    <div class="st3"><div><b>${fa(st.pts || 0)}</b><small>امتیاز</small></div><div><b>${fa(st.wins || 0)}</b><small>برد</small></div><div><b>${fa(st.games || 0)}</b><small>بازی</small></div></div>
    <div class="sec-t">🕘 آخرین بازی</div><div class="pf-bio" style="text-align:start">${qzLastText(st.last)}</div>
    ${top ? `<div class="sec-t" style="margin-top:10px">👑 نفر اول این بازی</div><div class="pf-bio" style="text-align:start">${esc(top.name || '')} ${hid(top)} — ${fa(top.qz[cat].pts)} امتیاز</div>` : ''}
    <div class="acts2" style="flex-wrap:wrap"><button class="btn" id="gPlay">🎮 بازی کن</button><button class="btn ghost" id="gBoard">🏆 جدول برترین‌ها</button><button class="btn ghost" id="gBack">بازگشت</button></div>`);
  $('gPlay').onclick = () => { closeModal(); qzPlay(cat); };
  $('gBoard').onclick = () => { closeModal(); qzOpenBoard(cat); };
  $('gBack').onclick = () => showProfile(uid, 'games');
}
function showGame(k, uid) {
  if (QZ_CATS[k]) return showQuizGame(k, uid);
  const g = GAMES.find(x => x.k === k); if (!g) return;
  openModal(`<div style="text-align:center;font-size:3rem">${g.e}</div><h3 style="text-align:center">${g.n}</h3>
    <p style="color:var(--mut);line-height:2;font-size:.9rem">${g.how}</p>
    <div id="gOut" style="text-align:center;font-size:1.05rem;line-height:2;white-space:pre-line;margin:8px 0"></div>
    <div class="acts2"><button class="btn" id="gRun">${g.run}</button><button class="btn ghost" id="gBack">بازگشت</button></div>`);
  $('gBack').onclick = () => showProfile(uid, 'games');
  $('gRun').onclick = () => {
    const out = $('gOut');
    if (k === 'dice') out.textContent = '🎲 ' + fa(1 + Math.floor(Math.random() * 6));
    else if (k === 'coin') out.textContent = Math.random() < .5 ? '🪙 شیر' : '🪙 خط';
    else if (k === 'joke') out.textContent = JOKES[Math.floor(Math.random() * JOKES.length)];
    else if (k === 'top') out.textContent = Object.values(users).sort((a, b) => (b.msgCount || 0) - (a.msgCount || 0)).slice(0, 3).map((u, i) => `${['🥇', '🥈', '🥉'][i]} ${u.name} — ${fa(u.msgCount || 0)} پیام`).join('\n');
    else if (k === 'cards') { closeModal(); $('btnShop').click(); }
    else if (k === 'daily') { closeModal(); if (Date.now() - (me.lastDaily?.toMillis?.() || 0) > 20 * 36e5) $('dailyBtn').click(); else toast('جایزه‌ی امروز را گرفتی ✓ فردا دوباره بیا'); }
  };
}
function showProfile(uid, tab) {
  const u = users[uid]; if (!u) return;
  const self = uid === me.uid, pts = pointsOf(u), lv = levelOf(pts);
  const st = self ? 'ok' : dmState(dmId(me.uid, uid));
  const dmLabel = { ok: 'پیام خصوصی', wait: 'درخواست ارسال شده ⏳', incoming: 'پاسخ به درخواست چت', none: 'درخواست چت خصوصی', declined: 'درخواست چت خصوصی', declinedByMe: 'درخواست چت خصوصی' }[st];
  const joined = u.createdAt?.toDate ? fa(u.createdAt.toDate().toLocaleDateString('fa-IR')) : '—';
  openModal(`${profileTop(u)}<button class="pf-x" id="pX" aria-label="بستن">✕</button>${self ? '' : '<button class="pf-gift" id="pGift" aria-label="فرستادن هدیه">🎁</button>'}
    <div class="pf-body">
      <div class="pf-tabs" id="pfTabs"><button data-pt="info" class="on">👤 اطلاعات</button><button data-pt="friends">🤝 دوستان</button><button data-pt="games">🎮 بازی‌ها</button></div>
      <div class="pf-pane" data-pane="info">
      ${u.bio ? `<div class="pf-bio">${esc(u.bio)}</div>` : ''}
      <div class="pf-cards">
        <div class="pc"><div class="pci">💬</div><b>${fa(u.msgCount || 0)}</b><small>پیام</small></div>
        <div class="pc"><div class="pci">📅</div><b>${fa(joinedDays(u))}</b><small>روز عضویت</small></div>
      </div>
      ${musicHtml(u, self)}
      <div class="lvl-wrap"><div class="lvl"><i style="width:${pts % 100}%"></i></div><small>${fa(100 - pts % 100)} امتیاز تا سطح ${fa(lv + 1)}</small></div>
      <table class="pf-tbl">
        <tr><th>آیدی</th><td dir="ltr" style="text-align:right">${hid(u)}</td></tr>
        <tr><th>عنوان</th><td>${esc(titleOf(u))}</td></tr>
        <tr><th>وضعیت</th><td>${lastSeenText(u)}</td></tr>
        <tr><th>سکه</th><td>🪙 ${fa(coinsOf(u))}</td></tr>
        <tr><th>عضو از</th><td>${joined}</td></tr>
      </table>
      </div>
      <div class="pf-pane hidden" data-pane="friends">${friendsHtml(uid)}</div>
      <div class="pf-pane hidden" data-pane="games">${gamesHtml(u)}</div>
      <div class="acts2" style="margin-top:12px">
        ${self ? '<button class="btn" id="pEdit">ویرایش و شخصی‌سازی پروفایل</button><div class="hubrow"><button id="hSet">⚙ تنظیمات و تم</button><button id="hShop">🛍 فروشگاه و بازار</button><button id="hSaved">🔖 ذخیره‌شده‌ها</button><button id="hOut">⏻ خروج از حساب</button></div>' : `<button class="btn" id="pDm">${dmLabel}</button>`}
        ${!self && isAdmin() ? `<button class="btn ghost" id="pAdm">👑 مدیریت کاربر (VIP، سکه، هدیه)</button><button class="btn ghost" id="pBan">${u.banned ? 'رفع مسدودی' : 'مسدود کردن'}</button>` : ''}
      </div>
    </div>`, 'pf-card');
  $('pX').onclick = closeModal;
  $('pfTabs').onclick = e => {
    const b = e.target.closest('[data-pt]'); if (!b) return;
    $('pfTabs').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    $('modalCard').querySelectorAll('.pf-pane').forEach(p => p.classList.toggle('hidden', p.dataset.pane !== b.dataset.pt));
  };
  $('modalCard').querySelectorAll('[data-fr]').forEach(r => r.onclick = () => showProfile(r.dataset.fr));
  $('modalCard').querySelectorAll('[data-game]').forEach(b => b.onclick = () => showGame(b.dataset.game, uid));
  if (tab) $('pfTabs').querySelector(`[data-pt="${tab}"]`)?.click();
  wireProfileExtras(uid);
  if (self) {
    $('pEdit').onclick = editProfile;
    $('hSet').onclick = () => $('btnSettings').click();
    $('hShop').onclick = () => { closeModal(); $('btnShop').click(); };
    $('hSaved').onclick = () => { closeModal(); openRoom(savedId()); };
    $('hOut').onclick = () => { closeModal(); $('btnLogout').click(); };
  } else {
    $('pGift').onclick = () => giftModal(uid);
    $('pDm').onclick = () => { closeModal(); openRoom(dmId(me.uid, uid)); };
    $('pAdm')?.addEventListener('click', () => adminUser(uid));
    $('pBan')?.addEventListener('click', async () => { await updateDoc(doc(db, 'users', uid), { banned: !u.banned }); closeModal(); toast(u.banned ? 'رفع مسدودی شد' : 'کاربر مسدود شد'); });
  }
}
$('meAv').onclick = () => showProfile(me.uid);

function editProfile() {
  const d = { ...me, charms: [...(me.charms || [])] };
  openModal(`<div id="pvBox"></div><button class="pf-x" id="pX" aria-label="بستن">✕</button>
    <div class="pf-body pf-form">
      <label class="btn" for="fileAvatar" style="display:block;text-align:center;cursor:pointer;margin-bottom:12px">📷 انتخاب عکس از گالری</label>
      <div class="two">
        <div class="field"><label>نام نمایشی</label><input id="pvName" value="${esc(d.name)}" maxlength="24"></div>
        <div class="field"><label>نشان کنار نام (ایموجی)</label><input id="pvBadge" value="${esc(d.badge || '')}" maxlength="4" placeholder="👑"></div>
      </div>
      <div class="field"><label>عنوان شما (خالی = عنوان خودکار)</label><input id="pvTitle" value="${esc(d.title || '')}" maxlength="18" placeholder="مثلا: چوپان قدیم"></div>
      <div class="field"><label>درباره من (حداکثر ۸۰ حرف)</label><input id="pvBio" value="${esc(d.bio || '')}" maxlength="80"></div>
      <div class="lbl">رنگ پس‌زمینه</div>
      <div class="sw" id="swB">${Object.entries(BANNERS).map(([k, c]) => `<button data-b="${k}" aria-label="${k}" style="background:linear-gradient(135deg,${c[0]},${c[1]})"></button>`).join('')}</div>
      <div class="lbl">افکت پروفایل</div>
      <div class="sw fr" id="swX">${Object.entries(FX).map(([k, t]) => `<button data-x="${k}">${t}</button>`).join('')}</div>
      <div class="lbl">قاب عکس</div>
      <div class="sw fr" id="swF">${Object.entries(FRAMES).map(([k, t]) => `<button data-f="${k}">${t}</button>`).join('')}</div>
      <div class="two">
        <div class="field"><label>طرح پس‌زمینه (یک ایموجی)</label><input id="pvPat" value="${esc(d.pattern || '')}" maxlength="4" placeholder="🐾"></div>
        <div></div>
      </div>
      <div class="lbl">سه کارت شناور دور پروفایل (ایموجی)</div>
      <div class="charm-in"><input data-c="0" maxlength="4" value="${esc(d.charms[0] || '')}"><input data-c="1" maxlength="4" value="${esc(d.charms[1] || '')}"><input data-c="2" maxlength="4" value="${esc(d.charms[2] || '')}"></div>
      <div class="acts2"><button class="btn" id="pvSave">ذخیره</button><button class="btn ghost" id="pvCancel">انصراف</button></div>
    </div>`, 'pf-card');
  const paint = () => {
    $('pvBox').innerHTML = profileTop(d, true);
    $('swB').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.b === (d.banner || autoBanner(d.uid))));
    $('swF').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.f === (d.frame || 'none')));
    $('swX').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.x === (d.fx || 'none')));
  };
  paint();
  $('fileAvatar').onchange = async e => {
    const f = e.target.files[0]; e.target.value = ''; if (!f) return;
    try { d.photo = await shrinkImage(f, 256, .8); paint(); toast('عکس انتخاب شد. حالا «ذخیره» را بزنید.'); }
    catch { toast('عکس خوانده نشد. یک عکس JPG یا PNG انتخاب کنید.'); }
  };
  $('swB').onclick = e => { const b = e.target.closest('[data-b]'); if (b) { d.banner = b.dataset.b; paint(); } };
  $('swF').onclick = e => { const b = e.target.closest('[data-f]'); if (b) { d.frame = b.dataset.f; paint(); } };
  $('swX').onclick = e => { const b = e.target.closest('[data-x]'); if (b) { d.fx = b.dataset.x; paint(); } };
  const bind = (id, k) => $(id).addEventListener('input', e => { d[k] = e.target.value; $('pvBox').innerHTML = profileTop(d, true); });
  bind('pvName', 'name'); bind('pvBadge', 'badge'); bind('pvTitle', 'title'); bind('pvPat', 'pattern');
  $('modalCard').querySelectorAll('[data-c]').forEach(i => i.addEventListener('input', () => {
    d.charms = [...$('modalCard').querySelectorAll('[data-c]')].map(x => x.value.trim()).filter(Boolean); $('pvBox').innerHTML = profileTop(d, true);
  }));
  $('pX').onclick = $('pvCancel').onclick = closeModal;
  $('pvSave').onclick = async () => {
    const name = $('pvName').value.trim(); if (!name) return toast('نام را وارد کنید');
    if (!isStaff() && [name, $('pvBio').value, $('pvTitle').value, $('pvBadge').value, $('pvPat').value, ...(d.charms || [])].some(x => badCheck(x))) return toast('🤖 متن نامناسب در پروفایل تشخیص داده شد. لطفا اصلاحش کن.');
    try {
      await updateDoc(doc(db, 'users', me.uid), {
        name, ...photoPatch(d), bio: $('pvBio').value.trim().slice(0, 80), title: ($('pvTitle').value || '').trim().slice(0, 18),
        badge: ($('pvBadge').value || '').trim().slice(0, 4), pattern: ($('pvPat').value || '').trim().slice(0, 4),
        banner: d.banner || '', frame: d.frame || 'none', fx: d.fx || 'none', charms: (d.charms || []).slice(0, 3)
      });
      closeModal(); toast('پروفایل ذخیره شد');
    } catch { toast('ذخیره نشد'); }
  };
}

/* تنظیمات */
$('btnSettings').onclick = () => {
  const T = { gold: '#d4af37', ocean: '#4da3ff', emerald: '#2fd18b', rose: '#ff5f8f', light: '#f2e6b8' };
  openModal(`<h3>تنظیمات</h3><div class="themes">${Object.entries(T).map(([k, c]) => `<button data-t="${k}" style="background:${c}" class="${document.documentElement.dataset.theme === k ? 'on' : ''}" aria-label="تم ${k}"></button>`).join('')}</div>
    <div class="setrow"><span>صدای پیام جدید</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="sndBtn">${soundOn ? 'روشن' : 'خاموش'}</button></div>
    <div class="setrow"><span>اعلان مرورگر</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="ntfBtn">${'Notification' in window && Notification.permission === 'granted' ? 'فعال' : 'فعال‌سازی'}</button></div>
    <div class="setrow"><span>رمز عبور</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="pwBtn">تغییر</button></div>
    <div class="setrow"><span>نشست‌ها و آخرین بازدیدها</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="ssBtn">مشاهده</button></div>
    <div class="setrow"><span>ظرفیت دوستان<br><small style="color:var(--mut)">${fa(friendUsed())} از ${capText(me)} پر شده</small></span><button class="btn ghost" style="width:auto;padding:6px 14px" id="frBuy">+${fa(FRIEND_PACK)} دوست • 🪙 ${fa(FRIEND_PRICE)}</button></div>
    <div class="setrow"><span>زمینه‌ی چت (انتخاب و دانلود)</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="wlBtn">انتخاب</button></div>
    <div class="setrow"><span>پیشنهاد به مدیر</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="sgBtn">ارسال</button></div>
    <div class="acts2"><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('modalCard').querySelectorAll('[data-t]').forEach(b => b.onclick = () => { setTheme(b.dataset.t); $('modalCard').querySelectorAll('[data-t]').forEach(x => x.classList.toggle('on', x === b)); });
  $('sndBtn').onclick = e => { soundOn = !soundOn; localStorage.setItem('snd', soundOn ? '1' : '0'); e.target.textContent = soundOn ? 'روشن' : 'خاموش'; if (soundOn) beep(); };
  $('ntfBtn').onclick = async e => { if ('Notification' in window) { const p = await Notification.requestPermission(); e.target.textContent = p === 'granted' ? 'فعال' : 'مسدود'; } else toast('مرورگر پشتیبانی نمی‌کند'); };
  $('frBuy').onclick = () => buyFriendSlots(true); $('mClose').onclick = closeModal;
  $('pwBtn').onclick = openPassModal; $('ssBtn').onclick = openSessions; $('wlBtn').onclick = wallModal; $('sgBtn').onclick = suggestModal;
};

/* ---------- تغییر رمز عبور ---------- */
function openPassModal() {
  const mail = auth.currentUser?.email || '';
  openModal(`<h3>🔑 تغییر رمز عبور</h3>
    <div class="field"><label>رمز فعلی</label><input id="pCur" type="password" dir="ltr" autocomplete="current-password"></div>
    <div class="field"><label>رمز جدید (حداقل ۶ کاراکتر)</label><input id="pNew" type="password" dir="ltr" autocomplete="new-password"></div>
    <div class="field"><label>تکرار رمز جدید</label><input id="pNew2" type="password" dir="ltr" autocomplete="new-password"></div>
    <div class="err" id="pErr"></div>
    <div class="acts2"><button class="btn" id="pOk">تغییر رمز</button><button class="btn ghost" id="pNo">بستن</button></div>`);
  $('pNo').onclick = closeModal;
  $('pOk').onclick = async () => {
    const cur = $('pCur').value, nw = $('pNew').value; $('pErr').textContent = '';
    if (!cur) return $('pErr').textContent = 'رمز فعلی را بنویس.';
    if (nw.length < 6) return $('pErr').textContent = 'رمز جدید باید حداقل ۶ کاراکتر باشد.';
    if (nw !== $('pNew2').value) return $('pErr').textContent = 'تکرار رمز با رمز جدید یکی نیست.';
    if (nw === cur) return $('pErr').textContent = 'رمز جدید باید با رمز فعلی فرق کند.';
    $('pOk').disabled = true;
    try {
      await reauthenticateWithCredential(auth.currentUser, EmailAuthProvider.credential(mail, cur));
      await updatePassword(auth.currentUser, nw);
      toast('✓ رمز عبور تغییر کرد'); closeModal();
    } catch (e) { $('pErr').textContent = authMsg(e.code); }
    $('pOk').disabled = false;
  };
}

/* ---------- نشست‌ها و آخرین بازدیدها ---------- */
async function openSessions() {
  openModal('<h3>🕘 نشست‌ها و آخرین بازدیدها</h3><div id="ssList" class="pf-empty">در حال بارگذاری…</div><div class="acts2"><button class="btn ghost" id="ssX">بستن</button></div>');
  $('ssX').onclick = closeModal;
  let list = [];
  try {
    const sn = await getDocs(query(collection(db, 'users', me.uid, 'sessions'), orderBy('lastActive', 'desc')));
    sn.forEach(d => list.push({ id: d.id, ...d.data() }));
  } catch { return $('ssList').textContent = 'بارگذاری نشد.'; }
  list = list.slice(0, 12);
  const cur = localStorage.getItem('pc_sid');
  const others = list.filter(x => x.id !== cur && !x.revoked && !x.ended);
  $('ssList').className = '';
  $('ssList').innerHTML = (list.map(x => {
    const st = x.id === cur ? '' : x.revoked ? 'خارج‌شده از طرف تو' : x.ended ? 'خروج زده' : '';
    return `<div class="sess"><span class="si">${/Android|iOS/.test(x.device || '') ? '📱' : '💻'}</span>
      <div class="nm"><b>${esc(x.device || 'دستگاه')}${x.id === cur ? '<span class="tag">این دستگاه</span>' : ''}</b>
      <small>ورود: ${fmtT(x.createdAt)}<br>آخرین بازدید: ${fmtT(x.lastActive)}${st ? ' • ' + st : ''}</small></div>
      ${x.id !== cur && !x.revoked && !x.ended ? `<button class="mini" data-kick="${x.id}">خروج</button>` : ''}</div>`;
  }).join('') || '<div class="pf-empty">نشستی ثبت نشده.</div>') +
    (others.length ? '<button class="btn ghost" id="ssAll" style="margin-top:6px">خروج از همه‌ی دستگاه‌های دیگر</button>' : '');
  const kick = id => updateDoc(sessRef(id), { revoked: true }).catch(() => {});
  $('ssList').querySelectorAll('[data-kick]').forEach(b => b.onclick = async () => { await kick(b.dataset.kick); toast('خارج شد'); openSessions(); });
  $('ssAll')?.addEventListener('click', async () => { await Promise.all(others.map(x => kick(x.id))); toast('از همه‌ی دستگاه‌های دیگر خارج شدند'); openSessions(); });
}

