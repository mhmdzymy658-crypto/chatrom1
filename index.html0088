  { id: 67, e: '🍔', n: 'همبرگر داغ', r: 'common', p: 105 }, { id: 68, e: '🍟', n: 'سیب‌زمینی سرخ‌کرده', r: 'common', p: 95 }, { id: 69, e: '🧃', n: 'آبمیوه‌ی خنک', r: 'common', p: 85 }, { id: 70, e: '🎂', n: 'کیک تولد', r: 'common', p: 140 }, { id: 71, e: '🪀', n: 'یویوی رنگی', r: 'common', p: 100 }, { id: 72, e: '🧩', n: 'پازل هزارتکه', r: 'common', p: 125 }, { id: 73, e: '🎨', n: 'پالت نقاشی', r: 'common', p: 130 }, { id: 74, e: '📚', n: 'کتاب قصه', r: 'common', p: 115 }, { id: 75, e: '🦈', n: 'کوسه‌ی دریا', r: 'rare', p: 380 }, { id: 76, e: '🐙', n: 'هشت‌پای باهوش', r: 'rare', p: 350 }, { id: 77, e: '🦂', n: 'عقرب سیاه', r: 'rare', p: 360 }, { id: 78, e: '🕶️', n: 'عینک آفتابی', r: 'rare', p: 330 }, { id: 79, e: '🎯', n: 'دارت طلایی', r: 'rare', p: 340 }, { id: 80, e: '🧲', n: 'آهنربای شانس', r: 'rare', p: 370 }, { id: 81, e: '🔭', n: 'تلسکوپ ستاره‌شناس', r: 'rare', p: 430 }, { id: 82, e: '🪝', n: 'قلاب ماهیگیر', r: 'rare', p: 320 }, { id: 83, e: '🐅', n: 'ببر سیبری', r: 'epic', p: 920 }, { id: 84, e: '🦖', n: 'دایناسور', r: 'epic', p: 1000 }, { id: 85, e: '🏍️', n: 'موتور مسابقه', r: 'epic', p: 1050 }, { id: 86, e: '🎼', n: 'نت جادویی', r: 'epic', p: 880 }, { id: 87, e: '💍', n: 'انگشتر پادشاه', r: 'epic', p: 1100 }, { id: 88, e: '🪬', n: 'چشم محافظ', r: 'epic', p: 900 }, { id: 89, e: '🗡️', n: 'خنجر سایه', r: 'epic', p: 960 }, { id: 90, e: '⛩️', n: 'معبد ژاپنی', r: 'epic', p: 1020 }, { id: 91, e: '🌞', n: 'خورشید طلایی', r: 'legend', p: 3300 }, { id: 92, e: '🐋', n: 'نهنگ کیهانی', r: 'legend', p: 4100 }, { id: 93, e: '🏔️', n: 'قله‌ی افسانه‌ای', r: 'legend', p: 3000 }, { id: 94, e: '👁️', n: 'چشم هوروس', r: 'legend', p: 3900 }, { id: 95, e: '🪙', n: 'سکه‌ی نایاب', r: 'legend', p: 2700 }, { id: 96, e: '🎇', n: 'آتش‌بازی طلایی', r: 'legend', p: 3400 }, { id: 97, e: '🦢', n: 'قوی سلطنتی', r: 'legend', p: 3100 }, { id: 98, e: '🏛️', n: 'کاخ باستانی', r: 'legend', p: 4400 }
];
const coinsOf = u => 100 + (u?.msgCount || 0) * 2 + (u?.bonus || 0) + (u?.gin || 0) - (u?.spent || 0);   // gin = سکه‌های دریافتی از هدیه و بازار
const hasItem = id => (me.inventory || []).includes(id);
let shopTab = 'shop', shopRar = 'all';

function itemCard(it, mode) {
  const R = RAR[it.r], owned = hasItem(it.id), A = shopAttrs(it);
  const foot = owned ? '<div class="own-b">✓ مال توست</div>'
    : mode === 'big' ? '' : `<button class="price ${coinsOf(me) < it.p ? 'poor' : ''}" data-buy="${it.id}">🪙 ${fa(it.p)}</button>`;
  return `<div class="ic ${owned ? 'own' : ''}" style="--rc:${R.c};--rg:${R.g};--a:${A.bd.a};--b:${A.bd.b}" data-i="${it.id}"><div class="tgp">${esc(A.sy.e).repeat(26)}</div>
    <span class="code">کد ${fa(it.id)}</span><div class="ie">${it.e}</div><div class="in">${esc(it.n)}</div><div class="ir">${R.n}</div>${foot}</div>`;
}
function renderShop() {
  if (!me) return;
  $('shopCoins').textContent = '🪙 ' + fa(coinsOf(me));
  const t = me.lastDaily?.toMillis?.() || 0, can = Date.now() - t > 20 * 36e5;
  $('dailyBtn').textContent = can ? '🎁 جایزه‌ی روزانه: +۵۰ سکه' : 'جایزه‌ی امروز را گرفتی ✓';
  $('dailyBtn').disabled = !can; $('dailyBtn').style.opacity = can ? 1 : .55;
  $('shopTabs').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.t === shopTab));
  $('shopRf').innerHTML = [['all', 'همه'], ...Object.entries(RAR).map(([k, v]) => [k, v.n])].map(([k, n]) => `<button data-r="${k}" class="${shopRar === k ? 'on' : ''}">${n}</button>`).join('');
  if (shopTab === 'market') { $('shopGrid').innerHTML = marketHtml(); return; }
  let list = ITEMS.filter(i => shopRar === 'all' || i.r === shopRar);
  if (shopTab === 'mine') list = list.filter(i => hasItem(i.id));
  $('shopGrid').innerHTML = list.length ? list.map(i => itemCard(i)).join('') : '<p class="empty" style="grid-column:1/-1;padding:40px 0">هنوز کارتی نداری.<br>از فروشگاه یکی بخر 🛍</p>';
}
$('btnShop').onclick = () => { $('shop').classList.remove('hidden'); renderShop(); };
$('shopX').onclick = () => $('shop').classList.add('hidden');
$('shopTabs').onclick = e => { const b = e.target.closest('[data-t]'); if (b) { shopTab = b.dataset.t; renderShop(); } };
$('shopRf').onclick = e => { const b = e.target.closest('[data-r]'); if (b) { shopRar = b.dataset.r; renderShop(); } };
$('dailyBtn').onclick = async () => {
  try { selfOpAt = Date.now(); await updateDoc(doc(db, 'users', me.uid), { bonus: increment(50), lastDaily: serverTimestamp() }); toast('🎁 ۵۰ سکه گرفتی!'); }
  catch { toast('دریافت نشد'); }
};
$('shopGrid').onclick = e => {
  if (e.target.closest('#mkSell')) return sellModal();
  const mb = e.target.closest('[data-mkbuy]'); if (mb) { e.stopPropagation(); return marketDetail(mb.dataset.mkbuy); }
  const mk = e.target.closest('[data-mk]'); if (mk) return marketDetail(mk.dataset.mk);
  const buy = e.target.closest('[data-buy]');
  if (buy) { e.stopPropagation(); return confirmBuy(+buy.dataset.buy); }
  const c = e.target.closest('[data-i]'); if (!c) return;
  const it = ITEMS.find(i => i.id === +c.dataset.i);
  if (hasItem(it.id)) itemSheet(me.uid, it.id); else confirmBuy(it.id);
};
function confirmBuy(id) {
  const it = ITEMS.find(i => i.id === id), coins = coinsOf(me), R = RAR[it.r];
  if (hasItem(id)) return itemDetail(it);
  openModal(`<div class="big-ic">${itemCard(it, 'big')}</div>
    <p style="color:var(--mut)">قیمت: <b style="color:var(--gold2)">🪙 ${fa(it.p)}</b> — موجودی شما: 🪙 ${fa(coins)}</p>
    <div class="acts2">${coins >= it.p ? '<button class="btn" id="bOk">خرید</button>' : '<button class="btn ghost" disabled>سکه‌ی کافی نداری</button><small style="color:var(--mut)">با پیام دادن و جایزه‌ی روزانه سکه جمع کن</small>'}
      <button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('bOk')?.addEventListener('click', async () => {
    $('bOk').disabled = true;
    try {
      await runTransaction(db, async tx => {
        const ref = doc(db, 'users', me.uid), sref = doc(db, 'stats', 'issued');
        const u = (await tx.get(ref)).data(), st = (await tx.get(sref)).data() || {};
        if ((u.inventory || []).includes(id)) throw 'own';
        if (coinsOf(u) < it.p) throw 'poor';
        const n = (st['i' + id] || 0) + 1;
        selfOpAt = Date.now();
        tx.set(sref, { ['i' + id]: n }, { merge: true });
        tx.update(ref, { inventory: arrayUnion(id), spent: increment(it.p), ['invMeta.' + id]: newMeta(id, n, 'buy', it.p) });
      });
      toast('🎉 خرید موفق!'); setTimeout(() => itemSheet(me.uid, id), 600);
    } catch (e) { toast(e === 'poor' ? 'سکه‌ی کافی نداری' : e === 'own' ? 'قبلا خریدی' : 'خرید انجام نشد'); closeModal(); }
  });
}
function itemDetail(it) {
  const on = (me.charms || []).includes(it.e);
  openModal(`<div class="big-ic">${itemCard(it, 'big')}</div>
    <div class="acts2"><button class="btn" id="eqBtn">${on ? 'برداشتن از دور پروفایل' : 'نمایش دور پروفایل'}</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal; $('eqBtn').onclick = () => { closeModal(); toggleEquip(it); };
}
async function toggleEquip(it) {
  let ch = [...(me.charms || [])];
  if (ch.includes(it.e)) ch = ch.filter(x => x !== it.e);
  else { if (ch.length >= 3) return toast('حداکثر ۳ کارت دور پروفایل. اول یکی را بردار.'); ch.push(it.e); }
  try { await updateDoc(doc(db, 'users', me.uid), { charms: ch }); toast('پروفایل به‌روز شد ✨'); } catch { toast('انجام نشد'); }
}
const collectionHtml = u => {
  const its = (u.inventory || []).map(id => ITEMS.find(i => i.id === id)).filter(Boolean);
  if (!its.length) return '';
  return `<div class="sec-t">🎴 کلکسیون (${fa(its.length)} کارت)</div><div class="col-grid">${its.map(i => { const A = cardAttrs(u, i); return `<button class="mc" data-gi="${i.id}" style="--rc:${RAR[i.r].c};--rg:${RAR[i.r].g};--a:${A.bd.a};--b:${A.bd.b}"><div class="tgp">${esc(A.sy.e).repeat(10)}</div><span class="ie">${i.e}</span><small>#${fa(A.n)}</small></button>`; }).join('')}</div>`;
};

/* ======================= v1.5.0: کلن (فقط VIP می‌سازد، ظرفیت ۳۰ نفر) ======================= */
const CLAN_MAX = 30;
let clanList = [], unsubClans = null;
function listenClans() {
  unsubClans?.();
  unsubClans = onSnapshot(collection(db, 'clanIds'), sn => {
    clanList = sn.docs.map(d => ({ handle: d.id, ...d.data() })).sort((a, b) => (a.name || '').localeCompare(b.name || '', 'fa'));
    renderList();
  }, () => {});
}
const clanAv = c => c.photo ? `<img src="${c.photo}" alt="">` : esc(c.emoji || '🏰');
const clanRow = c => `<button class="row rc" data-clan="${esc(c.handle)}"><div class="avw"><div class="av" style="--ring:${ringOf(c.handle)}">${clanAv(c)}</div></div>
  <div class="nm"><b>${esc(c.name)}</b><small>@${esc(c.handle)}${c.bio ? ' • ' + esc(c.bio) : ''}</small></div><div class="rt"><span class="tag">${rooms[c.room] ? 'عضو هستی' : '🏰 کلن'}</span></div></button>`;
async function waitRoomThenOpen(id) { for (let i = 0; i < 25 && !rooms[id]; i++) await new Promise(r => setTimeout(r, 200)); if (rooms[id]) openRoom(id); }
function clanCard(handle) {
  const c = clanList.find(x => x.handle === handle); if (!c) return;
  const mem = !!rooms[c.room];
  openModal(`<div class="av lg" style="margin:auto">${clanAv(c)}</div><h3>${esc(c.name)}</h3><div class="id" dir="ltr">@${esc(c.handle)}</div>
    ${c.bio ? `<p style="color:var(--mut);line-height:1.9">${esc(c.bio)}</p>` : ''}
    <small style="color:var(--mut)">ظرفیت تا ${fa(CLAN_MAX)} نفر • ${c.open === false ? 'عضویت با دعوت مالک' : 'عضویت آزاد'}</small>
    <div class="acts2">${mem ? '<button class="btn" id="clGo">ورود به کلن</button>' : c.open === false ? '' : '<button class="btn" id="clJoin">عضو شدن</button>'}<button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('clGo')?.addEventListener('click', () => { closeModal(); openRoom(c.room); });
  $('clJoin')?.addEventListener('click', async () => {
    $('clJoin').disabled = true;
    try { await updateDoc(doc(db, 'rooms', c.room), { members: arrayUnion(me.uid) }); toast('🏰 عضو کلن شدی!'); closeModal(); waitRoomThenOpen(c.room); }
    catch { toast('کلن پر است یا عضویت آزاد نیست'); $('clJoin').disabled = false; }
  });
}
function pickPhoto(inputId, boxId, cb) {
  $(boxId).onclick = () => $(inputId).click();
  $(inputId).onchange = async e => { const f = e.target.files[0]; e.target.value = ''; if (!f) return; try { const d = await shrinkImage(f, 180, .72); $(boxId).innerHTML = `<img src="${d}" alt="">`; cb(d); } catch { toast('عکس خوانده نشد'); } };
}
function clanCreateModal() {
  let photo = '';
  const others = Object.values(users).filter(u => u.uid !== me.uid && !u.banned).sort((a, b) => a.name.localeCompare(b.name, 'fa'));
  openModal(`<h3>🏰 کلن جدید</h3>
    <div class="cl-photo" id="clPh">📷</div><input type="file" id="clFile" accept="image/*" class="vh">
    <div class="field" style="text-align:start"><label>نام کلن</label><input id="clName" maxlength="30"></div>
    <div class="field" style="text-align:start"><label>آیدی کلن (انگلیسی، بدون فاصله)</label><input id="clId" dir="ltr" maxlength="20" placeholder="my_clan"></div>
    <div class="field" style="text-align:start"><label>ایموجی</label><input id="clEmoji" value="🏰" maxlength="4"></div>
    <div class="field" style="text-align:start"><label>توضیح کوتاه (اختیاری)</label><input id="clBio" maxlength="100"></div>
    <label class="setrow"><span>عضویت آزاد (هر کس بتواند عضو شود)</span><input type="checkbox" id="clOpen" checked></label>
    <div style="text-align:start;color:var(--mut);font-size:.8rem">دعوت اعضا (اختیاری، حداکثر ${fa(CLAN_MAX - 1)} نفر)</div>
    <div class="pick">${others.map(u => `<label><input type="checkbox" value="${u.uid}"><div class="av sm">${avatarHtml(u)}</div><b>${esc(u.name)}</b></label>`).join('') || '<p class="empty">هنوز کاربر دیگری نیست</p>'}</div>
    <div class="err" id="clErr"></div>
    <div class="acts2"><button class="btn" id="clMake">ساخت کلن</button><button class="btn ghost" id="mClose">انصراف</button></div>`);
  $('mClose').onclick = closeModal; pickPhoto('clFile', 'clPh', d => { photo = d; });
  $('clMake').onclick = async () => {
    const name = $('clName').value.trim(), handle = $('clId').value.trim().toLowerCase(), bio = $('clBio').value.trim().slice(0, 100), emoji = $('clEmoji').value.trim() || '🏰';
    const sel = [...$('modalCard').querySelectorAll('.pick input:checked')].map(i => i.value).slice(0, CLAN_MAX - 1), open = $('clOpen').checked;
    if (!name) return $('clErr').textContent = 'نام کلن را بنویس.';
    if (!/^[a-z0-9_]{3,20}$/.test(handle)) return $('clErr').textContent = 'آیدی باید ۳ تا ۲۰ حرف انگلیسی/عدد/_ باشد.';
    if (!isStaff() && (badCheck(name) || badCheck(bio))) return $('clErr').textContent = 'نام یا توضیح نامناسب است.';
    $('clMake').disabled = true;
    const id = 'g_' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
    try {
      await runTransaction(db, async tx => {
        const cref = doc(db, 'clanIds', handle); if ((await tx.get(cref)).exists()) throw 'taken';
        tx.set(cref, { room: id, owner: me.uid, name, emoji, bio, photo, open });
        tx.set(doc(db, 'rooms', id), { type: 'group', clan: true, handle, name, emoji, bio, photo, open, max: CLAN_MAX, owner: me.uid, members: [me.uid, ...sel], created: Date.now() });
      });
      closeModal(); toast('🏰 کلن ساخته شد'); waitRoomThenOpen(id);
    } catch (e) { $('clErr').textContent = e === 'taken' ? 'این آیدی قبلا گرفته شده.' : 'ساخته نشد. دوباره امتحان کن.'; $('clMake').disabled = false; }
  };
}
function clanEditModal(r) {
  let photo = r.photo || '';
  openModal(`<h3>✎ ویرایش کلن</h3>
    <div class="cl-photo" id="clPh">${photo ? `<img src="${photo}" alt="">` : '📷'}</div><input type="file" id="clFile" accept="image/*" class="vh">
    <div class="field" style="text-align:start"><label>نام کلن</label><input id="clName" maxlength="30" value="${esc(r.name)}"></div>
    <div class="field" style="text-align:start"><label>ایموجی</label><input id="clEmoji" value="${esc(r.emoji || '🏰')}" maxlength="4"></div>
    <div class="field" style="text-align:start"><label>توضیح کوتاه</label><input id="clBio" maxlength="100" value="${esc(r.bio || '')}"></div>
    <label class="setrow"><span>عضویت آزاد</span><input type="checkbox" id="clOpen" ${r.open !== false ? 'checked' : ''}></label>
    <div class="err" id="clErr"></div>
    <div class="acts2"><button class="btn" id="clSave">ذخیره</button><button class="btn ghost" id="mClose">انصراف</button></div>`);
  $('mClose').onclick = closeModal; pickPhoto('clFile', 'clPh', d => { photo = d; });
  $('clSave').onclick = async () => {
    const patch = { name: $('clName').value.trim(), emoji: $('clEmoji').value.trim() || '🏰', bio: $('clBio').value.trim().slice(0, 100), photo, open: $('clOpen').checked };
    if (!patch.name) return $('clErr').textContent = 'نام کلن را بنویس.';
    if (!isStaff() && (badCheck(patch.name) || badCheck(patch.bio))) return $('clErr').textContent = 'نام یا توضیح نامناسب است.';
    $('clSave').disabled = true;
    try { await updateDoc(doc(db, 'rooms', room), patch); if (r.handle) await updateDoc(doc(db, 'clanIds', r.handle), patch); closeModal(); toast('ذخیره شد ✅'); }
    catch { $('clErr').textContent = 'ذخیره نشد.'; $('clSave').disabled = false; }
  };
}
function clanAddModal(r) {
  const inRoom = new Set(r.members || []);
  const list = Object.values(users).filter(u => !inRoom.has(u.uid) && !u.banned).sort((a, b) => a.name.localeCompare(b.name, 'fa'));
  openModal(`<h3>➕ افزودن عضو</h3><div class="searchbox" style="padding:6px 0"><input id="caQ" placeholder="جستجوی نام یا آیدی"></div><div class="pick" id="caList" style="max-height:44vh"></div>
    <div class="acts2"><button class="btn ghost" id="mClose">برگشت</button></div>`);
  $('mClose').onclick = showGroup;
  const draw = () => { const q = $('caQ').value.trim().toLowerCase(); $('caList').innerHTML = list.filter(u => !q || u.name.toLowerCase().includes(q) || (u.handle || '').includes(q)).slice(0, 40).map(u => `<label data-add="${u.uid}"><div class="av sm">${avatarHtml(u)}</div><b>${esc(u.name)}</b><small>${hid(u)}</small></label>`).join('') || '<p class="empty">کسی پیدا نشد</p>'; };
  draw(); $('caQ').oninput = draw;
  $('caList').onclick = async e => {
    const l = e.target.closest('[data-add]'); if (!l) return;
    if ((rooms[room]?.members || []).length >= CLAN_MAX) return toast('ظرفیت کلن پر است');
    try { await updateDoc(doc(db, 'rooms', room), { members: arrayUnion(l.dataset.add) }); toast('اضافه شد ✅'); l.remove(); } catch { toast('انجام نشد'); }
  };
}
function showGroup() {
  const r = rooms[room]; if (!r) return;
  const mem = (r.members || []).map(id => users[id]).filter(Boolean), isOwner = r.owner === me.uid, kick = isOwner && !r.deal;
  openModal(`<div class="av lg" style="margin:auto">${r.photo ? `<img src="${r.photo}" alt="">` : esc(r.emoji || '👥')}</div><h3>${esc(r.name)}</h3>
    ${r.handle ? `<div class="id" dir="ltr">@${esc(r.handle)}</div>` : ''}${r.bio ? `<p style="color:var(--mut);line-height:1.9">${esc(r.bio)}</p>` : ''}
    <small style="color:var(--mut)">${fa(mem.length)} از ${fa(r.max || CLAN_MAX)} عضو${r.deal ? ' • 🤝 معامله با نظارت مدیر' : r.open === false ? ' • عضویت با دعوت' : ' • عضویت آزاد'}</small>
    <div class="pick" id="clMem">${mem.map(u => `<label data-u="${u.uid}"><div class="av sm">${avatarHtml(u)}</div><b>${esc(u.name)}${u.uid === r.owner ? ' 👑' : ''}${u.handle === ADMIN_ID ? ' 🛡' : ''}</b>${kick && u.uid !== me.uid ? `<button class="icon" data-kick="${u.uid}" aria-label="حذف از کلن">✕</button>` : ''}</label>`).join('')}</div>
    <div class="acts2">${isOwner && !r.deal ? '<button class="btn" id="clEd">✎ ویرایش کلن</button><button class="btn ghost" id="clAd">➕ افزودن عضو</button>' : ''}${!isOwner ? '<button class="btn danger" id="gLeave">ترک</button>' : ''}<button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('clMem').onclick = async e => {
    const k = e.target.closest('[data-kick]');
    if (k) { if (!confirm('این عضو از کلن حذف شود؟')) return; try { await updateDoc(doc(db, 'rooms', room), { members: arrayRemove(k.dataset.kick) }); toast('حذف شد'); setTimeout(showGroup, 500); } catch { toast('انجام نشد'); } return; }
    const u = e.target.closest('[data-u]'); if (u) showProfile(u.dataset.u);
  };
  $('clEd')?.addEventListener('click', () => clanEditModal(r));
  $('clAd')?.addEventListener('click', () => clanAddModal(r));
  $('gLeave')?.addEventListener('click', async () => {
    if (!confirm('از کلن خارج می‌شوی؟')) return;
    try { await updateDoc(doc(db, 'rooms', room), { members: arrayRemove(me.uid) }); closeModal(); delete rooms[room]; openRoom('public'); } catch { toast('انجام نشد'); }
  });
}

/* ======================= v6: مدیریت، VIP، افکت‌ها، آنلاین‌ها ======================= */
let selfOpAt = 0, gw = null, admTab = 'users', groupReqsPending = [], myGReqs = [], unsubReqs = [], firstReqSnap = true;

/* افکت‌های دور پروفایل */
const FX = { none: 'بدون', rain: 'باران 🌧', snow: 'برف ❄️', storm: 'طوفان ⛈', bolt: 'صاعقه ⚡', stars: 'ستاره‌باران ✨', embers: 'آتش‌پاره 🔥' };
function fxHtml(k) {
  if (!k || k === 'none') return '';
  const n = { rain: 46, storm: 46, snow: 34, stars: 28, embers: 26 }[k] || 0;
  let p = '';
  for (let i = 0; i < n; i++) {
    const l = (i * 37 + 11) % 100, dl = ((i * 7) % 30) / 10;
    if (k === 'rain' || k === 'storm') p += `<i style="left:${l}%;animation-duration:${(.55 + (i % 5) * .12).toFixed(2)}s;animation-delay:-${(dl / 3).toFixed(2)}s"></i>`;
    else if (k === 'snow') p += `<i style="left:${l}%;animation-duration:${(4 + (i % 6) * .9).toFixed(1)}s;animation-delay:-${(dl * 1.6).toFixed(1)}s"></i>`;
    else if (k === 'stars') p += `<i style="left:${l}%;top:${(i * 53 + 7) % 100}%;animation-duration:${(2 + (i % 5) * .6).toFixed(1)}s;animation-delay:-${dl.toFixed(1)}s"></i>`;
    else p += `<i style="left:${l}%;animation-duration:${(3 + (i % 5) * .7).toFixed(1)}s;animation-delay:-${(dl * 1.2).toFixed(1)}s"></i>`;
  }
  const bolt = (k === 'storm' || k === 'bolt') ? '<b class="flash"></b><b class="bolt"></b>' : '';
  return `<div class="fx fx-${k}">${p}${bolt}</div>`;
}

/* هدیه‌ها: اطلاع به کاربر */
function giftWatch() {
  if (!me) return;
  const inv = me.inventory || [], cur = { n: inv.length, vip: !!me.vip, bonus: me.bonus || 0, mod: !!me.mod, rej: me.photoRejected || 0, pend: !!me.photoPending, photo: me.photo || '' };
  if (gw && Date.now() - selfOpAt > 4000) {
    if (cur.n > gw.n) {
      const nw = inv.slice(gw.n).map(id => ITEMS.find(i => i.id === id)).filter(Boolean);
      if (nw.length) { beep(); toast('🎁 هدیه از سازنده: ' + nw.map(i => i.e + ' ' + i.n).join('، ')); }
    }
    if (cur.mod && !gw.mod) { beep(); toast('🛡 سازنده تو را ناظر کرد!'); }
    if (cur.rej > gw.rej) toast('❌ عکس پروفایلت تایید نشد. یک عکس مناسب‌تر انتخاب کن.');
    if (gw.pend && !cur.pend && cur.photo !== gw.photo) toast('✅ عکس پروفایلت تایید شد');
    if (cur.vip && !gw.vip) { beep(); toast('⭐ سازنده به تو VIP داد! حالا می‌توانی گروه بسازی.'); }
    const dB = cur.bonus - gw.bonus; if (dB > 0 && dB !== 50) { beep(); toast(`🪙 ${fa(dB)} سکه هدیه گرفتی`); }
  }
  gw = cur;
}

/* کاربران آنلاین */
function showOnline() {
  const on = Object.values(users).filter(isOnline).sort((a, b) => a.name.localeCompare(b.name, 'fa'));
  openModal(`<h3>🟢 ${fa(on.length)} نفر آنلاین</h3><div class="pick" style="max-height:60vh">${on.map(u => `<label data-u="${u.uid}">${avw(avatarHtml(u), u)}<div class="nm"><b>${esc(u.name)}${u.vip ? '<span class="vipb">VIP</span>' : ''}</b><small>${esc(titleOf(u))}</small></div></label>`).join('') || '<p class="empty">کسی آنلاین نیست</p>'}</div>
    <div class="acts2"><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('modalCard').querySelectorAll('[data-u]').forEach(l => l.onclick = () => showProfile(l.dataset.u));
}
$('hInfo').onclick = () => {
  const i = info(room);
  if (i.user) showProfile(i.user.uid); else if (i.group) showGroup(); else if (roomType(room) === 'public') showOnline();
};

/* ساخت کلن: فقط VIP */
const canCreateGroup = () => !!(me.vip || isAdmin());
$('btnNewGroup').onclick = () => canCreateGroup() ? clanCreateModal() : vipClanModal();
function vipClanModal() {
  openModal(`<div style="font-size:2.6rem">🏰</div><h3>ساخت کلن</h3>
    <p style="color:var(--mut);line-height:2;margin:6px 0">ساخت کلن فقط برای اعضای <b style="color:var(--gold)">VIP</b> است.<br>کلن تا ${fa(CLAN_MAX)} نفر ظرفیت دارد و آیدی و پروفایل مخصوص خودش را دارد.<br>برای VIP شدن با مدیر در ارتباط باش.<br>می‌توانی از «جستجو» به کلن‌های دیگران بپیوندی.</p>
    <div class="acts2"><button class="btn" id="vcSearch">🔍 دیدن کلن‌ها</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal; $('vcSearch').onclick = () => { closeModal(); setTopTab('search'); };
}
function stopReqs() { botStop(); unsubReqs.forEach(f => f()); unsubReqs = []; groupReqsPending = []; myGReqs = []; firstReqSnap = true; }
function listenGroupReqs() {
  stopReqs();
  unsubReqs.push(onSnapshot(query(collection(db, 'groupRequests'), where('uid', '==', me.uid)), s => {
    myGReqs = s.docs.map(d => ({ id: d.id, ...d.data() }));
  }, () => {}));
  if (isAdmin()) unsubReqs.push(onSnapshot(query(collection(db, 'groupRequests'), where('status', '==', 'pending')), s => {
    const before = groupReqsPending.length;
    groupReqsPending = s.docs.map(d => ({ id: d.id, ...d.data() }));
    updateAdmBadge();
    if (!firstReqSnap && groupReqsPending.length > before) { beep(); toast('📩 درخواست ساخت گروه جدید رسید'); }
    firstReqSnap = false;
    if (!$('admin').classList.contains('hidden')) renderAdmin();
  }, () => {}));
}

/* پنل مدیریت سازنده */
$('btnAdmin').onclick = () => { $('admin').classList.remove('hidden'); renderAdmin(); };
$('admX').onclick = () => $('admin').classList.add('hidden');
$('admTabs').onclick = e => { const b = e.target.closest('[data-t]'); if (b) { admTab = b.dataset.t; renderAdmin(); } };
$('admSearch').oninput = renderAdmin;
function renderAdmin() {
  if (!me || !(isAdmin() || me.mod)) return;
  if (admTab === 'bot' && document.activeElement?.tagName === 'INPUT' && document.activeElement.closest('#admList')) return;
  $('admCnt').textContent = fa(Object.keys(users).length) + ' کاربر';
  $('admTabs').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.t === admTab));
  $('admTabs').querySelector('[data-t="reqs"]').textContent = 'درخواست گروه' + (groupReqsPending.length ? ` (${fa(groupReqsPending.length)})` : '');
  $('admTabs').querySelectorAll('[data-t="reqs"],[data-t="bot"]').forEach(b => b.classList.toggle('hidden', !isAdmin()));
  if (!isAdmin() && admTab !== 'users' && admTab !== 'photos') admTab = 'users';
  $('admTabs').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.t === admTab));
  const pp = pendingPhotos().length; $('admTabs').querySelector('[data-t="photos"]').textContent = '🖼 عکس‌ها' + (pp ? ` (${fa(pp)})` : '');
  $('admSearchW').classList.toggle('hidden', admTab !== 'users');
  if (admTab === 'users') {
    const q = $('admSearch').value.trim().toLowerCase();
    const list = Object.values(users).filter(u => !q || u.name.toLowerCase().includes(q) || (u.handle || '').includes(q))
      .sort((a, b) => (b.vip ? 1 : 0) - (a.vip ? 1 : 0) || a.name.localeCompare(b.name, 'fa'));
    $('admList').innerHTML = list.map(u => `<button class="row" data-au="${u.uid}">${avw(avatarHtml(u), u)}<div class="nm"><b>${esc(u.name)}${u.vip ? '<span class="vipb">VIP</span>' : ''}${u.banned ? ' 🚫' : ''}${isMuted(u) ? ' 🔇' : ''}${u.mod ? ' 🛡' : ''}</b>
      <small>${hid(u)} • 🪙 ${fa(coinsOf(u))} • 🎴 ${fa((u.inventory || []).length)}</small></div></button>`).join('') || '<p class="empty" style="padding:30px">کاربری نیست</p>';
  } else if (admTab === 'photos') {
    renderPhotos();
  } else if (admTab === 'bot') {
    renderBotTab();
  } else {
    $('admList').innerHTML = groupReqsPending.length ? groupReqsPending.map(r => {
      const u = users[r.uid];
      return `<div class="areq"><b>${esc(r.emoji || '👥')} ${esc(r.name)}</b>
        <div style="color:var(--mut);font-size:.85rem;margin:4px 0">از ${esc(u?.name || 'کاربر')} (${hid(u)})${r.note ? ' — ' + esc(r.note) : ''}</div>
        <div class="gbtns"><button class="btn" data-ok="${r.id}">ساخت گروه</button><button class="btn danger" data-no="${r.id}">رد</button></div></div>`;
    }).join('') : '<p class="empty" style="padding:30px">درخواستی نیست 🎉</p>';
  }
}
$('admList').onclick = async e => {
  if (await photoClick(e)) return;
  if (botTabClick(e)) return;
  const au = e.target.closest('[data-au]'); if (au) return adminUser(au.dataset.au);
  const ok = e.target.closest('[data-ok]'), no = e.target.closest('[data-no]');
  if (ok) {
    const r = groupReqsPending.find(x => x.id === ok.dataset.ok); if (!r) return;
    const gid = 'g_' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
    try {
      await setDoc(doc(db, 'rooms', gid), { type: 'group', name: r.name, emoji: r.emoji || '👥', owner: r.uid, members: [r.uid, me.uid], created: Date.now() });
      await updateDoc(doc(db, 'groupRequests', r.id), { status: 'approved', roomId: gid });
      toast('گروه ساخته شد ✅');
    } catch { toast('انجام نشد. قوانین را بررسی کنید.'); }
  }
  if (no) { try { await updateDoc(doc(db, 'groupRequests', no.dataset.no), { status: 'declined' }); toast('رد شد'); } catch { toast('انجام نشد'); } }
};
function adminUser(uid) {
  const u = users[uid]; if (!u) return;
  openModal(`<div class="av lg" style="margin:auto">${avatarHtml(u)}</div><h3>${esc(u.name)}${u.vip ? '<span class="vipb">VIP</span>' : ''}</h3><div class="id">${hid(u)}</div>
    <p style="color:var(--mut);margin-top:6px">🪙 ${fa(coinsOf(u))} • 🎴 ${fa((u.inventory || []).length)} کارت • 💬 ${fa(u.msgCount || 0)} پیام • ⚠️ ${fa(u.warns || 0)} اخطار</p>
    <div class="acts2">
      <button class="btn" id="aVip">${u.vip ? 'برداشتن VIP' : '⭐ دادن VIP'}</button>
      <button class="btn ghost" id="aGift">🎁 هدیه‌ی کارت (بدون سکه)</button>
      <button class="btn ghost" id="aCoin">🪙 هدیه‌ی سکه</button>
      <button class="btn ghost" id="aProf">👤 دیدن پروفایل</button>
      <button class="btn ghost" id="aMod">${u.mod ? '🛡 لغو ناظری' : '🛡 ناظر کردن'}</button>
      <button class="btn ghost" id="aPhoto">🗑 حذف عکس پروفایل</button>
      <button class="btn ghost" id="aMusic">🎵 حذف موسیقی پروفایل</button>
      <button class="btn ghost" id="aMute">${isMuted(u) ? '🔊 رفع سکوت' : '🔇 سکوت'}</button>
      <button class="btn ghost" id="aBan">${u.banned ? 'رفع مسدودی' : 'مسدود کردن'}</button>
      <button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  if (!isAdmin()) ['aVip', 'aGift', 'aCoin', 'aMod'].forEach(i => $(i)?.classList.add('hidden'));
  if (u.handle === ADMIN_ID || (!isAdmin() && u.mod)) ['aMute', 'aBan', 'aVip', 'aGift', 'aCoin', 'aMod', 'aPhoto', 'aMusic'].forEach(i => $(i)?.classList.add('hidden'));
  $('aProf').onclick = () => showProfile(uid);
  $('aVip').onclick = async () => { try { await updateDoc(doc(db, 'users', uid), { vip: !u.vip }); toast(u.vip ? 'VIP برداشته شد' : '⭐ VIP داده شد'); closeModal(); } catch { toast('انجام نشد'); } };
  $('aBan').onclick = async () => { try { await updateDoc(doc(db, 'users', uid), { banned: !u.banned }); toast(u.banned ? 'رفع مسدودی شد' : 'مسدود شد'); closeModal(); } catch { toast('انجام نشد'); } };
  $('aCoin').onclick = () => adminCoins(uid);
  $('aGift').onclick = () => adminGift(uid);
  $('aMute').onclick = () => isMuted(u) ? setMute(uid, 0).then(closeModal) : muteModal(uid);
  $('aMod').onclick = async () => { try { await updateDoc(doc(db, 'users', uid), { mod: !u.mod }); toast(u.mod ? 'ناظری لغو شد' : '🛡 ناظر شد'); closeModal(); } catch { toast('انجام نشد'); } };
  $('aPhoto').onclick = async () => { try { await updateDoc(doc(db, 'users', uid), { photo: '', photoPending: '' }); toast('عکس پروفایل حذف شد'); } catch { toast('انجام نشد'); } };
  $('aMusic').onclick = async () => { try { await deleteDoc(doc(db, 'music', uid)); await updateDoc(doc(db, 'users', uid), { musicTitle: '' }); toast('موسیقی حذف شد'); } catch { toast('انجام نشد'); } };
}
function adminCoins(uid) {
  const u = users[uid];
  openModal(`<h3>🪙 هدیه‌ی سکه به ${esc(u.name)}</h3>
    <div class="amt">${[100, 500, 1000, 5000].map(n => `<button data-n="${n}">+${fa(n)}</button>`).join('')}</div>
    <div class="field" style="text-align:start"><label>مقدار دلخواه (عدد منفی = کم کردن)</label><input id="cAmt" type="number" dir="ltr" placeholder="250"></div>
    <div class="acts2"><button class="btn" id="cOk">ثبت</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = () => adminUser(uid);
  $('modalCard').querySelectorAll('[data-n]').forEach(b => b.onclick = () => { $('cAmt').value = b.dataset.n; });
  $('cOk').onclick = async () => {
    const n = parseInt($('cAmt').value, 10); if (!n) return toast('عدد را وارد کنید');
    try { await updateDoc(doc(db, 'users', uid), { bonus: increment(n) }); toast(`${fa(n)} سکه ثبت شد ✅`); adminUser(uid); } catch { toast('انجام نشد'); }
  };
}
function adminGift(uid) {
  const u = users[uid], inv = u.inventory || [];
  openModal(`<h3>🎁 هدیه‌ی کارت به ${esc(u.name)}</h3><p style="color:var(--mut);font-size:.85rem">روی کارت بزن تا داده شود. روی کارت ✓دار بزنی برداشته می‌شود.</p>
    <div class="gift-grid">${ITEMS.map(i => `<button class="gg ${inv.includes(i.id) ? 'own' : ''}" style="--rc:${RAR[i.r].c};--rg:${RAR[i.r].g}" data-g="${i.id}"><span>${i.e}</span>${esc(i.n)}</button>`).join('')}</div>
    <div class="acts2"><button class="btn ghost" id="mClose">برگشت</button></div>`);
  $('mClose').onclick = () => adminUser(uid);
  $('modalCard').querySelectorAll('[data-g]').forEach(b => b.onclick = async () => {
    const id = +b.dataset.g, has = (users[uid].inventory || []).includes(id), it = ITEMS.find(x => x.id === id);
    if (has && !confirm('این کارت از کاربر برداشته شود؟')) return;
    try {
      if (has) await updateDoc(doc(db, 'users', uid), { inventory: arrayRemove(id), ['invMeta.' + id]: deleteField() }); else await giveItem(uid, id);
      toast(has ? 'کارت برداشته شد' : `🎁 ${it.n} هدیه داده شد`);
      setTimeout(() => adminGift(uid), 400);
    } catch { toast('انجام نشد'); }
  });
}


/* ======================= v7: ربات، فیلتر فحش، سکوت ======================= */
const BOT_PHOTO = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="#1b1b1b"/><text x="32" y="47" font-size="40" text-anchor="middle">🤖</text></svg>');
const BOT_U = { name: 'ربات پرو چت', handle: 'bot', photo: BOT_PHOTO, uid: 'bot' };
const isMuted = u => (u?.mutedUntil || 0) > Date.now();

/* --- فیلتر کلمات نامناسب --- */
const normFa = s => String(s || '').toLowerCase()
  .replace(/[\u064B-\u065F\u0670\u0640\u200b-\u200f\u202a-\u202e]/g, '')
  .replace(/ك/g, 'ک').replace(/[يى]/g, 'ی').replace(/[ةۀ]/g, 'ه').replace(/ؤ/g, 'و').replace(/[إأآ]/g, 'ا')
  .replace(/(.)\1{2,}/g, '$1');
const SUB_BAD = ['کسکش', 'کصکش', 'کوسکش', 'جنده', 'جندع', 'حرومزاده', 'حرامزاده', 'پدرسگ', 'مادرجنده', 'مادرقحبه', 'قحبه', 'کونکش', 'کیرخر', 'کیرم', 'کیری', 'کونی', 'گاییدم', 'گاییدن', 'گاییده', 'دیوث', 'بیناموس', 'خارکسه', 'خارکصه', 'کسخل'].map(normFa);
const EXACT_BAD = ['کیر', 'کون', 'کص', 'گایید', 'عوضی'].map(normFa);
const LATIN_BAD = ['fuck', 'shit', 'bitch', 'asshole', 'pussy'];
const botCfgDefault = { on: true, filter: true, autoMute: true, welcome: true, words: [], replies: [] };
let botCfg = { ...botCfgDefault };
function badCheck(text) {
  if (botCfg.filter === false) return '';
  const n = normFa(text), toks = n.split(/[^a-z0-9\u0600-\u06ff]+/).filter(Boolean), sq = n.replace(/[^\u0600-\u06ff]/g, '');
  const ex = (botCfg.words || []).map(normFa).filter(Boolean);
  const subs = [...SUB_BAD, ...ex.filter(w => w.length >= 4)], exact = [...EXACT_BAD, ...ex.filter(w => w.length < 4)];
  for (const w of subs) if (sq.includes(w)) return w;
  for (const t of toks) { if (exact.includes(t)) return t; for (const w of LATIN_BAD) if (t.includes(w)) return w; }
  return '';
}
function listenBotCfg() {
  unsubReqs.push(onSnapshot(doc(db, 'settings', 'bot'), s => {
    botCfg = { ...botCfgDefault, ...(s.exists() ? s.data() : {}) };
    if (!$('admin').classList.contains('hidden')) renderAdmin();
  }, () => {}));
}

/* --- ربات چت خودکار (وقتی سازنده آنلاین است) --- */
let botUnsub = null, botTimer = null, botKnown = null;
const botLast = {};
const JOKES = [
  'به یارو گفتن چرا ساعتت رو آینه‌ای گذاشتی؟ گفت چون وقتم برعکسه! ⏰😄',
  'پسره به باباش میگه بابا من یه ایده‌ی میلیاردی دارم! بابا: بگو. گفت: بگو خودم میلیاردر بشم! 💰😂',
  'کامپیوتر چرا سرما خورد؟ چون ویندوزهاش باز بود! 🪟😷',
  'به یه برنامه‌نویس گفتن برو شیر بخر، اگه تخم‌مرغ داشتن شش‌تا بیار. ده‌تا شیر آورد، گفت تخم‌مرغ داشتن! 🥛😂',
  'خواب‌آلودگی مشکل نیست، سبک زندگیه 😴'
];
const botSay = text => post('public', { text, bot: true, name: 'ربات پرو چت' });
function botStart() {
  botStop();
  if (!isAdmin()) return;
  let first = true;
  botUnsub = onSnapshot(query(collection(db, 'rooms', 'public', 'msgs'), orderBy('createdAt'), limitToLast(25)), s => {
    if (first) { first = false; return; }
    s.docChanges().forEach(c => { if (c.type === 'added') botHandle({ id: c.doc.id, ...c.doc.data() }); });
  }, () => {});
  botTimer = setInterval(botTick, 4000);
}
function botStop() { botUnsub?.(); botUnsub = null; clearInterval(botTimer); botTimer = null; botKnown = null; }
function botTick() {
  if (!isAdmin() || !botCfg.on) return;
  const ids = Object.keys(users);
  if (!botKnown) { botKnown = new Set(ids); return; }
  ids.forEach(id => {
    if (botKnown.has(id)) return; botKnown.add(id);
    const u = users[id];
    if (botCfg.welcome !== false && Date.now() - (u.createdAt?.toMillis?.() || 0) < 120000) botSay(`👋 خوش آمدی ${u.name}! برای راهنما /help بنویس.`).catch(() => {});
  });
}
function cool(key, ms) { const n = Date.now(); if (n - (botLast[key] || 0) < ms) return false; botLast[key] = n; return true; }
async function botHandle(m) {
  if (m.bot || m.deleted || !botCfg.on) return;
  const text = (m.text || '').trim(); if (!text) return;
  const sender = users[m.uid], isAd = sender?.handle === ADMIN_ID;
  if (!isAd && botCfg.filter !== false && badCheck(text)) {
    const n = (sender?.warns || 0) + 1, name = sender?.name || m.name || 'کاربر';
    try {
      await updateDoc(doc(db, 'rooms', 'public', 'msgs', m.id), { deleted: true, text: '', img: '', audio: '' });
      if (botCfg.autoMute !== false && n >= 3) {
        await updateDoc(doc(db, 'users', m.uid), { warns: 0, mutedUntil: Date.now() + 36e5 });
        await botSay(`🔇 ${name} به‌خاطر تکرار کلمات نامناسب ۱ ساعت ساکت شد.`);
      } else {
        await updateDoc(doc(db, 'users', m.uid), { warns: increment(1) });
        await botSay(`⚠️ ${name}، پیامت به‌خاطر کلمات نامناسب حذف شد. (اخطار ${fa(n)} از ۳)`);
      }
    } catch {}
    return;
  }
  const first = text.split(/\s+/)[0].toLowerCase(), on = Object.values(users).filter(isOnline);
  const alias = { '/راهنما': '/help', '/آنلاین': '/online', '/ساعت': '/time', '/تاس': '/dice', '/شیرخط': '/coin', '/جوک': '/joke', '/برترین': '/top' };
  const cmds = {
    '/help': () => '🤖 دستورها:\n/help راهنما\n/online آنلاین‌ها\n/time ساعت\n/dice تاس\n/coin شیر یا خط\n/joke جوک\n/top برترین‌ها',
    '/online': () => `🟢 ${fa(on.length)} نفر آنلاین: ` + on.slice(0, 8).map(u => u.name).join('، '),
    '/time': () => '🕒 ساعت: ' + fa(new Date().toLocaleTimeString('fa-IR', { hour: '2-digit', minute: '2-digit' })),
    '/dice': () => '🎲 ' + fa(1 + Math.floor(Math.random() * 6)),
    '/coin': () => Math.random() < .5 ? '🪙 شیر' : '🪙 خط',
    '/joke': () => JOKES[Math.floor(Math.random() * JOKES.length)],
    '/top': () => '🏆 برترین‌ها:\n' + Object.values(users).sort((a, b) => (b.msgCount || 0) - (a.msgCount || 0)).slice(0, 3).map((u, i) => `${['🥇', '🥈', '🥉'][i]} ${u.name} — ${fa(u.msgCount || 0)} پیام`).join('\n')
  };
  const c = alias[first] || first;
  if (cmds[c]) { if (cool('c' + c, 3000)) botSay(cmds[c]()).catch(() => {}); return; }
  const nt = normFa(text);
  for (const r of (botCfg.replies || [])) {
    if (r.k && nt.includes(normFa(r.k)) && cool('r' + r.k, 10000)) { botSay(r.v).catch(() => {}); return; }
  }
}

/* --- سکوت --- */
function setMute(uid, until) {
  return updateDoc(doc(db, 'users', uid), { mutedUntil: until, warns: 0 })
    .then(() => toast(until ? '🔇 ساکت شد' : '🔊 سکوت برداشته شد')).catch(() => toast('انجام نشد'));
}
function muteModal(uid) {
  const u = users[uid];
  openModal(`<h3>🔇 سکوت ${esc(u.name)}</h3><div class="amt">${[['۱۰ دقیقه', 10], ['۱ ساعت', 60], ['۱ روز', 1440], ['۱ هفته', 10080], ['دائم', 0]].map(([l, m]) => `<button data-m="${m}">${l}</button>`).join('')}</div>
    <div class="acts2"><button class="btn ghost" id="mClose">برگشت</button></div>`);
  $('mClose').onclick = () => adminUser(uid);
  $('modalCard').querySelectorAll('[data-m]').forEach(b => b.onclick = async () => {
    const m = +b.dataset.m; await setMute(uid, m ? Date.now() + m * 60000 : 9999999999999); closeModal();
  });
}

/* --- تب ربات در پنل مدیریت --- */
const saveBot = patch => setDoc(doc(db, 'settings', 'bot'), patch, { merge: true }).catch(() => toast('ذخیره نشد. قوانین را بررسی کنید.'));
function renderBotTab() {
  const c = botCfg;
  const T = (k, l) => `<div class="setrow"><span>${l}</span><button class="btn ghost" style="width:auto;padding:6px 16px" data-tg="${k}">${c[k] !== false ? 'روشن' : 'خاموش'}</button></div>`;
  $('admList').innerHTML = `<div class="areq">${T('on', 'ربات فعال')}${T('filter', 'فیلتر کلمات نامناسب')}${T('autoMute', 'سکوت خودکار بعد از ۳ اخطار')}${T('welcome', 'خوش‌آمدگویی به کاربر جدید')}
      <small style="color:var(--mut);display:block;margin-top:8px;line-height:1.8">حذف پیام‌های نامناسب، پاسخ و دستورات ربات تا وقتی کار می‌کنند که شما (سازنده) آنلاین باشید. خود فیلتر برای همه‌ی کاربران قبل از ارسال هم کار می‌کند.</small></div>
    <div class="areq"><b>کلمات ممنوعه‌ی اضافه</b>
      <div class="mini-col" style="margin-top:8px">${(c.words || []).map((w, i) => `<div class="mini-ic" style="--rc:var(--gold-d);--rg:var(--glow)">${esc(w)} <button data-delw="${i}" aria-label="حذف">✕</button></div>`).join('') || '<small style="color:var(--mut)">هنوز کلمه‌ای اضافه نشده</small>'}</div>
      <div class="searchbox" style="padding:6px 0 0"><input id="botW" placeholder="کلمه‌ی جدید"><button class="btn" data-addw="1" style="width:auto;padding:8px 16px">افزودن</button></div></div>
    <div class="areq"><b>پاسخ خودکار</b>
      <div style="margin:8px 0">${(c.replies || []).map((r, i) => `<div class="setrow"><span style="flex:1">«${esc(r.k)}» ← ${esc(r.v)}</span><button class="icon" data-delr="${i}" aria-label="حذف">✕</button></div>`).join('') || '<small style="color:var(--mut)">هنوز پاسخی تعریف نشده</small>'}</div>
      <div class="field"><input id="botK" placeholder="اگر پیام شامل این بود…  (مثلا: قیمت)"></div>
      <div class="field"><input id="botV" placeholder="ربات این را جواب بدهد…"></div>
      <button class="btn" data-addr="1">افزودن پاسخ</button></div>`;
}
function botTabClick(e) {
  const tg = e.target.closest('[data-tg]'); if (tg) { saveBot({ [tg.dataset.tg]: botCfg[tg.dataset.tg] === false }); return true; }
  const dw = e.target.closest('[data-delw]'); if (dw) { saveBot({ words: (botCfg.words || []).filter((_, i) => i !== +dw.dataset.delw) }); return true; }
  const dr = e.target.closest('[data-delr]'); if (dr) { saveBot({ replies: (botCfg.replies || []).filter((_, i) => i !== +dr.dataset.delr) }); return true; }
  if (e.target.closest('[data-addw]')) { const w = $('botW').value.trim(); if (w) saveBot({ words: [...(botCfg.words || []), w].slice(0, 100) }); return true; }
  if (e.target.closest('[data-addr]')) { const k = $('botK').value.trim(), v = $('botV').value.trim(); if (k && v) saveBot({ replies: [...(botCfg.replies || []), { k, v }].slice(0, 50) }); else toast('هر دو کادر را پر کنید'); return true; }
  return false;
}


/* ======================= v8: کارت‌های تلگرامی، موسیقی، حذف چت، ناظر، تایید عکس ======================= */
let issued = {};
const SUPPLY = { common: 250000, rare: 60000, epic: 12000, legend: 1500 };
const RARP = { common: 5, rare: 3, epic: 1.5, legend: 0.5 };
const BACKDROPS = [
  { k: 'sand', n: 'شن صحرا', a: '#a8987a', b: '#6f6248', p: 1 }, { k: 'pine', n: 'سبز کاج', a: '#5e9a7a', b: '#34624f', p: 1.2 },
  { k: 'indigo', n: 'نیلی', a: '#5a7a99', b: '#34506c', p: 1.5 }, { k: 'rasp', n: 'تمشکی', a: '#d27a8a', b: '#9a3f66', p: 1 },
  { k: 'violet', n: 'بنفش شب', a: '#7b5ac0', b: '#3f2c80', p: 0.8 }, { k: 'sunset', n: 'غروب', a: '#e8935f', b: '#b4502c', p: 2 },
  { k: 'ice', n: 'یخ', a: '#82bfdc', b: '#3f81a6', p: 2 }, { k: 'night', n: 'شب', a: '#4a4f5a', b: '#16181d', p: 3 },
  { k: 'gold', n: 'طلایی', a: '#e2b93f', b: '#8a6410', p: 0.3 }, { k: 'ruby', n: 'یاقوت', a: '#d24b4b', b: '#7a1c24', p: 0.6 },
  { k: 'emerald', n: 'زمرد', a: '#3fbf8a', b: '#136447', p: 1.4 }, { k: 'rose', n: 'گل‌سرخ', a: '#e86a9a', b: '#8f2450', p: 1.3 },
  { k: 'aqua', n: 'فیروزه', a: '#3fd0d6', b: '#14707a', p: 1.8 }, { k: 'cosmos', n: 'کیهانی', a: '#5b3fd0', b: '#150f45', p: 2.5 }
];
const SYMBOLS = [
  { e: '🎩', n: 'کلاه سیلندر', p: 0.4 }, { e: '⭐', n: 'ستاره', p: 1 }, { e: '🌙', n: 'ماه', p: 0.7 }, { e: '🍀', n: 'شبدر', p: 1.2 },
  { e: '🔥', n: 'آتش', p: 0.5 }, { e: '❄️', n: 'دانه‌ی برف', p: 0.9 }, { e: '🦋', n: 'پروانه', p: 0.6 }, { e: '🌸', n: 'شکوفه', p: 1.1 },
  { e: '⚓', n: 'لنگر', p: 0.4 }, { e: '💫', n: 'ستاره‌ی شهابی', p: 0.8 },
  { e: '💠', n: 'نگین', p: 0.6 }, { e: '🎀', n: 'پاپیون', p: 1.1 }, { e: '🌀', n: 'گرداب', p: 0.7 }, { e: '✨', n: 'درخشش', p: 1.5 }
];
const shopAttrs = it => ({ bd: BACKDROPS[it.id % BACKDROPS.length], sy: SYMBOLS[(it.id * 3) % SYMBOLS.length] });
const newMeta = (id, n, how, p) => ({ n, bd: BACKDROPS[Math.floor(Math.random() * BACKDROPS.length)].k, sy: Math.floor(Math.random() * SYMBOLS.length), p, how, at: Date.now() });
function cardAttrs(u, it) {
  const m = u.invMeta?.[it.id];
  const h = [...(String(u.uid) + it.id)].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
  const bd = BACKDROPS.find(b => b.k === m?.bd) || BACKDROPS[h % BACKDROPS.length];
  const sy = SYMBOLS[m?.sy ?? ((h >> 3) % SYMBOLS.length)] || SYMBOLS[0];
  return { n: m?.n || (1000 + h % 90000), bd, sy, how: m?.how || 'buy', paid: m ? m.p : it.p, at: m?.at || 0 };
}
function listenStats() { unsubReqs.push(onSnapshot(doc(db, 'stats', 'issued'), s => { issued = s.exists() ? s.data() : {}; }, () => {})); }
async function giveItem(uid, id) {
  await runTransaction(db, async tx => {
    const uref = doc(db, 'users', uid), sref = doc(db, 'stats', 'issued');
    const u = (await tx.get(uref)).data(), st = (await tx.get(sref)).data() || {};
    if ((u.inventory || []).includes(id)) throw 'own';
    const n = (st['i' + id] || 0) + 1;
    tx.set(sref, { ['i' + id]: n }, { merge: true });
    tx.update(uref, { inventory: arrayUnion(id), ['invMeta.' + id]: newMeta(id, n, 'gift', 0) });
  });
}

/* برگه‌ی کارت (مثل تلگرام) */
function itemSheet(uid, id) {
  const it = ITEMS.find(i => i.id === id), u = users[uid]; if (!it || !u) return;
  const A = cardAttrs(u, it), R = RAR[it.r], self = uid === me.uid, iss = issued['i' + id] || 0;
  const on = (me.charms || []).includes(it.e), gift = A.how === 'gift';
  openModal(`<div class="gs-top" style="--a:${A.bd.a};--b:${A.bd.b}"><div class="tgp">${esc(A.sy.e).repeat(30)}</div>
      <div class="gs-art">${it.e}</div><div class="gs-name">${esc(it.n)} <small>#${fa(A.n)}</small></div><div class="gs-sub"><span class="gs-pill" style="--rc:${R.c}">${R.n}</span></div></div>
    <button class="pf-x" id="pX" aria-label="بستن">✕</button>
    <div class="pf-body"><table class="pf-tbl">
      <tr><th>مالک</th><td><a class="own-l" id="gsOwn"><span class="av">${avatarHtml(u)}</span>${esc(u.name)}</a></td></tr>
      <tr><th>خریدار</th><td>${gift ? '🎁 هدیه' : A.how === 'market' ? '🏪 خرید از بازار' : esc(u.name)}</td></tr>
      <tr><th>قیمت خرید</th><td>${gift ? 'رایگان (هدیه)' : '🪙 ' + fa(A.paid)}</td></tr>
      <tr><th>ارزش فعلی</th><td>🪙 ${fa(it.p)}</td></tr>
      <tr><th>مدل</th><td>${esc(it.n)}<span class="pct">${fa(RARP[it.r])}٪</span></td></tr>
      <tr><th>نماد</th><td>${A.sy.e} ${esc(A.sy.n)}<span class="pct">${fa(A.sy.p)}٪</span></td></tr>
      <tr><th>پس‌زمینه</th><td>${esc(A.bd.n)}<span class="pct">${fa(A.bd.p)}٪</span></td></tr>
      <tr><th>تعداد</th><td>${fa(iss)} / ${fa(SUPPLY[it.r])} صادر شده</td></tr>
      <tr><th>تاریخ</th><td>${A.at ? fa(new Date(A.at).toLocaleDateString('fa-IR')) : '—'}</td></tr></table>
      <div class="acts2">${self ? `<button class="btn ghost" id="gsEq">${on ? 'برداشتن از دور پروفایل' : 'نمایش دور پروفایل'}</button>` : ''}<button class="btn" id="gsOk">باشه</button></div></div>`, 'pf-card');
  $('pX').onclick = $('gsOk').onclick = closeModal;
  $('gsOwn').onclick = () => showProfile(uid);
  $('gsEq')?.addEventListener('click', () => { closeModal(); toggleEquip(it); });
}

/* ======================= v1.3: هدیه‌ی کاربران و بازار کارت ======================= */
let unsubGifts = null, unsubMarket = null, unsubSales = null, marketList = [];
const numOf = v => parseInt(enDigits(String(v || '')).replace(/\D/g, ''), 10) || 0;
const unequip = (u, id) => { const it = ITEMS.find(i => i.id === id); return it && (u.charms || []).includes(it.e) ? { charms: u.charms.filter(x => x !== it.e) } : {}; };
const metaOf = (u, id) => { if (u.invMeta?.[id]) return u.invMeta[id]; const it = ITEMS.find(i => i.id === id), A = cardAttrs(u, it); return { n: A.n, bd: A.bd.k, sy: Math.max(0, SYMBOLS.indexOf(A.sy)), p: A.paid, how: A.how, at: A.at }; };
const errMsg = e => ({ poor: 'سکه‌ی کافی نداری', nocard: 'این کارت دیگر مال تو نیست', has: 'او این کارت را دارد', nouser: 'کاربر پیدا نشد', gone: 'این آگهی دیگر موجود نیست', mine: 'این آگهی خودته', own: 'این کارت را از قبل داری' }[e] || 'انجام نشد. اینترنت و قوانین Firestore را بررسی کن.');

/* ---------- هدیه ---------- */
function listenGifts() {
  unsubGifts?.();
  unsubGifts = onSnapshot(query(collection(db, 'gifts'), where('to', '==', me.uid), where('claimed', '==', false)), sn => sn.docs.forEach(d => claimGift(d.id)), () => {});
}
const claiming = new Set();
async function claimGift(id) {
  if (claiming.has(id)) return; claiming.add(id);
  try {
    let g;
    await runTransaction(db, async tx => {
      const gref = doc(db, 'gifts', id), uref = doc(db, 'users', me.uid);
      g = (await tx.get(gref)).data(); if (!g || g.claimed || g.to !== me.uid) throw 'skip';
      const u = (await tx.get(uref)).data(), upd = { refCol: 'gifts', refId: id };
      if (g.coins > 0) upd.gin = increment(g.coins);
      if (g.card && !(u.inventory || []).includes(g.card)) { upd.inventory = arrayUnion(g.card); upd['invMeta.' + g.card] = { ...(g.meta || newMeta(g.card, 0, 'gift', 0)), how: 'gift' }; }
      selfOpAt = Date.now(); tx.update(gref, { claimed: true }); tx.update(uref, upd);
    });
    beep(); toast(`🎁 ${g.fromName || 'یک نفر'} برایت ${g.coins ? '🪙 ' + fa(g.coins) + ' سکه' : (ITEMS.find(i => i.id === g.card)?.n || 'کارت')} فرستاد`);
  } catch (e) { /* قبلا گرفته شده */ } finally { claiming.delete(id); }
}
async function sendGift(to, kind, val) {
  const gid = 'g' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
  await runTransaction(db, async tx => {
    const mref = doc(db, 'users', me.uid), rs = await tx.get(doc(db, 'users', to)), u = (await tx.get(mref)).data(), r = rs.data();
    if (!r || r.banned) throw 'nouser';
    const g = { from: me.uid, fromName: me.name, to, coins: 0, card: 0, meta: null, claimed: false, at: Date.now() }, upd = {};
    if (kind === 'coins') { if (val < 1 || coinsOf(u) < val) throw 'poor'; g.coins = val; upd.spent = increment(val); }
    else {
      if (!(u.inventory || []).includes(val)) throw 'nocard';
      if ((r.inventory || []).includes(val)) throw 'has';
      g.card = val; g.meta = metaOf(u, val);
      Object.assign(upd, { inventory: arrayRemove(val), ['invMeta.' + val]: deleteField() }, unequip(u, val));
    }
    selfOpAt = Date.now(); tx.update(mref, upd); tx.set(doc(db, 'gifts', gid), g);
  });
}
function giftModal(uid) {
  const u = users[uid]; if (!u) return;
  let kind = 'coins', pick = 0;
  const mine = (me.inventory || []).map(id => ITEMS.find(i => i.id === id)).filter(i => i && !(u.inventory || []).includes(i.id));
  openModal(`<div style="font-size:2.6rem">🎁</div><h3>هدیه به ${esc(u.name)}</h3>
    <div class="pf-tabs" id="gfTabs"><button data-k="coins" class="on">🪙 سکه</button><button data-k="card">🎴 کارت</button></div>
    <div id="gfBody"></div><div class="err" id="gfErr"></div>
    <div class="acts2"><button class="btn" id="gfOk">🎁 ارسال هدیه</button><button class="btn ghost" id="gfNo">بستن</button></div>`);
  const body = () => {
    $('gfErr').textContent = '';
    $('gfBody').innerHTML = kind === 'coins'
      ? `<div class="field" style="text-align:start"><label>مبلغ هدیه (موجودی تو: 🪙 ${fa(coinsOf(me))})</label><input id="gfAmt" inputmode="numeric" placeholder="مثلا ۱۰۰"></div>
         <div class="gf-amt">${[50, 100, 500, 1000].map(n => `<button data-a="${n}">${fa(n)}</button>`).join('')}</div>`
      : (mine.length ? `<div class="gf-grid">${mine.map(i => `<button class="gf-card ${pick === i.id ? 'on' : ''}" data-pk="${i.id}"><span class="e">${i.e}</span><small>${esc(i.n)}</small><small style="color:${RAR[i.r].c}">${RAR[i.r].n}</small></button>`).join('')}</div>`
        : '<p class="empty" style="padding:18px">کارتی نداری که بتوانی هدیه بدهی (یا او همه‌شان را دارد) 🎴</p>');
    $('gfBody').querySelectorAll('[data-a]').forEach(b => b.onclick = () => { $('gfAmt').value = b.dataset.a; });
    $('gfBody').querySelectorAll('[data-pk]').forEach(b => b.onclick = () => { pick = +b.dataset.pk; body(); });
  };
  body();
  $('gfTabs').onclick = e => { const b = e.target.closest('[data-k]'); if (!b) return; kind = b.dataset.k; $('gfTabs').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b)); body(); };
  $('gfNo').onclick = () => showProfile(uid);
  $('gfOk').onclick = async () => {
    const val = kind === 'coins' ? numOf($('gfAmt')?.value) : pick;
    if (kind === 'coins' && val < 1) return $('gfErr').textContent = 'مبلغ را وارد کن.';
    if (kind === 'coins' && val > coinsOf(me)) return $('gfErr').textContent = 'سکه‌ی کافی نداری.';
    if (kind === 'card' && !val) return $('gfErr').textContent = 'یک کارت انتخاب کن.';
    $('gfOk').disabled = true;
    try { await sendGift(uid, kind, val); toast('🎁 هدیه ارسال شد'); closeModal(); }
    catch (e) { $('gfErr').textContent = errMsg(e); $('gfOk').disabled = false; }
  };
}

/* ---------- بازار کارت‌ها ---------- */
function listenMarket() {
  unsubMarket?.(); unsubSales?.();
  unsubMarket = onSnapshot(query(collection(db, 'market'), where('status', '==', 'open')), sn => {
    marketList = sn.docs.map(d => ({ id: d.id, ...d.data() }));
    if (!$('shop').classList.contains('hidden') && shopTab === 'market') renderShop();
  }, () => {});
  unsubSales = onSnapshot(query(collection(db, 'market'), where('seller', '==', me.uid), where('status', '==', 'sold'), where('paid', '==', false)), sn => sn.docs.forEach(d => claimSale(d.id)), () => {});
}
const mkFee = price => Math.floor(price * 0.95);
function marketCard(l) {
  const it = ITEMS.find(i => i.id === l.card); if (!it) return '';
  const A = cardAttrs({ uid: l.seller, invMeta: { [l.card]: l.meta } }, it), R = RAR[it.r], mine = l.seller === me.uid;
  return `<div class="ic" style="--rc:${R.c};--rg:${R.g};--a:${A.bd.a};--b:${A.bd.b}" data-mk="${l.id}"><div class="tgp">${esc(A.sy.e).repeat(26)}</div>
    <span class="code">#${fa(A.n)}</span><div class="ie">${it.e}</div><div class="in">${esc(it.n)}</div><div class="ir">${R.n} • ${esc(l.sellerName || '')}</div>
    ${mine ? '<div class="own-b">آگهی تو</div>' : `<button class="price ${coinsOf(me) < l.price ? 'poor' : ''}" data-mkbuy="${l.id}">🪙 ${fa(l.price)}</button>`}</div>`;
}
function marketHtml() {
  const list = marketList.filter(l => shopRar === 'all' || ITEMS.find(i => i.id === l.card)?.r === shopRar).sort((a, b) => b.at - a.at);
  return `<div style="grid-column:1/-1"><button class="btn" id="mkSell">➕ فروش کارت من در بازار</button><p style="color:var(--mut);font-size:.8rem;text-align:center;margin-top:8px;line-height:1.8">کاربران کارت می‌گذارند و بقیه می‌خرند. بعد از خرید، کارت از فروشنده پاک و به خریدار داده می‌شود. کارمزد ۵٪ از فروشنده.</p></div>`
    + (list.length ? list.map(marketCard).join('') : '<p class="empty" style="grid-column:1/-1;padding:30px 0">هنوز کارتی در بازار نیست.<br>اولین نفر باش! 🏪</p>');
}
function marketDetail(id) {
  const l = marketList.find(x => x.id === id); if (!l) return toast('این آگهی دیگر موجود نیست');
  const it = ITEMS.find(i => i.id === l.card), mine = l.seller === me.uid, A = cardAttrs({ uid: l.seller, invMeta: { [l.card]: l.meta } }, it), R = RAR[it.r], coins = coinsOf(me);
  openModal(`<div class="big-ic">${marketCard(l).replace(/data-mk="[^"]*"/, '').replace(/<button class="price[^]*?<\/button>/, '').replace(/<div class="own-b">[^]*?<\/div>/, '')}</div>
    <table class="pf-tbl"><tr><th>فروشنده</th><td><a class="own-l" id="mkSeller">${esc(l.sellerName || '')}</a></td></tr>
      <tr><th>قیمت</th><td>🪙 ${fa(l.price)}</td></tr><tr><th>شماره‌ی کارت</th><td>#${fa(A.n)}</td></tr>
      <tr><th>نماد</th><td>${A.sy.e} ${esc(A.sy.n)}</td></tr><tr><th>پس‌زمینه</th><td>${esc(A.bd.n)}</td></tr><tr><th>نوع</th><td>${R.n}</td></tr></table>
    ${mine ? '' : `<p style="color:var(--mut);font-size:.85rem">موجودی تو: 🪙 ${fa(coins)}<br>با «ادامه» یک گروه ۳ نفره (خریدار، فروشنده و مدیر ناظر) برای معامله ساخته می‌شود 🤝</p>`}
    <div class="acts2">${mine ? '<button class="btn danger" id="mkCancel">لغو آگهی و پس گرفتن کارت</button>'
      : coins >= l.price ? `<button class="btn" id="mkBuy">ادامه و خرید 🤝 🪙 ${fa(l.price)}</button>` : '<button class="btn ghost" disabled>سکه‌ی کافی نداری</button>'}
      <button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('mkSeller').onclick = () => showProfile(l.seller);
  $('mkBuy')?.addEventListener('click', async () => {
    $('mkBuy').disabled = true;
    try { await marketBuy(id); toast('🎉 کارت را خریدی! گروه معامله ساخته می‌شود…'); closeModal(); openDeal(l); }
    catch (e) { toast(errMsg(e)); closeModal(); }
  });
  $('mkCancel')?.addEventListener('click', async () => {
    $('mkCancel').disabled = true;
    try { await marketCancel(id); toast('آگهی لغو شد و کارت برگشت'); closeModal(); } catch (e) { toast(errMsg(e)); closeModal(); }
  });
}
async function marketBuy(id) {
  await runTransaction(db, async tx => {
    const lref = doc(db, 'market', id), mref = doc(db, 'users', me.uid);
    const l = (await tx.get(lref)).data(), u = (await tx.get(mref)).data();
    if (!l || l.status !== 'open') throw 'gone';
    if (l.seller === me.uid) throw 'mine';
    if ((u.inventory || []).includes(l.card)) throw 'own';
    if (coinsOf(u) < l.price) throw 'poor';
    selfOpAt = Date.now();
    tx.update(lref, { status: 'sold', buyer: me.uid, soldAt: Date.now() });
    tx.update(mref, { inventory: arrayUnion(l.card), spent: increment(l.price), ['invMeta.' + l.card]: { ...(l.meta || {}), how: 'market', p: l.price, at: Date.now() }, refCol: 'market', refId: id });
  });
}
async function marketCancel(id) {
  await runTransaction(db, async tx => {
    const lref = doc(db, 'market', id), mref = doc(db, 'users', me.uid);
    const l = (await tx.get(lref)).data(), u = (await tx.get(mref)).data();
    if (!l || l.status !== 'open' || l.seller !== me.uid) throw 'gone';
    const upd = { refCol: 'market', refId: id };
    if (!(u.inventory || []).includes(l.card)) { upd.inventory = arrayUnion(l.card); if (l.meta) upd['invMeta.' + l.card] = l.meta; }
    selfOpAt = Date.now(); tx.update(lref, { status: 'cancelled' }); tx.update(mref, upd);
  });
}
const claimingS = new Set();
async function claimSale(id) {
  if (claimingS.has(id)) return; claimingS.add(id);
  try {
    let l;
    await runTransaction(db, async tx => {
      const lref = doc(db, 'market', id), mref = doc(db, 'users', me.uid);
      l = (await tx.get(lref)).data(); if (!l || l.paid || l.seller !== me.uid || l.status !== 'sold') throw 'skip';
      selfOpAt = Date.now(); tx.update(lref, { paid: true }); tx.update(mref, { gin: increment(mkFee(l.price)), refCol: 'market', refId: id });
    });
    beep(); toast(`💰 «${ITEMS.find(i => i.id === l.card)?.n || 'کارت'}» فروخته شد: +${fa(mkFee(l.price))} سکه`);
  } catch (e) { /* قبلا پرداخت شده */ } finally { claimingS.delete(id); }
}
async function listCard(id, price) {
  await runTransaction(db, async tx => {
    const mref = doc(db, 'users', me.uid), u = (await tx.get(mref)).data();
    if (!(u.inventory || []).includes(id)) throw 'nocard';
    selfOpAt = Date.now();
    tx.update(mref, { inventory: arrayRemove(id), ['invMeta.' + id]: deleteField(), ...unequip(u, id) });
    tx.set(doc(collection(db, 'market')), { seller: me.uid, sellerName: me.name, card: id, meta: metaOf(u, id), price, status: 'open', paid: false, at: Date.now() });
  });
}
function sellModal() {
  const mine = (me.inventory || []).map(id => ITEMS.find(i => i.id === id)).filter(Boolean);
  if (!mine.length) return toast('کارتی برای فروش نداری. اول از فروشگاه بخر 🛍');
  let pick = mine[0].id;
  openModal(`<h3>🏪 فروش کارت در بازار</h3>
    <div class="gf-grid" id="sCards"></div>
    <div class="field" style="text-align:start"><label>قیمت (سکه)</label><input id="sPrice" inputmode="numeric"></div>
    <p style="color:var(--mut);font-size:.82rem;min-height:22px" id="sNote"></p><div class="err" id="sErr"></div>
    <div class="acts2"><button class="btn" id="sOk">گذاشتن در بازار</button><button class="btn ghost" id="sNo">بستن</button></div>`);
  const cards = () => { $('sCards').innerHTML = mine.map(i => `<button class="gf-card ${pick === i.id ? 'on' : ''}" data-pk="${i.id}"><span class="e">${i.e}</span><small>${esc(i.n)}</small><small style="color:${RAR[i.r].c}">${RAR[i.r].n}</small></button>`).join('');
    $('sCards').querySelectorAll('[data-pk]').forEach(b => b.onclick = () => { pick = +b.dataset.pk; $('sPrice').value = ITEMS.find(i => i.id === pick).p; note(); cards(); }); };
  const note = () => { const v = numOf($('sPrice').value); $('sNote').textContent = v >= 10 ? `خریدار 🪙 ${fa(v)} می‌دهد و تو بعد از کارمزد ۵٪، 🪙 ${fa(mkFee(v))} می‌گیری.` : ''; };
  $('sPrice').value = ITEMS.find(i => i.id === pick).p; note(); cards();
  $('sPrice').oninput = note; $('sNo').onclick = closeModal;
  $('sOk').onclick = async () => {
    const price = numOf($('sPrice').value);
    if (price < 10 || price > 100000) return $('sErr').textContent = 'قیمت باید بین ۱۰ و ۱۰۰٬۰۰۰ سکه باشد.';
    $('sOk').disabled = true;
    try { await listCard(pick, price); toast('🏪 کارت در بازار گذاشته شد'); closeModal(); shopTab = 'market'; renderShop(); }
    catch (e) { $('sErr').textContent = errMsg(e); $('sOk').disabled = false; }
  };
}

/* حذف دو طرفه‌ی چت خصوصی */
async function deleteChat(id) {
  if (!confirm('این چت برای هر دو نفر حذف شود؟\nهمه‌ی پیام‌ها پاک می‌شوند و قابل بازگشت نیست.')) return;
  try {
    const snap = await getDocs(collection(db, 'rooms', id, 'msgs'));
    let batch = writeBatch(db), n = 0;
    for (const d of snap.docs) { batch.delete(d.ref); if (++n % 400 === 0) { await batch.commit(); batch = writeBatch(db); } }
    await batch.commit();
    await updateDoc(doc(db, 'rooms', id), { last: deleteField(), pinned: deleteField(), typing: deleteField(), unread: deleteField(), read: deleteField() });
    toast('چت برای هر دو نفر حذف شد 🗑');
    if (room === id) openRoom('public');
  } catch { toast('حذف نشد. قوانین Firestore را بررسی کنید.'); }
}

/* موسیقی پروفایل */
let curAudio = null, curAudioUid = null;
function stopMusic() { if (curAudio) { curAudio.pause(); curAudio = null; curAudioUid = null; } const i = document.getElementById('pMusI'); if (i) i.textContent = '▶'; }
async function toggleMusic(uid) {
  if (curAudio && curAudioUid === uid) { stopMusic(); return; }
  stopMusic();
  try {
    const s = await getDoc(doc(db, 'music', uid)); if (!s.exists()) return toast('موسیقی پیدا نشد');
    curAudio = new Audio(s.data().data); curAudioUid = uid; curAudio.onended = stopMusic;
    await curAudio.play(); const i = $('pMusI'); if (i) i.textContent = '⏸';
  } catch { stopMusic(); toast('پخش نشد. مرورگر این فرمت را پشتیبانی نمی‌کند.'); }
}
const musicHtml = (u, self) => (u.musicTitle ? `<button class="mus" id="pMus"><span>🎵</span><b>${esc(u.musicTitle)}</b><i id="pMusI">▶</i></button>` : '')
  + (self ? `<button class="mus ghost" id="pMusNew"><span>➕</span><b>${u.musicTitle ? 'تغییر موسیقی پروفایل' : 'افزودن موسیقی به پروفایل'}</b></button>` : '');
function wireProfileExtras(uid) {
  const mc = $('modalCard');
  mc.querySelectorAll('[data-gi]').forEach(b => b.onclick = () => itemSheet(uid, +b.dataset.gi));
  $('pMus')?.addEventListener('click', () => toggleMusic(uid));
  mc.querySelectorAll('[data-charm]').forEach(c => c.onclick = () => {
    const it = ITEMS.find(i => i.e === c.dataset.charm && (users[uid]?.inventory || []).includes(i.id));
    if (it) itemSheet(uid, it.id); else toast('این فقط یک نماد ساده است ✨');
  });
  $('pMusNew')?.addEventListener('click', musicModal);
}
function recordClip(ac, buf, start, dur, onProg) {
  return new Promise((resolve, reject) => {
    try {
      const dest = ac.createMediaStreamDestination(), src = ac.createBufferSource(); src.buffer = buf; src.connect(dest);
      const mime = window.MediaRecorder && MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus' : '';
      const rec = new MediaRecorder(dest.stream, mime ? { mimeType: mime, audioBitsPerSecond: 24000 } : { audioBitsPerSecond: 24000 });
      const ch = []; rec.ondataavailable = e => ch.push(e.data);
      const len = Math.min(dur, buf.duration - start), t0 = Date.now();
      rec.onstop = () => { clearInterval(iv); const fr = new FileReader(); fr.onload = () => resolve(fr.result); fr.readAsDataURL(new Blob(ch, { type: rec.mimeType })); };
      const iv = setInterval(() => onProg(Math.min(100, Math.round((Date.now() - t0) / (len * 10)))), 400);
      rec.start(); src.start(0, start, len); setTimeout(() => rec.stop(), len * 1000 + 300);
    } catch (e) { reject(e); }
  });
}
function musicModal() {
  const today = new Date().toLocaleDateString('en-CA');
  if (me.musicDay === today) return toast('امروز موسیقی گذاشتی. فردا دوباره می‌توانی عوضش کنی 🎵');
  openModal(`<h3>🎵 موسیقی پروفایل</h3><p style="color:var(--mut);line-height:1.9;margin:6px 0">روزی یک‌بار می‌توانی موسیقی بگذاری. یک بخش ۱ دقیقه‌ای از آهنگ انتخاب می‌شود.</p>
    <label class="btn" for="fileMusic" style="display:block;text-align:center;cursor:pointer;margin-top:10px">🎧 انتخاب آهنگ از گالری</label>
    <div id="mBox"></div><div class="acts2"><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('fileMusic').onchange = async e => {
    const f = e.target.files[0]; e.target.value = ''; if (!f) return;
    $('mBox').innerHTML = '<p style="color:var(--mut);margin-top:10px">در حال خواندن آهنگ…</p>';
    try {
      const ac = new (window.AudioContext || window.webkitAudioContext)();
      const buf = await ac.decodeAudioData(await f.arrayBuffer());
      const maxStart = Math.max(0, Math.floor(buf.duration - 60));
      $('mBox').innerHTML = `<div class="field" style="text-align:start;margin-top:10px"><label>نام آهنگ</label><input id="mTitle" maxlength="40" value="${esc(f.name.replace(/\.[^.]+$/, '').slice(0, 40))}"></div>
        ${maxStart ? `<div class="field" style="text-align:start"><label>شروع از ثانیه‌ی <b id="mSt">۰</b> (از ${fa(Math.floor(buf.duration))})</label><input id="mStart" type="range" min="0" max="${maxStart}" value="0" style="width:100%"></div>` : ''}
        <div class="lvl" id="mProg" style="display:none"><i style="width:0"></i></div><button class="btn" id="mGo">ساخت و ذخیره</button>`;
      $('mStart')?.addEventListener('input', ev => { $('mSt').textContent = fa(ev.target.value); });
      $('mGo').onclick = async () => {
        const title = $('mTitle').value.trim().slice(0, 40) || 'موسیقی من';
        if (!isStaff() && badCheck(title)) return toast('🤖 نام آهنگ نامناسب است.');
        $('mGo').disabled = true; $('mGo').textContent = 'در حال آماده‌سازی…'; $('mProg').style.display = 'block'; await ac.resume();
        try {
          const data = await recordClip(ac, buf, +($('mStart')?.value || 0), 60, p => { const b = $('mProg')?.firstChild; if (b) b.style.width = p + '%'; });
          if (data.length > 700000) throw new Error('big');
          await setDoc(doc(db, 'music', me.uid), { data, title, at: serverTimestamp() });
          await updateDoc(doc(db, 'users', me.uid), { musicTitle: title, musicDay: today });
          closeModal(); toast('🎵 موسیقی پروفایل ذخیره شد');
        } catch { toast('ذخیره نشد. یک آهنگ دیگر یا بخش دیگری را امتحان کنید.'); $('mGo').disabled = false; $('mGo').textContent = 'ساخت و ذخیره'; }
        ac.close?.();
      };
    } catch { $('mBox').innerHTML = '<p class="err">این فایل خوانده نشد. یک فایل صوتی (MP3/M4A/WAV) انتخاب کنید.</p>'; }
  };
}

/* ناظر و بررسی عکس */
const isStaff = () => !!me && (isAdmin() || !!me.mod);
const photoPatch = d => isStaff() ? { photo: d.photo || '' } : (d.photo !== me.photo ? { photoPending: d.photo || '', photoRejected: 0 } : {});
const pendingPhotos = () => Object.values(users).filter(u => u.photoPending);
function updateAdmBadge() {
  if (!me || !isStaff()) return;
  const n = pendingPhotos().length + (isAdmin() ? groupReqsPending.length : 0);
  $('admN').textContent = fa(n); $('admN').classList.toggle('hidden', !n);
}
function renderPhotos() {
  const p = pendingPhotos();
  $('admList').innerHTML = p.length ? p.map(u => `<div class="areq"><div class="ph"><img src="${u.photoPending}" alt=""><div><b>${esc(u.name)}</b><div style="color:var(--mut);font-size:.82rem">${hid(u)}</div></div></div>
    <div class="gbtns" style="margin-top:10px"><button class="btn" data-pa="${u.uid}">تایید ✓</button><button class="btn danger" data-pr="${u.uid}">رد ✕</button></div></div>`).join('')
    : '<p class="empty" style="padding:30px">عکسی در انتظار تایید نیست 🎉</p>';
}
async function photoClick(e) {
  const a = e.target.closest('[data-pa]'), r = e.target.closest('[data-pr]');
  if (a) { const u = users[a.dataset.pa]; try { await updateDoc(doc(db, 'users', u.uid), { photo: u.photoPending, photoPending: '' }); toast('عکس تایید شد ✅'); } catch { toast('انجام نشد'); } return true; }
  if (r) { try { await updateDoc(doc(db, 'users', r.dataset.pr), { photoPending: '', photoRejected: Date.now() }); toast('عکس رد شد'); } catch { toast('انجام نشد'); } return true; }
  return false;
}

/* ======================= v9: چک آپدیت خودکار ======================= */
const CURRENT_VERSION = "1.6.1";
function showUpdateBanner(data) {
  if (document.getElementById('updBanner')) return;
  const b = document.createElement('div'); b.id = 'updBanner';
  const t = document.createElement('div'); t.className = 'ut';
  const h = document.createElement('b'); h.textContent = '🎉 نسخه جدید موجود است!'; t.appendChild(h);
  if (data.notes) { const n = document.createElement('small'); n.textContent = data.notes; t.appendChild(n); }
  const btn = document.createElement('button'); btn.textContent = 'بروزرسانی';
  btn.onclick = async () => {
    btn.disabled = true; btn.textContent = '...';
    try { localStorage.setItem('pc_upd_tried', data.version + '|' + Date.now()); } catch {}
    try { const rs = await navigator.serviceWorker?.getRegistrations?.(); if (rs) await Promise.all(rs.map(r => r.unregister())); } catch {}
    try { const ks = await caches?.keys?.(); if (ks) await Promise.all(ks.map(k => caches.delete(k))); } catch {}
    location.href = location.pathname + '?v=' + Date.now();
  };
  b.append(t, btn); document.body.appendChild(b);
}
async function checkUpdate() {
  try {
    const r = await fetch('version.json?t=' + Date.now(), { cache: 'no-store' });
    if (!r.ok) return;
    const data = await r.json();
    if (data && data.version && data.version !== CURRENT_VERSION) {
      /* اگر تازه بروزرسانی زده و هنوز نسخه قدیمی بالا آمده (کش گیت‌هاب)، تا ۱۰ دقیقه دوباره بنر نشان نده */
      const [tv, tt] = (localStorage.getItem('pc_upd_tried') || '|0').split('|');
      if (tv === data.version && Date.now() - Number(tt) < 10 * 60 * 1000) return;
      showUpdateBanner(data);
    } else localStorage.removeItem('pc_upd_tried');
  } catch (e) { /* بی‌صدا */ }
}
setTimeout(checkUpdate, 3000);
setInterval(checkUpdate, 5 * 60 * 1000);

/* ======================= v9: استوری کلیپ ۱ دقیقه‌ای (VIP) ======================= */
let stories = {};
const STORY_TTL = 24 * 3600 * 1000, STORY_MAX = 60, STORY_CHUNK = 600000, STORY_LIMIT = 5200000;
const canStory = () => !!me && (me.vip || isAdmin());
const storyFresh = s => !!s && !!s.at && Date.now() - s.at < STORY_TTL;
function listenStories() {
  unsubStories?.();
  unsubStories = onSnapshot(collection(db, 'stories'), sn => {
    stories = {}; sn.forEach(d => stories[d.id] = d.data());
    if (me && stories[me.uid] && !storyFresh(stories[me.uid])) delStory(me.uid, true);
    renderStoryBar();
  }, () => {});
  setTimeout(renderStoryBar, 2500);
}
setInterval(() => { if (me) renderStoryBar(); }, 20000);
function renderStoryBar() {
  const el = $('storyBar'); if (!el || !me) return;
  const list = Object.values(stories).filter(storyFresh).sort((a, b) => (a.uid === me.uid ? -1 : b.uid === me.uid ? 1 : b.at - a.at));
  const add = canStory() ? `<button class="sitem" id="stAdd"><div class="sring add">＋</div><small>استوری من</small></button>` : '';
  const items = list.map(st => { const u = users[st.uid] || { name: st.name, uid: st.uid };
    const seen = st.uid !== me.uid && localStorage.getItem('sv_' + st.uid) === String(st.at);
    return `<button class="sitem" data-st="${esc(st.uid)}"><div class="sring ${seen ? 'seen' : ''}"><div class="sav">${avatarHtml(u)}</div></div><small>${esc(st.uid === me.uid ? 'استوری تو' : (u.name || st.name || ''))}</small></button>`; }).join('');
  el.innerHTML = (add || items) ? `<div class="srow">${add}${items}</div>` : '';
  $('stAdd')?.addEventListener('click', storyModal);
  el.querySelectorAll('[data-st]').forEach(b => b.onclick = () => openStory(b.dataset.st));
}
async function delStory(uid, silent) {
  try {
    for (const sub of ['parts', 'views']) {
      const ps = await getDocs(collection(db, 'stories', uid, sub));
      for (let i = 0; i < ps.docs.length; i += 400) { const b = writeBatch(db); ps.docs.slice(i, i + 400).forEach(d => b.delete(d.ref)); await b.commit(); }
    }
    await deleteDoc(doc(db, 'stories', uid));
    if (!silent) toast('استوری حذف شد');
  } catch { if (!silent) toast('حذف نشد'); }
}
/* فشرده‌سازی: ویدیو با کیفیت پایین دوباره ضبط می‌شود تا حجمش در Firestore جا شود */
function encodeStory(v, onProg, stopRef) {
  return new Promise(async (resolve, reject) => {
    try {
      const AC = window.AudioContext || window.webkitAudioContext, ac = new AC();
      await ac.resume();
      const sc = Math.min(1, 480 / Math.max(v.videoWidth, v.videoHeight));
      const cv = document.createElement('canvas'); cv.width = Math.max(2, Math.round(v.videoWidth * sc / 2) * 2); cv.height = Math.max(2, Math.round(v.videoHeight * sc / 2) * 2);
      const cx = cv.getContext('2d');
      const dest = ac.createMediaStreamDestination(); ac.createMediaElementSource(v).connect(dest);
      const stream = new MediaStream([...cv.captureStream(24).getVideoTracks(), ...dest.stream.getAudioTracks()]);
      const mime = ['video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'].find(m => window.MediaRecorder && MediaRecorder.isTypeSupported(m)) || '';
      const rec = new MediaRecorder(stream, { ...(mime ? { mimeType: mime } : {}), videoBitsPerSecond: 220000, audioBitsPerSecond: 32000 });
      const ch = []; rec.ondataavailable = e => e.data.size && ch.push(e.data);
      const dur = Math.min(STORY_MAX, v.duration || STORY_MAX);
      let done = false, raf;
      const finish = () => { if (done) return; done = true; cancelAnimationFrame(raf); v.pause(); if (rec.state !== 'inactive') rec.stop(); };
      rec.onstop = () => { ac.close?.(); if (stopRef.abort) return reject(new Error('abort')); const base = (rec.mimeType || 'video/webm').split(';')[0]; const fr = new FileReader(); fr.onload = () => resolve({ data: fr.result.slice(fr.result.indexOf(',') + 1), dur, mime: base }); fr.readAsDataURL(new Blob(ch, { type: base })); };
      const draw = () => { if (done) return; cx.drawImage(v, 0, 0, cv.width, cv.height); onProg(Math.min(100, Math.round(v.currentTime / dur * 100)));
        if (v.currentTime >= dur || v.ended || stopRef.abort) return finish(); raf = requestAnimationFrame(draw); };
      v.onended = finish;
      rec.start(500); await v.play(); draw();
    } catch (e) { reject(e); }
  });
}
function storyModal() {
  if (!canStory()) return toast('استوری فقط برای اعضای VIP است ⭐');
  const st = { abort: false };
  openModal(`<h3>🎬 استوری کلیپ</h3><p style="color:var(--mut);line-height:1.9;margin:6px 0">یک ویدیوی حداکثر ۱ دقیقه‌ای بگذار. تا ۲۴ ساعت دیده می‌شود. اگر ویدیو بلندتر باشد، یک دقیقه‌ی اول برداشته می‌شود.</p>
    <label class="btn" for="fileStory" style="display:block;text-align:center;cursor:pointer;margin-top:10px">🎞 انتخاب ویدیو از گالری</label>
    <div id="sBox"></div><div class="acts2"><button class="btn ghost" id="sClose">بستن</button></div>`);
  $('sClose').onclick = () => { st.abort = true; closeModal(); };
  $('fileStory').onchange = async e => {
    const f = e.target.files[0]; e.target.value = ''; if (!f) return;
    $('sBox').innerHTML = '<p style="color:var(--mut);margin-top:10px">در حال خواندن ویدیو…</p>';
    const v = document.createElement('video'); v.playsInline = true; v.preload = 'auto'; v.src = URL.createObjectURL(f);
    try {
      await new Promise((ok, no) => { v.onloadedmetadata = ok; v.onerror = () => no(new Error('bad')); });
      $('sBox').innerHTML = `<div class="field" style="text-align:start;margin-top:10px"><label>توضیح (اختیاری)</label><input id="sCap" maxlength="80"></div>
        <div class="lvl" id="sProg" style="display:none"><i style="width:0"></i></div><button class="btn" id="sGo">انتشار استوری</button>`;
      $('sGo').onclick = async () => {
        const cap = $('sCap').value.trim().slice(0, 80);
        if (cap && !isStaff() && badCheck(cap)) return toast('🤖 توضیح نامناسب است.');
        $('sGo').disabled = true; $('sGo').textContent = 'در حال آماده‌سازی… (هم‌زمان با مدت ویدیو)'; $('sProg').style.display = 'block';
        try {
          const r = await encodeStory(v, p => { const b = $('sProg')?.firstChild; if (b) b.style.width = p + '%'; }, st);
          if (r.data.length > STORY_LIMIT) throw new Error('big');
          $('sGo').textContent = 'در حال ارسال…';
          await delStory(me.uid, true);
          const n = Math.ceil(r.data.length / STORY_CHUNK);
          for (let i = 0; i < n; i++) await setDoc(doc(db, 'stories', me.uid, 'parts', String(i).padStart(3, '0')), { i, d: r.data.slice(i * STORY_CHUNK, (i + 1) * STORY_CHUNK) });
          await setDoc(doc(db, 'stories', me.uid), { uid: me.uid, name: me.name, cap, at: Date.now(), parts: n, dur: Math.round(r.dur), mime: r.mime });
          closeModal(); toast('🎬 استوری منتشر شد');
        } catch (err) { if (!st.abort) { toast('منتشر نشد. ویدیوی کوتاه‌تر یا دیگری را امتحان کنید.'); $('sGo').disabled = false; $('sGo').textContent = 'انتشار استوری'; } }
        URL.revokeObjectURL(v.src);
      };
    } catch { $('sBox').innerHTML = '<p class="err">این فایل خوانده نشد. یک ویدیوی معتبر انتخاب کنید.</p>'; }
  };
}
let storyUrl = null, viewUnsub = null;
const agoFa = ms => { const m = Math.max(1, Math.round((Date.now() - ms) / 60000)); return m < 60 ? fa(m) + ' دقیقه پیش' : fa(Math.floor(m / 60)) + ' ساعت پیش'; };
const b64blob = (b64, type) => { const bin = atob(b64), u8 = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i); return new Blob([u8], { type }); };
function closeStory() {
  const ov = $('storyView'); ov.querySelector('video')?.pause(); ov.classList.add('hidden'); ov.innerHTML = '';
  viewUnsub?.(); viewUnsub = null;
  if (storyUrl) { URL.revokeObjectURL(storyUrl); storyUrl = null; }
}
async function openStory(uid) {
  const s = stories[uid]; if (!storyFresh(s)) return;
  if (!s.mime) { if (uid === me.uid) delStory(uid, true); return toast('این استوری قدیمی و خراب است. دوباره بگذار.'); }
  const ov = $('storyView'); ov.classList.remove('hidden'); ov.innerHTML = '<div class="sload">در حال بارگذاری…</div>';
  try {
    const sn = await getDocs(query(collection(db, 'stories', uid, 'parts'), orderBy('i')));
    if (sn.docs.length < (s.parts || 1)) throw new Error('incomplete');
    storyUrl = URL.createObjectURL(b64blob(sn.docs.map(d => d.data().d).join(''), s.mime));
    const u = users[uid] || { name: s.name }, own = uid === me.uid, canDel = own || isAdmin();
    ov.innerHTML = `<div class="sprog"><i id="stP"></i></div>
      <div class="sh"><div class="sav">${avatarHtml(u)}</div><b>${esc(u.name || s.name || '')}<small>${agoFa(s.at)}</small></b>${canDel ? '<button id="stDel" aria-label="حذف">🗑</button>' : ''}<button id="stX" aria-label="بستن">✕</button></div>
      <video src="${storyUrl}" autoplay playsinline></video>
      ${s.cap ? `<div class="sc">${esc(s.cap)}</div>` : ''}
      ${own ? '<button class="sviews" id="stV">👁 ۰ بازدید</button>' : ''}`;
    const v = ov.querySelector('video'), dur = s.dur || 60;
    v.ontimeupdate = () => { const p = $('stP'); if (p) p.style.width = Math.min(100, v.currentTime / dur * 100) + '%'; };
    v.onended = closeStory;
    v.onerror = () => { closeStory(); toast('این ویدیو پخش نشد'); };
    v.onclick = () => (v.paused ? v.play() : v.pause());
    v.play().catch(() => {});
    $('stX').onclick = closeStory;
    $('stDel')?.addEventListener('click', async () => { closeStory(); await delStory(uid); });
    let ty = 0; ov.ontouchstart = e => { ty = e.touches[0].clientY; }; ov.ontouchend = e => { if (e.changedTouches[0].clientY - ty > 120) closeStory(); };
    if (!own) {
      try { localStorage.setItem('sv_' + uid, String(s.at)); } catch {}
      setDoc(doc(db, 'stories', uid, 'views', me.uid), { uid: me.uid, name: me.name, at: Date.now() }).catch(() => {});
      renderStoryBar();
    } else {
      let views = [];
      viewUnsub = onSnapshot(collection(db, 'stories', uid, 'views'), vs => {
        views = vs.docs.map(d => d.data()).sort((a, b) => b.at - a.at);
        const b = $('stV'); if (b) b.textContent = '👁 ' + fa(views.length) + ' بازدید';
      }, () => {});
      $('stV').onclick = () => {
        v.pause(); const l = document.createElement('div'); l.className = 'svlist';
        l.innerHTML = `<div class="svbox"><h4>👁 ${fa(views.length)} بازدید</h4>${views.map(x => { const w = users[x.uid] || { name: x.name }; return `<div class="svrow"><span class="sav">${avatarHtml(w)}</span><b>${esc(w.name || x.name || '')}</b><small>${agoFa(x.at)}</small></div>`; }).join('') || '<p class="empty" style="padding:14px">هنوز کسی ندیده</p>'}<button class="btn" id="svOk">باشه</button></div>`;
        ov.appendChild(l);
        const done = () => { l.remove(); v.play().catch(() => {}); };
        l.querySelector('#svOk').onclick = done; l.onclick = e => { if (e.target === l) done(); };
      };
    }
  } catch { closeStory(); toast('استوری بارگذاری نشد'); }
}

/* ======================= v9.1: لرزش، سوایپ برای ریپلای، کارت‌ها ======================= */
document.addEventListener('click', e => { if (e.target.closest('button,.btn,label.btn,.sitem,.ic,.mc,.row,.charm')) navigator.vibrate?.(10); }, true);
(function () {
  const el = $('msgs'); let sx = 0, sy = 0, box = null, dx = 0, act = false;
  el.addEventListener('touchstart', e => { const t = e.target.closest('.msg'); if (!t || e.touches.length > 1 || e.target.closest('audio')) { box = null; return; } box = t; sx = e.touches[0].clientX; sy = e.touches[0].clientY; dx = 0; act = false; }, { passive: true });
  el.addEventListener('touchmove', e => { if (!box) return; const x = e.touches[0].clientX - sx, y = e.touches[0].clientY - sy; if (!act && Math.abs(y) > Math.abs(x)) { box = null; return; } act = true; dx = Math.max(-80, Math.min(80, x)); box.style.transition = 'none'; box.style.transform = `translateX(${dx}px)`; }, { passive: true });
  el.addEventListener('touchend', () => { if (!box) return; const b = box; box = null; b.style.transition = 'transform .2s'; b.style.transform = ''; if (Math.abs(dx) > 60) { navigator.vibrate?.(15); b.querySelector('.rq')?.click(); } });
})();

/* ======================= v9.2: اتصال محکم‌تر ======================= */
async function reconnectNow() { try { await disableNetwork(db); await enableNetwork(db); } catch (e) {} }
setInterval(() => { if (me && navigator.onLine && !$('net').classList.contains('hidden')) reconnectNow(); }, 15000);
window.addEventListener('online', () => { reconnectNow(); });
document.addEventListener('visibilitychange', () => { if (!document.hidden && me && !$('net').classList.contains('hidden')) reconnectNow(); });
if ('serviceWorker' in navigator && location.protocol === 'https:') navigator.serviceWorker.register('sw.js', { updateViaCache: 'none' }).then(r => r.update()).catch(() => {});

/* ======================= v10: بازی کوییز (فایربیس، بدون سرور) =======================
