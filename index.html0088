/*QZ-PURE-START*/
const qzShuffle = a => { a = [...a]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
const qzFlag = c => String.fromCodePoint(...[...c].map(x => 127397 + x.charCodeAt(0)));
/* امتیاز بر اساس سرعت: تا ۵ ثانیه ۱۰ ، تا ۱۰ ثانیه ۷ ، تا ۲۰ ثانیه ۵ ، بعدش ۰ */
const qzPts = el => (el <= 5 ? 10 : el <= 10 ? 7 : el <= QZ_DUR ? 5 : 0);

