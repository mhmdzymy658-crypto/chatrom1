  const co = [['IR','ایران','تهران'],['TR','ترکیه','آنکارا'],['IT','ایتالیا','رم'],['FR','فرانسه','پاریس'],['DE','آلمان','برلین'],['ES','اسپانیا','مادرید'],['GB','بریتانیا','لندن'],['JP','ژاپن','توکیو'],['CN','چین','پکن'],['IN','هند','دهلی‌نو'],['RU','روسیه','مسکو'],['BR','برزیل','برازیلیا'],['AR','آرژانتین','بوئنوس‌آیرس'],['CA','کانادا','اتاوا'],['AU','استرالیا','کانبرا'],['EG','مصر','قاهره'],['SA','عربستان','ریاض'],['AE','امارات','ابوظبی'],['IQ','عراق','بغداد'],['AF','افغانستان','کابل'],['PK','پاکستان','اسلام‌آباد'],['KR','کره‌جنوبی','سئول'],['MX','مکزیک','مکزیکوسیتی'],['CH','سوئیس','برن'],['NL','هلند','آمستردام'],['PT','پرتغال','لیسبون'],['GR','یونان','آتن'],['SE','سوئد','استکهلم'],['NO','نروژ','اسلو'],['ZA','آفریقای‌جنوبی','پرتوریا'],['TH','تایلند','بانکوک'],['ID','اندونزی','جاکارتا'],['MA','مراکش','رباط'],['QA','قطر','دوحه'],['UZ','ازبکستان','تاشکند'],['AZ','آذربایجان','باکو'],['AM','ارمنستان','ایروان']];
