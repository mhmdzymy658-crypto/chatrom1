    cq.push({ a: n, clue: '', ask: `«${cap}» پایتخت کدام کشور است؟`, big: '🏙️' });
  });
  return { football: mk(fb, 'این بازیکن کیست؟', '⚽'), cinema: mk(ci, 'این بازیگر کیست؟', '🎬'), countries: { pool: co.map(c => c[1]), q: cq } };
})();

/* ساخت یک سوال تازه (تکراری نمی‌شه) */
function qzMakeQ(cat, used) {
  const b = QZ_BANK[cat]; let ids = b.q.map((_, i) => i).filter(i => !used.includes(i));
  if (!ids.length) { ids = b.q.map((_, i) => i); used = []; }
  const id = ids[Math.floor(Math.random() * ids.length)], it = b.q[id];
  const options = qzShuffle([it.a, ...qzShuffle(b.pool.filter(x => x !== it.a)).slice(0, 3)]);
  return { used: [...used, id], q: { question: it.ask, clue: it.clue, big: it.big, options, correctIndex: options.indexOf(it.a) } };
}
const qzActive = g => g.players.filter(u => !g.eliminated?.[u] && !g.left?.[u]);

/* رتبه‌بندی: کلاسیک = امتیاز، بعد مجموع زمان کمتر ؛ حذفی = زنده‌ها اول، بعد دیرتر حذف‌شده */
function qzRank(g) {
  const sc = u => g.scores?.[u] || 0, tt = u => g.tt?.[u] ?? 9999, alive = u => !g.eliminated?.[u] && !g.left?.[u];
  return [...g.players].sort((a, b) => {
    if (g.mode === 'knockout') {
      const x = alive(a), y = alive(b); if (x !== y) return x ? -1 : 1;
      if (!x) { const ea = g.elimR?.[a] || 0, eb = g.elimR?.[b] || 0; if (ea !== eb) return eb - ea; }
    }
    return sc(b) - sc(a) || tt(a) - tt(b);
  });
}
/* پایان سوال: محاسبه‌ی امتیاز و حذف‌ها */
function qzResolve(g) {
  const act = qzActive(g), scores = { ...g.scores }, tt = { ...(g.tt || {}) }, gains = {}, eliminated = { ...(g.eliminated || {}) }, elimR = { ...(g.elimR || {}) };
  const okOf = u => { const a = g.answers?.[u]; return !!(a && a.correct && a.elapsed <= QZ_DUR + 0.7); };
  act.forEach(u => {
    const ok = okOf(u), p = ok ? qzPts(g.answers[u].elapsed) : 0;
    gains[u] = p; scores[u] = (scores[u] || 0) + p;
    if (ok) tt[u] = Math.round(((tt[u] || 0) + g.answers[u].elapsed) * 100) / 100;
  });
  const out = [];
  if (g.mode === 'knockout') {
    const bad = act.filter(u => !okOf(u));
    if (bad.length < act.length) bad.forEach(u => { eliminated[u] = true; elimR[u] = g.round; out.push(u); }); // اگه همه غلط بزنن کسی حذف نمی‌شه
  }
  return { phase: 'reveal', phaseAt: serverTimestamp(), seq: g.seq + 1, scores, tt, gains, eliminated, elimR, lastOut: out };
}
const qzFinishFields = g => ({ status: 'finished', phase: 'done', phaseAt: serverTimestamp(), seq: g.seq + 1, winner: qzRank(g)[0] || null, finishedAt: Date.now() });
/* بعد از نمایش جواب: سوال بعد یا پایان */
function qzNextFields(g) {
  const act = qzActive(g);
  const last = g.round >= g.total || act.length === 0 || (g.mode === 'knockout' && act.length <= 1);
  if (last) return qzFinishFields(g);
  const nq = qzMakeQ(g.category, g.used || []);
  return { round: g.round + 1, phase: 'question', phaseAt: serverTimestamp(), seq: g.seq + 1, currentQ: nq.q, used: nq.used, answers: {}, gains: {}, lastOut: [] };
}
/*QZ-PURE-END*/

/* ---- وضعیت محلی ---- */
let qzView = 'hub', qzG = null, qzUnsub = null, qzRoomsUnsub = null, qzTimer = null, qzOff = 0;
let qzDomKey = '', qzPend = null, qzAdv = { seq: -1, at: 0 }, qzCat = 'football', qzClaimedId = '', qzFxId = '';
const qzRef = id => doc(db, 'games', 'quiz', 'rooms', id);
const qzCol = () => collection(db, 'games', 'quiz', 'rooms');
const qzU = (u, g) => users[u] || { uid: u, name: g?.playerNames?.[u] || '؟' };
const qzAv = (u, g) => `<span class="qz-av">${avatarHtml(qzU(u, g))}</span>`;
const qzNm = (u, g) => esc(qzU(u, g).name || '؟');
const qzPhaseMs = g => g.phaseAt?.toMillis?.() ?? Date.now() + qzOff;

/* هماهنگی ساعت گوشی با ساعت سرور فایربیس */
async function qzClockSync() {
  try {
    const ref = doc(db, 'games', 'quiz', 'clock', me.uid), t0 = Date.now();
    await Promise.race([setDoc(ref, { t: serverTimestamp() }), new Promise((_, no) => setTimeout(() => no('t'), 6000))]);
    const sn = await SDK_.firestore.getDocFromServer(ref), t1 = Date.now();
    qzOff = Math.round(sn.data().t.toMillis() - (t0 + t1) / 2);
  } catch (e) { /* با ساعت خود گوشی ادامه می‌دیم */ }
}

/* ---- عملیات اتاق ---- */
async function qzCreate(mode, cat) {
  const M = QZ_MODES[mode];
  for (let t = 0; t < 8; t++) {
    const id = String(Math.floor(100000 + Math.random() * 900000)), ref = qzRef(id);
    try {
      await runTransaction(db, async tx => {
        const sn = await tx.get(ref);
        if (sn.exists() && Date.now() - (sn.data().createdAt || 0) < 3 * 3600 * 1000) throw 'exists';
        tx.set(ref, { mode, category: cat, host: me.uid, players: [me.uid], playerNames: { [me.uid]: me.name }, status: 'waiting', round: 0, total: M.rounds, max: M.max,
          phase: 'lobby', seq: 1, scores: {}, tt: {}, eliminated: {}, elimR: {}, left: {}, answers: {}, gains: {}, lastOut: [], used: [], winner: null, claimed: {}, createdAt: Date.now() });
      });
      return id;
    } catch (e) { if (e !== 'exists') throw e; }
  }
  throw 'busy';
}
async function qzJoin(id) {
  await runTransaction(db, async tx => {
    const ref = qzRef(id), sn = await tx.get(ref);
    if (!sn.exists()) throw 'gone';
    const g = sn.data();
    if (g.players.includes(me.uid)) return;
    if (g.status !== 'waiting') throw 'started';
    if (g.players.length >= g.max) throw 'full';
    tx.update(ref, { players: [...g.players, me.uid], ['playerNames.' + me.uid]: me.name, seq: g.seq + 1 });
  });
}
async function qzFindMine() {
  const sn = await getDocs(query(qzCol(), where('players', 'array-contains', me.uid))), now = Date.now();
  return sn.docs.map(d => ({ id: d.id, ...d.data() })).filter(g => !g.left?.[me.uid] && ((g.status === 'waiting' && now - g.createdAt < 20 * 60000) || (g.status === 'playing' && now - g.createdAt < 60 * 60000)))
    .sort((a, b) => b.createdAt - a.createdAt)[0] || null;
}
async function qzQuick(mode, cat) {
  try {
    const mine = await qzFindMine(); if (mine) return qzOpen(mine.id);
    const sn = await getDocs(query(qzCol(), where('status', '==', 'waiting')));
    const list = sn.docs.filter(d => { const g = d.data(); return g.mode === mode && g.category === cat && g.players.length < g.max && Date.now() - g.createdAt < 20 * 60000; })
      .sort((a, b) => b.data().players.length - a.data().players.length);
    for (const d of list) { try { await qzJoin(d.id); return qzOpen(d.id); } catch (e) { /* بعدی */ } }
    qzOpen(await qzCreate(mode, cat));
  } catch (e) { toast('اتصال برقرار نیست. دوباره امتحان کن.'); }
}
async function qzJoinCode(code) {
  code = String(code || '').replace(/\D/g, '');
  if (code.length !== 6) return toast('کد اتاق ۶ رقمی است');
  try { await qzJoin(code); qzOpen(code); }
  catch (e) { toast(e === 'gone' ? 'اتاقی با این کد نیست' : e === 'full' ? 'اتاق پر است' : e === 'started' ? 'بازی شروع شده' : 'ورود نشد'); }
}
async function qzStart() {
  try {
    await qzLoadCustom();
    await runTransaction(db, async tx => {
      const ref = qzRef(qzG.id), sn = await tx.get(ref), g = sn.data();
      if (g.status !== 'waiting' || g.host !== me.uid || g.players.length < 2) throw 'no';
      const scores = {}; g.players.forEach(u => { scores[u] = 0; });
      const nq = qzMakeQ(g.category, []);
      tx.update(ref, { status: 'playing', round: 1, phase: 'question', phaseAt: serverTimestamp(), seq: g.seq + 1, scores, currentQ: nq.q, used: nq.used, answers: {}, gains: {} });
    });
  } catch (e) { toast('شروع نشد'); }
}
async function qzLeave() {
  const g = qzG; qzStopSub(); qzHub(); if (!g) return;
  try {
    await runTransaction(db, async tx => {
      const ref = qzRef(g.id), sn = await tx.get(ref); if (!sn.exists()) return;
      const d = sn.data(); if (!d.players.includes(me.uid)) return;
      if (d.status === 'waiting') {
        const players = d.players.filter(u => u !== me.uid);
        if (!players.length) tx.delete(ref); else tx.update(ref, { players, host: d.host === me.uid ? players[0] : d.host, seq: d.seq + 1 });
      } else if (d.status === 'playing') {
        const left = { ...(d.left || {}), [me.uid]: true }, upd = { left };
        const act = d.players.filter(u => !d.eliminated?.[u] && !left[u]);
        if (act.length === 0 || (d.mode === 'knockout' && act.length <= 1)) Object.assign(upd, qzFinishFields({ ...d, left }));
        tx.update(ref, upd);
      }
    });
  } catch (e) { /* بی‌صدا */ }
}
/* ثبت جواب (همه‌چیز داخل تراکنش چک می‌شه؛ اگه همه جواب دادن همون‌جا سوال تموم می‌شه) */
async function qzAnswer(idx) {
  const g0 = qzG; if (!g0 || g0.phase !== 'question' || g0.answers?.[me.uid] || qzPend != null) return;
  if (g0.eliminated?.[me.uid] || g0.left?.[me.uid]) return;
  const elapsed = Math.max(0, Math.round((Date.now() + qzOff - qzPhaseMs(g0)) / 10) / 100);
  if (elapsed > QZ_DUR + 0.5) return toast('دیر شد!');
  qzPend = idx; const ok = idx === g0.currentQ.correctIndex;
  navigator.vibrate?.(ok ? 25 : [70, 40, 70]); qzUpdateGame(g0);
  try {
    await runTransaction(db, async tx => {
      const ref = qzRef(g0.id), sn = await tx.get(ref), g = sn.data();
      if (g.status !== 'playing' || g.phase !== 'question' || g.round !== g0.round) throw 'late';
      if (g.eliminated?.[me.uid] || g.left?.[me.uid] || g.answers?.[me.uid]) throw 'dup';
      const t = g.phaseAt?.toMillis?.(); if (t && (Date.now() + qzOff - t) / 1000 > QZ_DUR + 0.8) throw 'late';
      const ans = { optionIndex: idx, correct: idx === g.currentQ.correctIndex, elapsed };
      const upd = { ['answers.' + me.uid]: ans }, merged = { ...g, answers: { ...(g.answers || {}), [me.uid]: ans } };
      if (qzActive(g).every(u => merged.answers[u])) Object.assign(upd, qzResolve(merged));
      tx.update(ref, upd);
    });
  } catch (e) { if (e !== 'dup') { qzPend = null; if (qzG) qzUpdateGame(qzG); toast(e === 'late' ? 'دیر شد!' : 'جواب ثبت نشد'); } }
}
/* رفتن به مرحله‌ی بعد وقتی زمان تموم شد (هر بازیکنی می‌تونه؛ تراکنش جلوی تکرار رو می‌گیره) */
async function qzAdvance(expSeq) {
  const id = qzG?.id; if (!id) return;
  await runTransaction(db, async tx => {
    const ref = qzRef(id), sn = await tx.get(ref); if (!sn.exists()) return; const g = sn.data();
    if (g.seq !== expSeq || g.status !== 'playing') return;
    const t = g.phaseAt?.toMillis?.(); if (!t) return;
    const dur = (g.phase === 'question' ? QZ_DUR : QZ_REVEAL) * 1000;
    if (Date.now() + qzOff < t + dur - 300) return;
    tx.update(ref, g.phase === 'question' ? qzResolve(g) : qzNextFields(g));
  });
}
/* جایزه و آمار (برای هر بازیکن یک بار) */
async function qzClaim(g) {
  if (!g.players.includes(me.uid) || g.claimed?.[me.uid]) return;
  const win = qzRank(g)[0] === me.uid, M = QZ_MODES[g.mode];
  try {
    await runTransaction(db, async tx => {
      const ref = qzRef(g.id), sn = await tx.get(ref); if (sn.data().claimed?.[me.uid]) return;
      tx.update(ref, { ['claimed.' + me.uid]: true });
      const sc = g.scores?.[me.uid] || 0, rk = qzRank(g), cat = g.category, pre = 'qz.' + cat + '.';
      tx.update(doc(db, 'users', me.uid), {
        quizPts: increment(sc), quizWins: increment(win ? 1 : 0), quizGames: increment(1),
        [pre + 'pts']: increment(sc), [pre + 'wins']: increment(win ? 1 : 0), [pre + 'games']: increment(1),
        [pre + 'last']: { at: Date.now(), mode: g.mode, rank: rk.indexOf(me.uid) + 1, players: g.players.length, score: sc, win },
        ...(win ? { bonus: increment(M.coin) } : {})
      });
    });
  } catch (e) { /* بی‌صدا */ }
}

/* ---- اشتراک اتاق ---- */
function qzStopSub() { qzUnsub?.(); qzUnsub = null; clearInterval(qzTimer); qzTimer = null; qzG = null; qzDomKey = ''; qzPend = null; }
function qzStop() { qzStopSub(); qzRoomsUnsub?.(); qzRoomsUnsub = null; $('qz')?.classList.add('hidden'); qzView = 'hub'; }
function qzOpen(id) {
  $('qzBody').onclick = null; qzStopSub(); qzRoomsUnsub?.(); qzRoomsUnsub = null; qzView = 'game';
  $('qz').classList.remove('hidden'); $('qzBody').innerHTML = '<p class="empty" style="padding:40px">در حال ورود…</p>';
  qzUnsub = onSnapshot(qzRef(id), sn => {
    if (!sn.exists()) { toast('اتاق بسته شد'); return qzHub(); }
    qzG = { id, ...sn.data({ serverTimestamps: 'estimate' }) }; qzRender();
  }, () => toast('اتصال به بازی قطع شد'));
  qzTimer = setInterval(qzTick, 150);
}

/* ---- صفحه‌ها ---- */
function qzHub() {
  qzLoadCustom();
  qzStopSub(); qzRoomsUnsub?.(); qzRoomsUnsub = null; qzView = 'hub';
  $('qzTitle').textContent = '🎮 بازی‌ها'; $('qzCoins').textContent = '🪙 ' + fa(coinsOf(me));
  $('qzBody').innerHTML = `<div id="qzResume"></div>
    <button class="qz-hc" data-go="classic"><span class="ic">🎨</span><span><b>کلاسیک (۴ نفره)</b><small>۱۰ سوال • ۲۰ ثانیه • هر چه سریع‌تر، امتیاز بیشتر</small></span><span class="ar">‹</span></button>
    <button class="qz-hc" data-go="knockout"><span class="ic">⚔️</span><span><b>حذفی (۶ نفره)</b><small>غلط بزنی از بازی حذف می‌شی!</small></span><span class="ar">‹</span></button>
    <button class="qz-hc" data-go="board"><span class="ic">🏆</span><span><b>برترین‌ها</b><small>بهترین بازیکن‌های کوییز</small></span><span class="ar">‹</span></button>
    <button class="btn ghost" id="qzRules" style="margin-top:4px">؟ قوانین و امتیازدهی</button>`;
  $('qzBody').onclick = e => { const b = e.target.closest('[data-go]'); if (!b) return; b.dataset.go === 'board' ? qzBoard() : qzSetup(b.dataset.go); };
  $('qzRules').onclick = qzRules;
  qzFindMine().then(g => { const el = $('qzResume'); if (el && g && qzView === 'hub') { el.innerHTML = `<button class="btn" id="qzCont" style="margin-bottom:12px">▶ ادامه‌ی بازی (${g.status === 'waiting' ? 'در انتظار بازیکن' : 'در جریان'})</button>`; $('qzCont').onclick = () => qzOpen(g.id); } }).catch(() => {});
}
function qzRules() {
  openModal(`<h3>🎮 قوانین کوییز</h3><div style="text-align:start;line-height:2;font-size:.92rem">
    • سه دسته: ⚽ فوتبالیست‌ها، 🎬 بازیگران سینما، 🌍 کشورها.<br>
    • <b>کلاسیک</b> (تا ۴ نفر): ۱۰ سوال؛ هر سوال ۲۰ ثانیه. بیشترین امتیاز برنده است.<br>
    • <b>حذفی</b> (تا ۶ نفر): هر کس غلط بزند یا جواب ندهد حذف می‌شود؛ آخرین نفر برنده است.<br>
    • امتیاز جواب درست: ۱ تا ۵ ثانیه ← ۱۰ ، تا ۱۰ ثانیه ← ۷ ، تا ۲۰ ثانیه ← ۵ ، غلط یا دیر ← ۰.<br>
    • برنده سکه می‌گیرد 🪙 و امتیازها وارد «برترین‌ها» می‌شود.<br>
    • برای ورود دوستان، «کد اتاق ۶ رقمی» را برایشان بفرست.
    </div><div class="acts2"><button class="btn" id="mClose">باشه</button></div>`);
  $('mClose').onclick = closeModal;
}
function qzSetup(mode) {
  $('qzBody').onclick = null; qzView = 'setup'; const M = QZ_MODES[mode];
  $('qzTitle').textContent = `${M.ic} ${M.n} (${fa(M.max)} نفره)`;
  $('qzBody').innerHTML = `<div class="sec-t">دسته‌ی سوال‌ها</div>
    <div class="qz-cats">${Object.entries(QZ_CATS).map(([k, c]) => `<button class="qz-cat ${k === qzCat ? 'on' : ''}" data-cat="${k}"><span>${c.ic}</span>${c.n}</button>`).join('')}</div>
    <div class="qz-btns"><button class="btn full" id="qzQuick">▶ بازی سریع</button><button class="btn ghost" id="qzNew">➕ ساخت اتاق</button><button class="btn ghost" id="qzHow">؟ قوانین</button></div>
    <div class="sec-t">ورود با کد اتاق</div>
    <div class="qz-codein"><input id="qzCode" inputmode="numeric" maxlength="6" placeholder="••••••"><button class="btn" id="qzGo">ورود</button></div>
    <div class="sec-t">اتاق‌های باز</div><div id="qzRooms"><p class="empty" style="padding:14px">اتاق بازی نیست. یکی بساز!</p></div>`;
  const cats = () => document.querySelectorAll('.qz-cat').forEach(b => b.classList.toggle('on', b.dataset.cat === qzCat));
  document.querySelectorAll('.qz-cat').forEach(b => b.onclick = () => { qzCat = b.dataset.cat; cats(); });
  $('qzQuick').onclick = () => qzQuick(mode, qzCat);
  $('qzNew').onclick = async () => { try { const mine = await qzFindMine(); qzOpen(mine ? mine.id : await qzCreate(mode, qzCat)); } catch (e) { toast('اتاق ساخته نشد'); } };
  $('qzHow').onclick = qzRules; $('qzGo').onclick = () => qzJoinCode($('qzCode').value);
  $('qzRooms').onclick = e => { const b = e.target.closest('[data-join]'); if (b) qzJoinCode(b.dataset.join); };
  qzRoomsUnsub?.();
  qzRoomsUnsub = onSnapshot(query(qzCol(), where('status', '==', 'waiting')), sn => {
    const el = $('qzRooms'); if (!el || qzView !== 'setup') return;
    const list = sn.docs.map(d => ({ id: d.id, ...d.data() })).filter(g => g.mode === mode && g.players.length < g.max && Date.now() - g.createdAt < 20 * 60000);
    el.innerHTML = list.length ? list.map(g => `<div class="qz-row">${qzAv(g.host, g)}<div class="nm"><b>اتاق ${qzNm(g.host, g)}</b><small>${QZ_CATS[g.category].ic} ${QZ_CATS[g.category].n} • ${fa(g.players.length)} از ${fa(g.max)} نفر</small></div><button class="btn" data-join="${g.id}">ورود</button></div>`).join('')
      : '<p class="empty" style="padding:14px">اتاق بازی نیست. یکی بساز!</p>';
  }, () => {});
}
let qzBoardCat = 'all';
function qzBoard(cat) {
  if (cat) qzBoardCat = cat; cat = qzBoardCat;
  qzView = 'board'; $('qzTitle').textContent = '🏆 برترین‌ها';
  const val = u => cat === 'all' ? (u.quizPts || 0) : (u.qz?.[cat]?.pts || 0);
  const wins = u => cat === 'all' ? (u.quizWins || 0) : (u.qz?.[cat]?.wins || 0);
  const gms = u => cat === 'all' ? (u.quizGames || 0) : (u.qz?.[cat]?.games || 0);
  const list = Object.values(users).filter(u => val(u) > 0).sort((a, b) => val(b) - val(a)).slice(0, 20), md = ['🥇', '🥈', '🥉'];
  const tabs = [['all', '🏆', 'همه'], ...Object.entries(QZ_CATS).map(([k, c]) => [k, c.ic, c.n])];
  $('qzBody').innerHTML = `<div class="qz-cats">${tabs.map(([k, ic, n]) => `<button class="qz-cat ${k === cat ? 'on' : ''}" data-bc="${k}"><span>${ic}</span>${n}</button>`).join('')}</div>
    <div class="sec-t">برای دیدن پروفایل، روی کاربر بزن</div>` +
    (list.length ? list.map((u, i) => `<button class="qz-rk ${u.uid === me.uid ? 'me' : ''}" data-uid="${u.uid}"><span class="md">${md[i] || fa(i + 1)}</span>${qzAv(u.uid, null)}<b>${esc(u.name || '؟')}<br><small style="color:#9a9078;font-weight:400">${hid(u)} • ${fa(wins(u))} برد از ${fa(gms(u))} بازی</small></b><i>${fa(val(u))}</i></button>`).join('')
      : '<p class="empty" style="padding:40px">هنوز کسی این بازی را نکرده. اولین نفر باش! 🏆</p>');
  $('qzBody').onclick = e => {
    const bc = e.target.closest('[data-bc]'); if (bc) return qzBoard(bc.dataset.bc);
    const r = e.target.closest('[data-uid]'); if (r) showProfile(r.dataset.uid);   // پروفایل روی همین صفحه باز می‌شود
  };
}
function qzRender() {
  const g = qzG; if (!g || qzView !== 'game') return;
  if (!g.players.includes(me.uid)) { toast('از این اتاق خارج شدی'); qzStopSub(); return qzHub(); }
  if (g.status === 'waiting') { qzDomKey = ''; return qzLobby(g); }
  if (g.status === 'finished') { qzDomKey = ''; return qzEnd(g); }
  const key = g.id + ':' + g.round;
  if (qzDomKey !== key) { qzDomKey = key; qzPend = null; qzBuildGame(g); }
  qzUpdateGame(g);
}
function qzLobby(g) {
  const M = QZ_MODES[g.mode], C = QZ_CATS[g.category];
  $('qzTitle').textContent = `${M.ic} ${M.n} • ${C.ic}`;
  const slots = Array.from({ length: g.max }, (_, i) => { const u = g.players[i];
    return u ? `<div class="qz-slot">${qzAv(u, g)}<b>${qzNm(u, g)}</b>${u === g.host ? '<small>👑 میزبان</small>' : ''}</div>` : '<div class="qz-slot empty"><span style="font-size:1.5rem">⏳</span><small>منتظر بازیکن…</small></div>'; }).join('');
  $('qzBody').innerHTML = `<div class="qz-info">کد اتاق رو برای دوستات بفرست</div><div class="qz-code">${g.id}</div>
    <div class="qz-btns"><button class="btn ghost" id="qzCopy">📋 کپی کد</button><button class="btn ghost" id="qzShare">📤 ارسال</button></div>
    <div class="qz-cnt"><b>${fa(g.players.length)}</b> از ${fa(g.max)} نفر</div><div class="qz-slots">${slots}</div>
    ${g.host === me.uid ? `<button class="btn" id="qzStartB" style="margin-bottom:8px" ${g.players.length < 2 ? 'disabled' : ''}>▶ شروع بازی</button>` : '<div class="qz-info">منتظر شروع بازی توسط میزبان…</div>'}
    <button class="btn ghost" id="qzOut">خروج</button>`;
  $('qzCopy').onclick = () => { navigator.clipboard?.writeText(g.id).then(() => toast('کد کپی شد'), () => toast(g.id)); };
  $('qzShare').onclick = () => { const t = `بیا کوییز بازی کنیم! کد اتاق: ${g.id}`; if (navigator.share) navigator.share({ text: t }).catch(() => {}); else navigator.clipboard?.writeText(t).then(() => toast('متن دعوت کپی شد')); };
  $('qzStartB')?.addEventListener('click', qzStart); $('qzOut').onclick = qzLeave;
}
function qzBuildGame(g) {
  const M = QZ_MODES[g.mode], C = QZ_CATS[g.category], q = g.currentQ;
  $('qzTitle').textContent = `${M.ic} ${M.n}`;
  $('qzBody').innerHTML = `<div class="qz-top"><div class="qz-chips"><span>${M.ic} ${M.n}</span><span>${C.ic} ${C.n}</span></div><div class="qz-rd">سوال <b>${fa(g.round)}</b>${g.mode === 'classic' ? ' از ' + fa(g.total) : ''}</div></div>
    <div class="qz-mid"><div class="qz-ring"><svg width="76" height="76" viewBox="0 0 76 76"><circle class="bg" cx="38" cy="38" r="34" fill="none" stroke-width="6"/><circle class="fg" id="qzFg" cx="38" cy="38" r="34" fill="none" stroke-width="6" stroke-dasharray="213.6" stroke-dashoffset="0"/></svg><b id="qzT"></b></div>
      <div class="qz-q">${q.big ? `<div class="qz-big">${q.big}</div>` : ''}${q.clue ? `<div class="qz-clue">${esc(q.clue)}</div>` : ''}<div class="qz-ask">${esc(q.question)}</div></div></div>
    <div class="qz-opts" id="qzOpts">${q.options.map((o, i) => `<button class="qz-opt" data-i="${i}"><i>${QZ_LET[i]}</i><span>${esc(o)}</span></button>`).join('')}</div>
    <div class="qz-note" id="qzNote"></div><div class="sec-t">بازیکن‌ها</div><div class="qz-pl" id="qzPl"></div>`;
  $('qzOpts').onclick = e => { const b = e.target.closest('[data-i]'); if (b && !b.disabled) qzAnswer(+b.dataset.i); };
}
function qzUpdateGame(g) {
  const q = g.currentQ, my = g.answers?.[me.uid], sel = my ? my.optionIndex : qzPend, out = !!g.eliminated?.[me.uid], gone = !!g.left?.[me.uid], reveal = g.phase === 'reveal';
  document.querySelectorAll('#qzOpts .qz-opt').forEach((b, i) => {
    let c = 'qz-opt';
    if (reveal) c += i === q.correctIndex ? ' ok' : i === sel ? ' bad' : ' dim';
    else if (sel != null) c += i === sel ? (i === q.correctIndex ? ' ok' : ' bad') : ' dim';
    b.className = c; b.disabled = reveal || sel != null || out || gone;
  });
  const note = $('qzNote');
  if (note) {
    if (out) note.textContent = '💀 حذف شدی؛ بقیه‌ی بازی رو تماشا کن';
    else if (reveal) { const gn = g.gains?.[me.uid] || 0, names = (g.lastOut || []).map(u => qzU(u, g).name).join('، ');
      note.textContent = (gn ? `🎯 +${fa(gn)} امتیاز` : 'این دور امتیازی نگرفتی') + (names ? ` • ❌ حذف: ${names}` : ''); }
    else if (sel != null) note.textContent = 'جوابت ثبت شد ✓ منتظر بقیه…';
    else note.textContent = 'سریع‌تر جواب بدی، امتیاز بیشتر! ⚡';
  }
  const live = u => (g.scores?.[u] || 0) + (u === me.uid && g.phase === 'question' && my?.correct && my.elapsed <= QZ_DUR + 0.5 ? qzPts(my.elapsed) : 0);
  const order = [...g.players].sort((a, b) => live(b) - live(a));
  const pl = $('qzPl'); if (!pl) return;
  pl.innerHTML = order.map(u => {
    const o = g.eliminated?.[u], l = g.left?.[u], a = g.answers?.[u]; let st = '';
    if (o) st = '<span class="st r">💀</span>'; else if (l) st = '<span class="st r">🚪</span>';
    else if (reveal) { const p = g.gains?.[u] || 0; st = p ? `<span class="st g">+${fa(p)}</span>` : `<span class="st r">${a ? '✖' : '—'}</span>`; }
    else st = `<span class="st">${a ? '✅' : '⏳'}</span>`;
    return `<div class="qz-p ${u === me.uid ? 'me' : ''} ${o || l ? 'out' : ''}">${qzAv(u, g)}<b>${qzNm(u, g)}</b>${st}<i>${fa(live(u))}</i></div>`;
  }).join('');
}
function qzEnd(g) {
  const rank = qzRank(g), w = rank[0], M = QZ_MODES[g.mode], win = w === me.uid, md = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣', '6️⃣'];
  $('qzTitle').textContent = '🏁 پایان بازی';
  $('qzBody').innerHTML = `<div class="qz-win"><span class="qz-crown">👑</span>${qzAv(w, g)}<b>${qzNm(w, g)}</b><small>${fa(g.scores?.[w] || 0)} امتیاز • برنده‌ی بازی!</small></div>
    ${win ? `<div class="qz-info" style="color:#f5d77a;font-weight:800">🎉 تبریک! 🪙 +${fa(M.coin)} سکه جایزه</div>` : ''}
    ${rank.map((u, i) => `<div class="qz-rk ${u === me.uid ? 'me' : ''}"><span class="md">${md[i] || ''}</span>${qzAv(u, g)}<b>${qzNm(u, g)}</b><i>${fa(g.scores?.[u] || 0)}</i></div>`).join('')}
    <div class="qz-btns" style="margin-top:14px"><button class="btn full" id="qzAgain">🔁 بازی دوباره</button><button class="btn ghost full" id="qzBack">بازگشت به بازی‌ها</button></div>`;
  $('qzAgain').onclick = () => { const m = g.mode; qzStopSub(); qzSetup(m); };
  $('qzBack').onclick = () => { qzStopSub(); qzHub(); };
  if (qzFxId !== g.id) { qzFxId = g.id; qzFx(); navigator.vibrate?.(win ? [60, 40, 60, 40, 120] : 30); }
  if (qzClaimedId !== g.id) { qzClaimedId = g.id; qzClaim(g); }
}
/* فشفشه و کاغذرنگی */
function qzFx() {
  const box = document.createElement('div'); box.className = 'qz-fx'; document.body.appendChild(box);
  const cols = ['#f5d77a', '#d4af37', '#ffffff', '#2fd18b', '#e5484d', '#7cc4ff'];
  for (let b = 0; b < 6; b++) setTimeout(() => {
    const cx = 15 + Math.random() * 70, cy = 12 + Math.random() * 38;
    for (let i = 0; i < 20; i++) { const p = document.createElement('i'), a = i / 20 * Math.PI * 2, d = 60 + Math.random() * 70;
      p.style.cssText = `left:${cx}%;top:${cy}%;background:${cols[(Math.random() * cols.length) | 0]};--dx:${Math.cos(a) * d}px;--dy:${Math.sin(a) * d}px`; box.appendChild(p); }
  }, b * 420);
  for (let i = 0; i < 46; i++) { const c = document.createElement('s');
    c.style.cssText = `left:${Math.random() * 100}%;background:${cols[(Math.random() * cols.length) | 0]};animation-duration:${2.4 + Math.random() * 2}s;animation-delay:${Math.random() * 1.2}s`; box.appendChild(c); }
  setTimeout(() => box.remove(), 6200);
}
/* تایمر دایره‌ای + رفتن خودکار به مرحله‌ی بعد */
function qzTick() {
  const g = qzG; if (!g || g.status !== 'playing' || qzView !== 'game') return;
  const t = qzPhaseMs(g), q = g.phase === 'question', dur = (q ? QZ_DUR : QZ_REVEAL) * 1000, now = Date.now() + qzOff, left = Math.max(0, t + dur - now), frac = Math.min(1, left / dur);
  const fg = $('qzFg'); if (fg) { fg.style.strokeDashoffset = (213.6 * (1 - frac)).toFixed(1); fg.style.stroke = !q ? '#d4af37' : frac > .6 ? '#2fd18b' : frac > .3 ? '#f5c542' : '#e5484d'; }
  const tt = $('qzT'); if (tt) tt.textContent = q ? fa(Math.ceil(left / 1000)) : '⏭';
  const grace = g.host === me.uid ? 0 : 1300 + (me.uid.charCodeAt(0) % 5) * 350;
  if (now >= t + dur + grace && (qzAdv.seq !== g.seq || Date.now() - qzAdv.at > 3500)) { qzAdv = { seq: g.seq, at: Date.now() }; qzAdvance(g.seq).catch(() => {}); }
}
/* دکمه‌ها */
function qzBack() {
  if (qzView === 'hub') { $('qz').classList.add('hidden'); return; }
  if (qzView === 'setup' || qzView === 'board') return qzHub();
  if (qzView === 'game') { if (qzG?.status === 'playing' && !confirm('اگه بری از بازی حذف می‌شی. مطمئنی؟')) return; qzLeave(); }
}
$('navGames').onclick = () => { $('qz').classList.remove('hidden'); qzClockSync(); if (qzG && qzView === 'game') qzRender(); else qzHub(); };
/* ورود به کوییز از پروفایل */
function qzPlay(cat) { qzCat = cat; $('qz').classList.remove('hidden'); qzClockSync(); if (qzG && qzView === 'game') qzRender(); else qzHub(); }
function qzOpenBoard(cat) {
  if (qzG && qzView === 'game') { $('qz').classList.remove('hidden'); qzRender(); return toast('اول بازی فعلی را تمام کن'); }
  qzStopSub(); qzRoomsUnsub?.(); qzRoomsUnsub = null;
  $('qz').classList.remove('hidden'); qzClockSync(); qzBoard(cat);
}
$('qzX').onclick = qzBack;

/* ======================= v1.4.0: چت، کانال، زمینه‌ها، صدا و موزیک ======================= */
const fmtDur = x => { x = Math.max(0, Math.floor(x || 0)); return fa(Math.floor(x / 60) + ':' + String(x % 60).padStart(2, '0')); };
let lastMsgsHtml = '', unsubChannel = null;

/* ---- دکمه‌ی برگشت گوشی از چت به لیست ---- */
function pushChatState() { if (window.matchMedia('(max-width:760px)').matches && !$('app').classList.contains('chat') && !history.state?.chat) history.pushState({ chat: 1 }, ''); }
window.addEventListener('popstate', () => { if ($('app').classList.contains('chat')) $('app').classList.remove('chat'); });

/* ---- اطلاعیه‌ی خودکار آپدیت در کانال رسمی (فقط کلاینت مدیر؛ هر نسخه فقط یک بار) ---- */
async function autoAnnounce() {
  if (!isAdmin()) return;
  try {
    const ref = doc(db, 'settings', 'release'), snap = await getDoc(ref);
    if (snap.exists() && snap.data().version === CURRENT_VERSION) return;
    const r = await fetch('version.json?t=' + Date.now(), { cache: 'no-store' }), v = await r.json();
    if (!v || v.version !== CURRENT_VERSION) return;
    let won = false;
    await runTransaction(db, async tx => {
      const sn = await tx.get(ref); if (sn.exists() && sn.data().version === v.version) return;
      tx.set(ref, { version: v.version, at: serverTimestamp() }); won = true;
    });
    if (!won) return;
    const notes = String(v.notes || '').split(/[•\n]/).map(x => x.trim()).filter(Boolean);
    await post('channel', { text: `🚀 نسخه‌ی ${fa(v.version)} منتشر شد\n` + (notes.length ? notes.map(n => '• ' + n).join('\n') : 'بهبودها و رفع مشکلات'), release: true });
  } catch (e) { /* بی‌صدا */ }
}

/* ---- زمینه‌های چت (انتخاب + دانلود) ---- */
const WALLS = [
  { k: 'night',  n: 'شب ستاره‌دار', a: '#02030a', b: '#0b1030', g: '160,190,255', p: 2 },
  { k: 'gold',   n: 'طلایی',        a: '#0b0903', b: '#1d1604', g: '212,175,55',  p: 0 },
  { k: 'neon',   n: 'بنفش نئونی',   a: '#12062b', b: '#2a0f5c', g: '139,92,246',  p: 1 },
  { k: 'ocean',  n: 'اقیانوس',      a: '#041420', b: '#0a3350', g: '77,163,255',  p: 0 },
  { k: 'forest', n: 'جنگل',         a: '#03120b', b: '#0b3a22', g: '47,209,139',  p: 1 },
  { k: 'sunset', n: 'غروب',         a: '#1d0a14', b: '#4a1630', g: '255,126,95',  p: 0 },
  { k: 'fire',   n: 'آتش',          a: '#1a0602', b: '#4a1204', g: '245,175,25',  p: 1 },
  { k: 'rose',   n: 'گل‌سرخ',       a: '#1a0710', b: '#471330', g: '255,95,143',  p: 0 },
  { k: 'galaxy', n: 'کهکشان',       a: '#0a0418', b: '#1c0b3a', g: '200,120,255', p: 2 },
  { k: 'mint',   n: 'نعنایی',       a: '#031412', b: '#0a3a36', g: '60,220,200',  p: 1 },
  { k: 'steel',  n: 'فولادی',       a: '#0a0c10', b: '#1b212b', g: '150,170,200', p: 1 },
  { k: 'light',  n: 'روشن',         a: '#f4efe2', b: '#e9dfc4', g: '184,134,11',  p: 0, light: true },
];
function wallCss(w) {
  const pat = w.p === 1 ? 'repeating-linear-gradient(45deg,rgba(255,255,255,.04) 0 1px,transparent 1px 24px),repeating-linear-gradient(-45deg,rgba(255,255,255,.04) 0 1px,transparent 1px 24px),'
    : w.p === 2 ? 'radial-gradient(1.6px 1.6px at 20% 30%,rgba(255,255,255,.8),transparent),radial-gradient(1.2px 1.2px at 70% 60%,rgba(255,255,255,.7),transparent),radial-gradient(1.6px 1.6px at 40% 82%,rgba(255,255,255,.6),transparent),radial-gradient(1.2px 1.2px at 88% 18%,rgba(255,255,255,.8),transparent),radial-gradient(1px 1px at 55% 10%,rgba(255,255,255,.6),transparent),' : '';
  return `${pat}radial-gradient(700px 420px at 50% 105%,rgba(${w.g},${w.light ? .22 : .38}),transparent 70%),linear-gradient(180deg,${w.a},${w.b})`;
}
const wallRaw = id => {
  for (const k of ['wall_' + id, roomType(id) === 'dm' ? 'wall_dm' : 'wall_room', 'wall']) {
    const v = localStorage.getItem(k);
    if (v) { if (v[0] === '{') { try { return JSON.parse(v); } catch (e) { /* بعدی */ } } else return { k: v }; }
  }
  return { k: 'night' };
};
const wallCssOf = w => w.img ? `linear-gradient(rgba(0,0,0,.4),rgba(0,0,0,.55)),url("${w.img}") center/cover no-repeat` : wallCss(WALLS.find(x => x.k === w.k) || WALLS[0]);
function applyWall() { const w = wallRaw(room); $('main').style.setProperty('--wall', wallCssOf(w)); $('main').classList.toggle('wl-light', !w.img && !!WALLS.find(x => x.k === w.k)?.light); }
function wallDownload(w) {
  const c = document.createElement('canvas'); c.width = 1080; c.height = 1920; const x = c.getContext('2d');
  const g = x.createLinearGradient(0, 0, 0, 1920); g.addColorStop(0, w.a); g.addColorStop(1, w.b); x.fillStyle = g; x.fillRect(0, 0, 1080, 1920);
  const r = x.createRadialGradient(540, 2010, 0, 540, 2010, 1100); r.addColorStop(0, `rgba(${w.g},${w.light ? .3 : .5})`); r.addColorStop(1, `rgba(${w.g},0)`); x.fillStyle = r; x.fillRect(0, 0, 1080, 1920);
  if (w.p === 1) { x.strokeStyle = 'rgba(255,255,255,.05)'; x.lineWidth = 2; for (let i = -1920; i < 2000; i += 48) { x.beginPath(); x.moveTo(i, 0); x.lineTo(i + 1920, 1920); x.stroke(); x.beginPath(); x.moveTo(i + 1920, 0); x.lineTo(i, 1920); x.stroke(); } }
  if (w.p === 2) { let sd = 7; const rnd = () => (sd = (sd * 16807) % 2147483647) / 2147483647; for (let i = 0; i < 150; i++) { x.fillStyle = `rgba(255,255,255,${.3 + rnd() * .6})`; x.beginPath(); x.arc(rnd() * 1080, rnd() * 1920, .8 + rnd() * 2, 0, 7); x.fill(); } }
  c.toBlob(b => { const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = 'prochat-' + w.k + '.png'; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 800); toast('⬇ زمینه دانلود شد'); }, 'image/png');
}
function wallModal() {
  let pick = wallRaw(room);
  const draw = () => { $('wlGrid').innerHTML = `<div class="wl up ${pick.img ? 'on' : ''}" data-up="1" ${pick.img ? `style="background:${wallCssOf(pick)}"` : ''}><b>📷 عکس از گالری</b></div>`
    + WALLS.map(w => `<div class="wl ${!pick.img && w.k === pick.k ? 'on' : ''}" data-w="${w.k}" style="background:${wallCss(w)}"><b>${w.n}</b><button class="wl-dl" data-dl="${w.k}" aria-label="دانلود ${w.n}">⬇</button></div>`).join(''); };
  openModal(`<h3>🎨 زمینه‌ی چت</h3><p style="color:var(--mut);font-size:.82rem;margin:2px 0">یک زمینه انتخاب کن یا عکس خودت را از گالری بگذار.</p><div class="wl-grid" id="wlGrid"></div><input type="file" id="wlFile" accept="image/*" class="vh">
    <div class="acts2"><button class="btn" id="wlAll">برای همه‌ی چت‌ها</button><button class="btn ghost" id="wlOne">فقط همین گفتگو</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  draw(); $('mClose').onclick = closeModal;
  $('wlFile').onchange = async e => {
    const f = e.target.files[0]; e.target.value = ''; if (!f) return;
    try { pick = { img: await shrinkImage(f, 960, .62) }; $('main').style.setProperty('--wall', wallCssOf(pick)); draw(); } catch { toast('عکس خوانده نشد'); }
  };
  $('wlGrid').onclick = e => {
    const d = e.target.closest('[data-dl]'); if (d) return wallDownload(WALLS.find(x => x.k === d.dataset.dl));
    if (e.target.closest('[data-up]')) return $('wlFile').click();
    const w = e.target.closest('[data-w]'); if (!w) return; pick = { k: w.dataset.w }; $('main').style.setProperty('--wall', wallCssOf(pick)); draw();
  };
  const save = key => { try { localStorage.setItem(key, JSON.stringify(pick.img ? { img: pick.img } : { k: pick.k })); return true; } catch { toast('حافظه‌ی گوشی پر است؛ عکس کوچک‌تری بگذار'); return false; } };
  $('wlAll').onclick = () => { if (!save('wall')) return; localStorage.removeItem('wall_dm'); localStorage.removeItem('wall_room'); closeModal(); applyWall(); toast('زمینه برای همه‌ی چت‌ها اعمال شد'); };
  $('wlOne').onclick = () => { if (!save('wall_' + room)) return; closeModal(); applyWall(); toast('زمینه‌ی این گفتگو عوض شد'); };
  $('modal').addEventListener('click', applyWall, { once: true });
}
$('btnWall').onclick = wallModal;
$('btnDelChat').onclick = () => deleteChat(room);

/* ---- پخش‌کننده‌ی پیام صوتی/موزیک با نوار موج + نوار «در حال پخش» ---- */
const npA = new Audio(); let npId = null, npMeta = null;
const apBars = id => { let h = 7; for (const c of String(id)) h = (h * 31 + c.charCodeAt(0)) >>> 0; const o = []; for (let i = 0; i < 34; i++) { h = (Math.imul(h, 1103515245) + 12345) >>> 0; o.push(22 + ((h >>> 16) % 78)); } return o; };
const barsHtml = id => apBars(id).map(v => `<i style="height:${v}%"></i>`).join('');
function apHtml(m) {
  return `<div class="ap" data-apid="${m.id}" data-dur="${m.dur || 0}"><button class="apb" data-ap="1" aria-label="پخش">▶</button><div class="apw" data-aw="1">${barsHtml(m.id)}</div><span class="apt">${m.dur ? fmtDur(m.dur) : (m.music ? '🎵' : '🎤')}</span></div>${m.music && m.title ? `<div class="apn">🎵 ${esc(m.title)}</div>` : ''}`;
}
function apToggle(id) {
  const m = msgs.find(x => x.id === id); if (!m?.audio) return;
  if (npId === id) { npA.paused ? npA.play().catch(() => {}) : npA.pause(); return; }
  npA.pause(); npId = id; npMeta = m; npA.src = m.audio;
  $('npW').innerHTML = barsHtml(id); $('np').classList.remove('hidden');
  npA.play().catch(() => toast('پخش نشد')); apSync();
}
function apSeek(id, ratio) {
  if (npId !== id) return apToggle(id);
  const dur = isFinite(npA.duration) && npA.duration > 0 ? npA.duration : (npMeta?.dur || 0);
  if (dur) npA.currentTime = Math.max(0, Math.min(1, ratio)) * dur;
}
function npStop() { npA.pause(); npId = null; npMeta = null; $('np').classList.add('hidden'); apSync(); }
function apSync() {
  const dur = isFinite(npA.duration) && npA.duration > 0 ? npA.duration : (npMeta?.dur || 0), p = dur ? npA.currentTime / dur : 0;
  document.querySelectorAll('.ap').forEach(el => {
    const on = el.dataset.apid === npId; el.querySelector('.apb').textContent = on && !npA.paused ? '⏸' : '▶';
    el.querySelectorAll('.apw i').forEach((b, i, a) => b.classList.toggle('p', on && (i + 1) / a.length <= p + .001));
    const t = el.querySelector('.apt'); if (t && (on || +el.dataset.dur)) t.textContent = on ? fmtDur(npA.currentTime) : fmtDur(+el.dataset.dur);
  });
  if (npId) { $('npT').textContent = fmtDur(npA.currentTime); $('npW').querySelectorAll('i').forEach((b, i, a) => b.classList.toggle('p', (i + 1) / a.length <= p + .001)); }
}
['play', 'pause', 'timeupdate', 'loadedmetadata'].forEach(ev => npA.addEventListener(ev, apSync));
npA.addEventListener('ended', () => { npA.currentTime = 0; apSync(); setTimeout(npStop, 600); });
$('npX').onclick = npStop;
$('npW').onclick = e => { const r = $('npW').getBoundingClientRect(); apSeek(npId, (e.clientX - r.left) / r.width); };

/* ---- ضبط صدا با نوار موج زنده ---- */
let rec = null, chunks = [], recT0 = 0, recTick = null, recCancel = false, recAn = null, recCtx = null;
function recBarShow(on) { $('recBar').classList.toggle('hidden', !on); $('btnMic').classList.toggle('rec', on); }
async function micStart() {
  if (rec) return;
  if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) return toast('مرورگر ضبط صدا را پشتیبانی نمی‌کند');
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    recCtx = new (window.AudioContext || window.webkitAudioContext)(); recAn = recCtx.createAnalyser(); recAn.fftSize = 128; recCtx.createMediaStreamSource(stream).connect(recAn);
    rec = new MediaRecorder(stream, { audioBitsPerSecond: 24000 }); chunks = []; recCancel = false;
    rec.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
    rec.onstop = () => {
      stream.getTracks().forEach(t => t.stop()); recCtx?.close?.(); clearInterval(recTick); recBarShow(false);
      const dur = Math.round((Date.now() - recT0) / 1000), mime = rec.mimeType; rec = null;
      if (recCancel) return toast('ضبط لغو شد');
      if (dur < 1) return toast('پیام صوتی خیلی کوتاه بود');
      const fr = new FileReader();
      fr.onload = () => fr.result.length > 900000 ? toast('پیام صوتی خیلی طولانی است') : sendMsg({ audio: fr.result, dur });
      fr.readAsDataURL(new Blob(chunks, { type: mime }));
    };
    $('recW').innerHTML = barsHtml('rec'); const bars = [...$('recW').children], data = new Uint8Array(recAn.frequencyBinCount);
    rec.start(); recT0 = Date.now(); recBarShow(true);
    recTick = setInterval(() => {
      $('recT').textContent = fmtDur((Date.now() - recT0) / 1000);
      recAn.getByteFrequencyData(data); bars.forEach((b, i) => { b.style.height = Math.max(12, Math.min(100, (data[(i * 2) % data.length] / 255) * 120)) + '%'; });
      if (Date.now() - recT0 > 90000) rec?.stop();
    }, 110);
  } catch { toast('اجازه‌ی میکروفون داده نشد'); }
}
$('btnMic').onclick = micStart;
$('recOk').onclick = () => rec?.stop();
$('recX').onclick = () => { recCancel = true; rec?.stop(); };

/* ---- منوی ＋ (ایموجی، عکس، بازی، موزیک، صدا) ---- */
function attachToggle(open) {
  const on = open === undefined ? $('attach').classList.contains('hidden') : open;
  $('attach').classList.toggle('hidden', !on); $('btnPlus').classList.toggle('x', on); $('btnPlus').textContent = on ? '✕' : '＋';
}
$('btnPlus').onclick = e => { e.stopPropagation(); attachToggle(); };
document.addEventListener('click', e => { if (!e.target.closest('#attach, #btnPlus')) attachToggle(false); });
$('attach').addEventListener('click', e => { if (e.target.closest('button')) setTimeout(() => attachToggle(false), 0); });

/* ---- بازی در چت: تاس، شیر یا خط، دعوت به کوییز ---- */
function gameCardHtml(m) {
  const g = m.game || {}, M = QZ_MODES[g.mode], C = QZ_CATS[g.cat]; if (!M || !C) return '';
  return `<div class="gcard-in"><div class="gci">${M.ic}</div><div class="gct"><b>دعوت به کوییز ${M.n}</b><small>${C.ic} ${C.n} • کد ${esc(g.code)}</small></div><button class="btn" data-gj="${esc(g.code)}">ورود</button></div>`;
}
function gameSheet() {
  let cat = 'football';
  openModal(`<h3>🎮 بازی در چت</h3>
    <div class="gm-grid"><button data-gm="dice">🎲<small>تاس</small></button><button data-gm="coin">🪙<small>شیر یا خط</small></button><button data-gm="num">🔢<small>عدد شانسی</small></button></div>
    <div class="sec-t">🧠 دعوت به کوییز</div>
    <div class="gm-cats">${Object.entries(QZ_CATS).map(([k, c]) => `<button data-gc="${k}" class="${k === cat ? 'on' : ''}">${c.ic} ${c.n}</button>`).join('')}</div>
    <div class="acts2"><button class="btn" data-qm="classic">🎨 کلاسیک (۴ نفره)</button><button class="btn ghost" data-qm="knockout">⚔️ حذفی (۶ نفره)</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  const mc = $('modalCard'), r = n => 1 + Math.floor(Math.random() * n);
  mc.querySelectorAll('[data-gc]').forEach(b => b.onclick = () => { cat = b.dataset.gc; mc.querySelectorAll('[data-gc]').forEach(x => x.classList.toggle('on', x === b)); });
  mc.querySelectorAll('[data-gm]').forEach(b => b.onclick = () => { closeModal(); sendMsg({ text: b.dataset.gm === 'dice' ? '🎲 تاس: ' + fa(r(6)) : b.dataset.gm === 'coin' ? '🪙 ' + (r(2) === 1 ? 'شیر' : 'خط') : '🔢 عدد شانسی: ' + fa(r(100)) }); });
  mc.querySelectorAll('[data-qm]').forEach(b => b.onclick = async () => {
    b.disabled = true;
    try {
      const code = await qzCreate(b.dataset.qm, cat);
      await sendMsg({ text: '🧠 دعوت به کوییز', game: { k: 'quiz', code, mode: b.dataset.qm, cat } });
      closeModal(); qzOpen(code);
    } catch { toast('ساخت بازی انجام نشد'); b.disabled = false; }
  });
}
$('btnGameC').onclick = gameSheet;

/* ---- ارسال موزیک (فایل صوتی، ۳۰ ثانیه) ---- */
$('btnMusicC').onclick = () => $('fileChatMusic').click();
$('fileChatMusic').onchange = e => { const f = e.target.files[0]; e.target.value = ''; if (f) chatMusicModal(f); };
async function chatMusicModal(f) {
  openModal(`<h3>🎵 ارسال موزیک</h3><div id="cmBox"><p style="color:var(--mut)">در حال خواندن آهنگ…</p></div><div class="acts2"><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  try {
    const ac = new (window.AudioContext || window.webkitAudioContext)(), buf = await ac.decodeAudioData(await f.arrayBuffer()), maxStart = Math.max(0, Math.floor(buf.duration - 30));
    $('cmBox').innerHTML = `<div class="field" style="text-align:start"><label>نام آهنگ</label><input id="cmTitle" maxlength="40" value="${esc(f.name.replace(/\.[^.]+$/, '').slice(0, 40))}"></div>
      ${maxStart ? `<div class="field" style="text-align:start"><label>شروع از ثانیه‌ی <b id="cmSt">۰</b> (از ${fa(Math.floor(buf.duration))})</label><input id="cmStart" type="range" min="0" max="${maxStart}" value="0" style="width:100%"></div>` : ''}
      <div class="lvl" id="cmProg" style="display:none"><i style="width:0"></i></div><button class="btn" id="cmGo">ارسال ${fa(Math.min(30, Math.floor(buf.duration)))} ثانیه موزیک</button>`;
    $('cmStart')?.addEventListener('input', ev => { $('cmSt').textContent = fa(ev.target.value); });
    $('cmGo').onclick = async () => {
      const title = $('cmTitle').value.trim().slice(0, 40) || 'موزیک';
      if (!isStaff() && badCheck(title)) return toast('🤖 نام آهنگ نامناسب است.');
      $('cmGo').disabled = true; $('cmGo').textContent = 'در حال آماده‌سازی…'; $('cmProg').style.display = 'block'; await ac.resume();
      try {
        const start = +($('cmStart')?.value || 0), len = Math.min(30, buf.duration - start);
        const data = await recordClip(ac, buf, start, 30, p => { const b = $('cmProg')?.firstChild; if (b) b.style.width = p + '%'; });
        if (data.length > 700000) throw new Error('big');
        closeModal(); await sendMsg({ audio: data, music: true, title, dur: Math.round(len) }); toast('🎵 موزیک ارسال شد');
      } catch { toast('ارسال نشد. آهنگ دیگری را امتحان کن.'); $('cmGo').disabled = false; $('cmGo').textContent = 'تلاش دوباره'; }
      ac.close?.();
    };
  } catch { $('cmBox').innerHTML = '<p class="err">این فایل خوانده نشد. یک فایل صوتی (MP3/M4A/WAV) انتخاب کن.</p>'; }
}

/* ======================= v1.5.0: گروه معامله، گزارش، پیشنهاد، سوال‌های پنل ======================= */
/* بعد از خرید از بازار: گروه ۳ نفره (خریدار، فروشنده، مدیر) برای نظارت؛ مدیر بعد از بررسی از پنل پاکش می‌کند */
async function openDeal(l) {
  try {
    const adm = Object.values(users).find(u => u.handle === ADMIN_ID), it = ITEMS.find(i => i.id === l.card), rid = 'd_' + l.id, t = Date.now();
    const members = [...new Set([me.uid, l.seller, adm?.uid].filter(Boolean))];
    const text = `🤝 معامله انجام شد: «${it ? it.e + ' ' + it.n : 'کارت'}» به قیمت ${fa(l.price)} سکه\nخریدار: ${me.name} • فروشنده: ${l.sellerName || ''}\n👑 مدیر ناظر این معامله است. اگر مشکلی بود همین‌جا بنویسید.`;
    await setDoc(doc(db, 'rooms', rid), { type: 'group', deal: true, listing: l.id, card: l.card, price: l.price, buyer: me.uid, seller: l.seller, name: `🤝 معامله: ${it?.n || 'کارت'}`, emoji: '🤝', owner: me.uid, members, created: t, last: { text: text.slice(0, 60), name: me.name, uid: me.uid, t }, read: { [me.uid]: t } });
    await addDoc(collection(db, 'rooms', rid, 'msgs'), { uid: me.uid, name: me.name, handle: me.handle, createdAt: serverTimestamp(), text });
    toast('🤝 گروه معامله ساخته شد'); waitRoomThenOpen(rid);
  } catch (e) { /* خرید انجام شده؛ فقط ساخت گروه ناموفق بود */ }
}
/* گزارش پیام (مثلا تبلیغ و فروش) → می‌رود به پنل مدیریت */
function reportModal(m) {
  const reasons = ['📢 تبلیغ / فروش چیزی', '🤬 توهین یا فحش', '😡 مزاحمت', '🗑 اسپم و پیام تکراری', '❓ مورد دیگر']; let pick = 0;
  openModal(`<h3>🚩 گزارش پیام</h3><p style="color:var(--mut);font-size:.85rem;line-height:1.8">«${esc(String(m.text || (m.img ? '🖼 تصویر' : m.audio ? '🎤 صوت' : '')).slice(0, 80))}»</p>
    <div class="rp-list" id="rpL">${reasons.map((r, i) => `<button data-r="${i}" class="${i === 0 ? 'on' : ''}">${r}</button>`).join('')}</div>
    <div class="field" style="text-align:start"><input id="rpNote" maxlength="100" placeholder="توضیح کوتاه (اختیاری)"></div><div class="err" id="rpErr"></div>
    <div class="acts2"><button class="btn" id="rpOk">ارسال گزارش به مدیر</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('rpL').onclick = e => { const b = e.target.closest('[data-r]'); if (!b) return; pick = +b.dataset.r; $('rpL').querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b)); };
  $('rpOk').onclick = async () => {
    $('rpOk').disabled = true;
    try {
      await setDoc(doc(db, 'reports', m.id + '_' + me.uid), { room, roomName: info(room).title, msgId: m.id, text: String(m.text || '').slice(0, 300), hasImg: !!m.img, hasAudio: !!m.audio, target: m.uid, targetName: m.name || '', reporter: me.uid, reporterName: me.name, reason: reasons[pick], note: $('rpNote').value.trim().slice(0, 100), status: 'open', at: serverTimestamp() });
      closeModal(); toast('🚩 گزارش برای مدیر ارسال شد. ممنون!');
    } catch { $('rpErr').textContent = 'قبلا این پیام را گزارش داده‌ای یا ارسال نشد.'; $('rpOk').disabled = false; }
  };
}
function suggestModal() {
  openModal(`<h3>💡 پیشنهاد به مدیر</h3><textarea class="sg-txt" id="sgTxt" maxlength="400" placeholder="نظر یا پیشنهادت را بنویس…"></textarea><div class="err" id="sgErr"></div>
    <div class="acts2"><button class="btn" id="sgOk">ارسال</button><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('sgOk').onclick = async () => {
    const text = $('sgTxt').value.trim(); if (text.length < 4) return $('sgErr').textContent = 'متن خیلی کوتاه است.';
    if (!isStaff() && badCheck(text)) return $('sgErr').textContent = 'متن نامناسب است.';
    $('sgOk').disabled = true;
    try { await addDoc(collection(db, 'suggestions'), { uid: me.uid, name: me.name, text, status: 'new', at: serverTimestamp() }); closeModal(); toast('💡 پیشنهادت ارسال شد. ممنون!'); }
    catch { $('sgErr').textContent = 'ارسال نشد.'; $('sgOk').disabled = false; }
  };
}
/* سوال‌هایی که مدیر از پنل اضافه می‌کند (کالکشن questions) به کوییز اضافه می‌شود */
const qzCustomIds = new Set();
async function qzLoadCustom() {
  try {
    const sn = await getDocs(collection(db, 'questions'));
    sn.docs.forEach(d => {
      if (qzCustomIds.has(d.id)) return; const x = d.data(), b = QZ_BANK[x.cat];
      if (!b || !x.answer || !x.ask) return;
      qzCustomIds.add(d.id); b.q.push({ a: String(x.answer), clue: String(x.clue || ''), ask: String(x.ask), big: String(x.big || '') });
      if (!b.pool.includes(String(x.answer))) b.pool.push(String(x.answer));
    });
  } catch (e) { /* بی‌صدا */ }
}

/* ======================= v1.6.0: صحنه‌ی پادشاهی، نشان کلن، تنظیمات ======================= */
const SCENE_SVG = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 800' preserveAspectRatio='xMidYMax slice'><defs><radialGradient id='s' cx='.5' cy='.5' r='.5'><stop offset='0' stop-color='#ffc15a' stop-opacity='.95'/><stop offset='.5' stop-color='#ff7a1a' stop-opacity='.45'/><stop offset='1' stop-color='#ff6a00' stop-opacity='0'/></radialGradient><linearGradient id='m' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#52265a'/><stop offset='1' stop-color='#1a0c22'/></linearGradient></defs><g fill='#fff'><circle cx='40' cy='60' r='1.4' opacity='.8'/><circle cx='120' cy='30' r='1' opacity='.7'/><circle cx='210' cy='80' r='1.3' opacity='.8'/><circle cx='330' cy='40' r='1.2' opacity='.8'/><circle cx='370' cy='120' r='1' opacity='.6'/><circle cx='75' cy='150' r='1' opacity='.6'/><circle cx='260' cy='20' r='1' opacity='.7'/></g><circle cx='292' cy='452' r='200' fill='url(#s)'/><path d='M0 560 L55 490 L105 535 L165 455 L225 520 L290 440 L350 500 L400 470 L400 800 L0 800Z' fill='url(#m)'/><g fill='#140a1a'><rect x='262' y='392' width='18' height='120'/><polygon points='258,392 271,350 284,392'/><rect x='288' y='410' width='24' height='100'/><polygon points='284,410 300,362 316,410'/><rect x='320' y='372' width='17' height='140'/><polygon points='316,372 328,326 341,372'/><rect x='344' y='420' width='22' height='90'/><polygon points='340,420 355,376 370,420'/><rect x='244' y='452' width='132' height='60'/></g><g fill='#ffb347'><rect x='268' y='410' width='4' height='9'/><rect x='296' y='430' width='4' height='9'/><rect x='326' y='392' width='4' height='9'/><rect x='350' y='438' width='4' height='9'/><rect x='300' y='470' width='4' height='9'/></g><path d='M0 640 Q110 580 210 625 T400 600 L400 800 L0 800Z' fill='#0e0712'/><path d='M0 700 Q120 660 240 700 T400 690 L400 800 L0 800Z' fill='#080409'/></svg>`;
const castleG = (x, c) => `<g fill='${c}' transform='translate(${x} 0)'><rect x='0' y='52' width='14' height='68'/><polygon points='-3,52 7,22 17,52'/><rect x='18' y='66' width='20' height='54'/><polygon points='15,66 28,36 41,66'/><rect x='42' y='44' width='14' height='76'/><polygon points='39,44 49,14 59,44'/><rect x='60' y='72' width='18' height='48'/><polygon points='57,72 69,46 81,72'/><rect x='-6' y='92' width='92' height='28'/></g>`;
const ART_CH = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 120' preserveAspectRatio='xMidYMid slice'><defs><linearGradient id='a' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#0b1450'/><stop offset='1' stop-color='#5b3fb5'/></linearGradient><radialGradient id='g' cx='.5' cy='.5' r='.5'><stop offset='0' stop-color='#9fd0ff' stop-opacity='.8'/><stop offset='1' stop-color='#9fd0ff' stop-opacity='0'/></radialGradient></defs><rect width='320' height='120' fill='url(#a)'/><circle cx='70' cy='40' r='46' fill='url(#g)'/>${castleG(40, '#080c2a')}<g fill='#fff' opacity='.8'><circle cx='150' cy='20' r='1'/><circle cx='200' cy='40' r='1.2'/><circle cx='260' cy='16' r='1'/><circle cx='290' cy='60' r='1'/></g></svg>`;
const ART_PUB = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 120' preserveAspectRatio='xMidYMid slice'><defs><linearGradient id='a' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#2c7a3a'/><stop offset='1' stop-color='#9be07a'/></linearGradient></defs><rect width='320' height='120' fill='url(#a)'/><circle cx='250' cy='30' r='22' fill='#fff6b0' opacity='.7'/><path d='M0 90 Q80 50 160 85 T320 70 L320 120 L0 120Z' fill='#1e5a2a'/>${castleG(50, '#143d1c')}<path d='M0 108 Q100 90 200 106 T320 100 L320 120 L0 120Z' fill='#0e3016'/></svg>`;
const ART_SV = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 120' preserveAspectRatio='xMidYMid slice'><defs><linearGradient id='a' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#3a1a0a'/><stop offset='1' stop-color='#8a5320'/></linearGradient><radialGradient id='c' cx='.5' cy='.5' r='.5'><stop offset='0' stop-color='#ffcf70' stop-opacity='.9'/><stop offset='1' stop-color='#ffcf70' stop-opacity='0'/></radialGradient></defs><rect width='320' height='120' fill='url(#a)'/><circle cx='60' cy='50' r='50' fill='url(#c)'/><g><rect x='20' y='80' width='60' height='14' fill='#5a2a14'/><rect x='26' y='66' width='50' height='14' fill='#7a3b1c'/><rect x='32' y='54' width='40' height='12' fill='#9c5a2c'/></g><path d='M120 40 Q150 20 170 62 Q150 50 120 40Z' fill='#e8d8c0' opacity='.85'/><path d='M168 60 L190 100' stroke='#c9a45a' stroke-width='2'/><rect x='96' y='96' width='200' height='24' fill='#2a1408' opacity='.7'/></svg>`;
const ART_VIP = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 120' preserveAspectRatio='xMidYMid slice'><defs><linearGradient id='a' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#1a0836'/><stop offset='1' stop-color='#6b2fb0'/></linearGradient></defs><rect width='320' height='120' fill='url(#a)'/><g fill='#fff' opacity='.8'><circle cx='30' cy='20' r='1'/><circle cx='110' cy='34' r='1.2'/><circle cx='170' cy='14' r='1'/><circle cx='230' cy='40' r='1'/><circle cx='290' cy='22' r='1.2'/></g>${castleG(30, '#10051f')}${castleG(200, '#10051f')}</svg>`;
(function kingdomArt() {
  const u = svg => 'url("data:image/svg+xml,' + encodeURIComponent(svg) + '")', r = document.documentElement.style;
  r.setProperty('--scene', u(SCENE_SVG)); r.setProperty('--art-ch', u(ART_CH)); r.setProperty('--art-pub', u(ART_PUB)); r.setProperty('--art-sv', u(ART_SV)); r.setProperty('--art-vip', u(ART_VIP));
})();

/* نشان کلن من (کنار پروفایل). اگر عضو هیچ کلنی نباشی، چیزی نشان داده نمی‌شود */
function myClan() {
  const c = Object.entries(rooms).filter(([id, r]) => roomType(id) === 'group' && !r.deal && (r.handle || r.clan) && (r.members || []).includes(me.uid));
  c.sort((a, b) => (b[1].owner === me.uid) - (a[1].owner === me.uid) || (b[1].created || 0) - (a[1].created || 0));
  return c[0] ? { id: c[0][0], ...c[0][1] } : null;
}
let clanKey = '';
function paintClan() {
  const el = $('meClan'); if (!el || !me) return;
  const c = myClan(), key = c ? c.id + '|' + (c.photo ? c.photo.length : 0) + '|' + c.name : '';
  if (key === clanKey) return; clanKey = key;
  el.classList.toggle('hidden', !c); el.dataset.room = c ? c.id : '';
  el.innerHTML = c ? `<span class="shield"><span class="sh-in">${c.photo ? `<img src="${c.photo}" alt="">` : '<b>🐉</b>'}</span></span><small>${esc(c.name)}</small>` : '';
}
$('meClan').onclick = () => { const id = $('meClan').dataset.room; if (id) openRoom(id); };
$('btnGear').onclick = () => $('btnSettings').click();

</script>
</body>
</html>
