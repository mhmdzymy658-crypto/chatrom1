<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="gold">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#050505">
<title>پرو چت</title>
<style>
:root,[data-theme=gold]{--gold:#d4af37;--gold2:#f5d77a;--gold-d:#8a6d12;--bg:#050505;--panel:#101010;--panel2:#171717;--line:#2a2410;--txt:#f3ead0;--mut:#9a9078;--me:#2b2208;--on:#1a1400;--glow:212,175,55;--danger:#e5484d}
[data-theme=ocean]{--gold:#4da3ff;--gold2:#9fd0ff;--gold-d:#1d5fa8;--bg:#04070d;--panel:#0b121c;--panel2:#111b29;--line:#16283d;--txt:#e6f0fb;--mut:#7f93a8;--me:#0f2540;--on:#04121f;--glow:77,163,255}
[data-theme=emerald]{--gold:#2fd18b;--gold2:#8df0c3;--gold-d:#15774f;--bg:#040a07;--panel:#0b1511;--panel2:#112019;--line:#153a2a;--txt:#e4f6ec;--mut:#7fa392;--me:#0d2b1f;--on:#03150d;--glow:47,209,139}
[data-theme=rose]{--gold:#ff5f8f;--gold2:#ffa3bf;--gold-d:#a82c55;--bg:#0b0508;--panel:#160c11;--panel2:#1f1219;--line:#3a1626;--txt:#fbe8ef;--mut:#a98391;--me:#3a1223;--on:#1f0710;--glow:255,95,143}
[data-theme=light]{--gold:#b8860b;--gold2:#d4a017;--gold-d:#8a6d12;--bg:#f6f2e8;--panel:#ffffff;--panel2:#f0ebdc;--line:#e2d9bd;--txt:#1c1a14;--mut:#7a7358;--me:#fbeec2;--on:#1a1400;--glow:184,134,11}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:Vazirmatn,Tahoma,'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--txt);overflow:hidden}
body::before{content:"";position:fixed;inset:0;background:radial-gradient(900px 500px at 85% -10%,rgba(var(--glow),.16),transparent 60%),radial-gradient(700px 500px at -10% 110%,rgba(var(--glow),.09),transparent 60%);pointer-events:none}
button{font-family:inherit;cursor:pointer;border:0;color:inherit;background:none}
input,textarea{font-family:inherit;color:var(--txt)}
:focus-visible{outline:2px solid var(--gold2);outline-offset:2px}
.hidden{display:none!important}
.gold-text{background:linear-gradient(135deg,var(--gold2),var(--gold) 50%,var(--gold-d));-webkit-background-clip:text;background-clip:text;color:transparent}
.btn{background:linear-gradient(135deg,var(--gold2),var(--gold) 55%,var(--gold-d));color:var(--on);font-weight:800;padding:12px 18px;border-radius:12px;width:100%}
.btn:active{transform:scale(.98)}
.btn.ghost{background:transparent;color:var(--gold);border:1px solid var(--gold-d)}
.btn.danger{background:transparent;color:var(--danger);border:1px solid var(--danger)}

/* auth */
#auth{position:fixed;inset:0;display:grid;place-items:center;padding:20px;z-index:50;overflow:auto}
.auth-card{width:min(400px,100%);background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:30px 24px;box-shadow:0 30px 80px rgba(0,0,0,.5)}
.logo{font-size:2.6rem;font-weight:800;text-align:center;letter-spacing:-1px}
.sub{text-align:center;color:var(--mut);font-size:.9rem;margin:4px 0 22px}
.tabs{display:flex;background:var(--panel2);border-radius:12px;padding:4px;margin-bottom:16px}
.tabs button{flex:1;padding:9px;border-radius:9px;color:var(--mut);font-weight:600}
.tabs button.on{background:var(--me);color:var(--gold)}
.field{margin-bottom:12px}
.field label{display:block;font-size:.8rem;color:var(--mut);margin-bottom:5px}
.field input{width:100%;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:1rem}
.field input:focus{border-color:var(--gold-d);outline:none}
.err{color:var(--danger);font-size:.85rem;min-height:1.2em;margin:4px 0 10px}

/* shell */
#app{position:fixed;inset:0;display:flex}
#side{width:340px;max-width:100%;background:var(--panel);border-inline-start:1px solid var(--line);display:flex;flex-direction:column;z-index:5}
.me-bar{display:flex;align-items:center;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line)}
.av{width:44px;height:44px;border-radius:50%;background:var(--panel2);border:2px solid var(--gold-d);flex:none;display:grid;place-items:center;color:var(--gold);font-weight:800;overflow:hidden;font-size:1.1rem}
.av img{width:100%;height:100%;object-fit:cover}
.av.sm{width:34px;height:34px;border-width:1px;font-size:.95rem}
.av.lg{width:96px;height:96px;font-size:2rem;border-width:3px}
.nm{flex:1;min-width:0}
.nm b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nm small{color:var(--mut);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.icon{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;color:var(--gold);font-size:1.1rem;flex:none}
.icon:hover{background:var(--panel2)}
.searchbox{padding:10px 14px;display:flex;gap:8px}
.searchbox input{flex:1;min-width:0;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:10px 14px}
.searchbox input:focus{outline:none;border-color:var(--gold-d)}
#list{flex:1;overflow:auto;padding:4px 8px 12px}
.row{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:14px;width:100%;text-align:start}
.row:hover{background:var(--panel2)}
.row.on{background:var(--me);box-shadow:inset 0 0 0 1px var(--gold-d)}
.row .nm small{font-size:.8rem}
.rt{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex:none}
.rt small{color:var(--mut);font-size:.7rem}
.badge{min-width:20px;height:20px;border-radius:10px;background:var(--gold);color:var(--on);font-size:.72rem;font-weight:800;display:grid;place-items:center;padding:0 6px}
.dot{width:10px;height:10px;border-radius:50%;background:#555;flex:none}
.dot.on{background:#38d26b;box-shadow:0 0 8px #38d26b}
.sec{color:var(--mut);font-size:.75rem;padding:12px 10px 4px}
.typing{color:var(--gold)!important}

#main{flex:1;display:flex;flex-direction:column;min-width:0;position:relative}
.head{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line);background:var(--panel);cursor:default}
.head .t{flex:1;min-width:0}
.head .t b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.head .t small{color:var(--mut)}
.head .clickable{cursor:pointer}
#back{display:none}
#pinbar{display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--me);border-bottom:1px solid var(--gold-d);font-size:.9rem;cursor:pointer}
#pinbar span{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
#msgs{flex:1;overflow:auto;padding:16px 14px;display:flex;flex-direction:column;gap:6px;scroll-behavior:smooth}
.day{align-self:center;background:var(--panel2);color:var(--mut);font-size:.75rem;padding:3px 12px;border-radius:999px;margin:8px 0}
.msg{display:flex;gap:8px;max-width:min(78%,560px);align-self:flex-start}
.msg.mine{align-self:flex-end;flex-direction:row-reverse}
.bub{background:var(--panel2);border:1px solid var(--line);border-radius:6px 18px 18px 18px;padding:8px 12px;min-width:90px;position:relative}
.msg.mine .bub{background:var(--me);border-color:var(--gold-d);border-radius:18px 6px 18px 18px}
.msg.big .bub{background:transparent;border-color:transparent;padding:0 6px}
.msg.big .txt{font-size:2.6rem;line-height:1.3}
.msg.flash .bub{animation:fl 1.2s}
@keyframes fl{0%,60%{box-shadow:0 0 0 3px var(--gold2)}100%{box-shadow:none}}
.who{font-size:.8rem;font-weight:600;color:var(--gold);cursor:pointer;margin-bottom:2px}
.who small{color:var(--mut);font-weight:300;direction:ltr;display:inline-block;margin-inline-start:4px}
.txt{white-space:pre-wrap;word-break:break-word;line-height:1.7}
.bub img.pic{max-width:100%;max-height:300px;border-radius:12px;display:block;margin-top:4px;cursor:zoom-in}
.bub audio{height:36px;max-width:100%;margin-top:4px}
.bub a{word-break:break-all;color:var(--gold2)}
.meta{font-size:.68rem;color:var(--mut);margin-top:3px;display:flex;gap:6px;justify-content:flex-end;align-items:center}
.tick.seen{color:#4da3ff}
.quote{border-inline-start:3px solid var(--gold);background:rgba(var(--glow),.08);padding:4px 8px;border-radius:6px;margin-bottom:5px;font-size:.82rem;color:var(--mut);cursor:pointer}
.quote b{color:var(--gold);display:block;font-size:.78rem}
.fwd{font-size:.75rem;color:var(--gold);margin-bottom:3px}
.deleted{color:var(--mut);font-style:italic}
.acts{position:absolute;top:-16px;inset-inline-end:8px;display:none;background:var(--panel);border:1px solid var(--gold-d);border-radius:10px;overflow:hidden;z-index:2}
.msg:hover .acts,.msg.sel .acts{display:flex}
.acts button{padding:5px 8px;font-size:.95rem}
.acts button:hover{background:var(--panel2)}
.rx{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}
.chip{background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:1px 8px;font-size:.8rem}
.chip.me{border-color:var(--gold);background:var(--me)}
.empty{margin:auto;color:var(--mut);text-align:center;line-height:2}

#composer{padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--panel)}
#ctx{display:flex;align-items:center;gap:8px;background:var(--panel2);border-inline-start:3px solid var(--gold);border-radius:8px;padding:6px 10px;margin-bottom:8px;font-size:.85rem}
#ctx span{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:var(--mut)}
#emojiPanel{display:grid;grid-template-columns:repeat(8,1fr);gap:2px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:8px;margin-bottom:8px;max-height:150px;overflow:auto}
#emojiPanel button{font-size:1.35rem;padding:4px;border-radius:8px}
#emojiPanel button:hover{background:var(--panel)}
.bar{display:flex;align-items:flex-end;gap:6px}
.bar textarea{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:18px;padding:10px 14px;resize:none;max-height:120px;line-height:1.5}
.bar textarea:focus{outline:none;border-color:var(--gold-d)}
.send{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--gold2),var(--gold) 55%,var(--gold-d));color:var(--on);font-size:1.2rem;font-weight:800;flex:none}
.rec{color:var(--danger)!important;animation:pl 1s infinite}
@keyframes pl{50%{opacity:.4}}
#toBottom{position:absolute;bottom:92px;inset-inline-start:14px;background:var(--panel);border:1px solid var(--gold-d);border-radius:50%;z-index:4}
#net{position:fixed;top:0;inset-inline:0;z-index:120;background:var(--danger);color:#fff;text-align:center;padding:8px 12px;font-size:.88rem}

/* request gate */
#dmGate{padding:20px 16px calc(20px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--panel);text-align:center;display:grid;gap:10px;justify-items:center}
#dmGate p{color:var(--mut);font-size:.9rem}
#dmGate input{width:min(420px,100%);background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:11px 14px}
#dmGate .btn{width:min(420px,100%)}
.gico{font-size:2.2rem}
.gnote{background:var(--panel2);border-inline-start:3px solid var(--gold);border-radius:8px;padding:6px 12px;color:var(--mut);font-size:.88rem;max-width:min(420px,100%)}
.gbtns{display:flex;gap:8px;width:min(420px,100%)}
.row.req{cursor:pointer;background:rgba(var(--glow),.08);border:1px solid var(--gold-d);margin-bottom:4px}
.reqbtns{display:flex;gap:4px}
.reqbtns .ok{background:rgba(56,210,107,.18);color:#38d26b}
.reqbtns .no{background:rgba(229,72,77,.18);color:var(--danger)}

/* avatar frames (small) */
.av.f-gold{border-color:#f5d77a;box-shadow:0 0 0 2px #8a6d12,0 0 12px rgba(245,215,122,.6)}
.av.f-neon{border-color:#00f0ff;box-shadow:0 0 0 2px #7a00ff,0 0 14px #b400ff}
.av.f-rainbow{border-color:#ff4d9d;box-shadow:0 0 0 2px #ffd400,0 0 0 4px #00c2ff}
.av.f-fire{border-color:#ffb300;box-shadow:0 0 0 2px #ff3d00,0 0 14px #ff6d00}
.av.f-ice{border-color:#e0f7ff;box-shadow:0 0 0 2px #29b6f6,0 0 12px #81d4fa}

/* v1.0.3: splash + تب‌های پروفایل */
#splash{position:fixed;inset:0;z-index:60;display:grid;place-items:center;background:var(--bg,#050505);text-align:center}
#splash .sp{width:42px;height:42px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--gold);animation:spin 1s linear infinite;margin:14px auto 0}
.pf-tabs{display:flex;background:var(--panel2);border-radius:12px;padding:4px;margin-bottom:14px;gap:2px}
.pf-tabs button{flex:1;padding:9px 4px;border-radius:9px;color:var(--mut);font-weight:700;font-size:.88rem}
.pf-tabs button.on{background:var(--me);color:var(--gold)}
.pf-pane.hidden{display:none!important}
.fr-row{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);background:var(--panel2);border-radius:14px;margin-bottom:8px;cursor:pointer;width:100%;text-align:start}
.fr-row .nm{flex:1;min-width:0}.fr-row .nm b{display:block}.fr-row .nm small{color:var(--mut)}
.pf-empty{text-align:center;color:var(--mut);padding:22px 8px;line-height:2}
/* v1.1.0: ایمیل، نشست‌ها، لیست بازی‌ها */
.linkb{display:block;margin:12px auto 0;color:var(--gold);font-size:.86rem;text-decoration:underline}
#authOk{color:#5fe08f;font-size:.86rem;line-height:1.9;margin-top:6px;min-height:0}
.sess{display:flex;align-items:center;gap:10px;padding:10px;border:1px solid var(--line);background:var(--panel2);border-radius:14px;margin-bottom:8px}
.sess .si{font-size:1.5rem}.sess .nm{flex:1;min-width:0}.sess .nm b{display:block;font-size:.92rem}.sess .nm small{display:block;color:var(--mut);font-size:.78rem;line-height:1.7}
.sess .tag{background:var(--gold);color:#241a00;border-radius:8px;padding:1px 8px;font-size:.7rem;font-weight:800;margin-inline-start:6px}
.sess button.mini{background:#3a1f1f;color:#ff8a8a;border-radius:9px;padding:6px 10px;font-size:.78rem}
button.qz-rk{width:100%;color:inherit;font:inherit;text-align:start;cursor:pointer}
.st3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.st3 div{background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:10px 4px;text-align:center}
.st3 b{display:block;font-size:1.15rem;color:var(--gold)}.st3 small{color:var(--mut);font-size:.74rem}
/* v1.3.0: هدیه، بازار، پروفایل-مرکز، گرافیک کوییز */
.pf-gift{position:absolute;top:10px;inset-inline-end:10px;z-index:5;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.35);font-size:1.1rem;animation:giftPulse 2.2s ease-in-out infinite}
@keyframes giftPulse{50%{transform:scale(1.12);box-shadow:0 0 14px rgba(255,200,61,.75)}}
.hubrow{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.hubrow button{background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:11px 6px;font-weight:700;font-size:.84rem}
.hubrow button:active{transform:scale(.97)}
.gf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-height:44vh;overflow:auto;margin:10px 0}
.gf-card{display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 4px;border-radius:14px;background:var(--panel2);border:2px solid var(--line)}
.gf-card.on{border-color:var(--gold);box-shadow:0 0 14px rgba(var(--glow),.45)}
.gf-card .e{font-size:1.9rem}.gf-card small{font-size:.7rem;line-height:1.5}
.gf-amt{display:flex;gap:6px;margin:6px 0 4px}.gf-amt button{flex:1;padding:9px 0;border-radius:12px;background:var(--panel2);border:1px solid var(--line);font-weight:700}
#qz{background:radial-gradient(900px 520px at 12% -8%,rgba(212,175,55,.24),transparent 60%),radial-gradient(760px 520px at 92% 108%,rgba(120,80,255,.18),transparent 60%),#05050a}
#qz::after{content:"";position:fixed;inset:0;pointer-events:none;background-image:radial-gradient(1.5px 1.5px at 20% 30%,rgba(255,255,255,.6),transparent),radial-gradient(1.5px 1.5px at 70% 18%,rgba(255,255,255,.45),transparent),radial-gradient(2px 2px at 40% 76%,rgba(245,215,122,.55),transparent),radial-gradient(1.5px 1.5px at 86% 64%,rgba(255,255,255,.45),transparent),radial-gradient(1.5px 1.5px at 8% 86%,rgba(255,255,255,.4),transparent),radial-gradient(2px 2px at 58% 48%,rgba(245,215,122,.4),transparent);animation:qzTw 4.5s ease-in-out infinite alternate}
@keyframes qzTw{from{opacity:.35}to{opacity:1}}
.qz-in{z-index:1}
.qz-hc{position:relative;overflow:hidden;background:linear-gradient(135deg,rgba(64,48,10,.95),rgba(16,16,24,.95) 70%);transition:transform .15s,box-shadow .2s}
.qz-hc::before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(245,215,122,.2) 50%,transparent 65%);transform:translateX(-120%);animation:qzShine 4.5s ease-in-out infinite}
@keyframes qzShine{55%,100%{transform:translateX(120%)}}
.qz-hc .ic{background:radial-gradient(circle at 30% 25%,#3b3011,#0b0b0b);box-shadow:inset 0 0 16px rgba(212,175,55,.3),0 0 16px rgba(212,175,55,.28);animation:qzBob 3s ease-in-out infinite}
@keyframes qzBob{50%{transform:translateY(-3px) rotate(-3deg)}}
.qz-cat{transition:transform .15s,box-shadow .2s}.qz-cat:active{transform:scale(.94)}.qz-cat.on span{animation:qzBob 1.8s ease-in-out infinite}
.qz-q{background:radial-gradient(120% 90% at 50% 0%,rgba(212,175,55,.22),transparent 60%),linear-gradient(160deg,#2b2208,#14141c 70%)}
.qz-big{filter:drop-shadow(0 6px 14px rgba(245,215,122,.5));animation:qzPop .5s cubic-bezier(.2,1.4,.4,1)}
@keyframes qzPop{from{transform:scale(.4) rotate(-12deg);opacity:0}to{transform:none;opacity:1}}
.qz-opt{background:linear-gradient(135deg,#1b1b25,#121218);border-radius:16px;box-shadow:0 3px 0 rgba(0,0,0,.45);transition:transform .12s,box-shadow .12s,border-color .2s,background .25s}
.qz-opt:not(:disabled):active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,.45)}
.qz-opt i{background:linear-gradient(135deg,#f5d77a,#b8921f);color:#241a00;font-weight:900}
.qz-opt.ok i{background:linear-gradient(135deg,#6af0b4,#1fae72)}
.qz-ring{filter:drop-shadow(0 0 10px rgba(212,175,55,.3))}.qz-ring .fg{filter:drop-shadow(0 0 5px rgba(245,215,122,.6))}
button.qz-rk:active{transform:scale(.98)}
.qz-win{background:linear-gradient(135deg,#fff1b8,#f5d77a 30%,#d4af37 60%,#8a6d12);overflow:hidden}
.qz-win::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.5) 50%,transparent 65%);transform:translateX(-120%);animation:qzShine 3s ease-in-out infinite}
.qz-p.me{box-shadow:0 0 14px rgba(212,175,55,.3)}
.qz-av{box-shadow:0 0 0 2px rgba(212,175,55,.25),0 4px 10px rgba(0,0,0,.4)}
.qz-code{background:linear-gradient(135deg,#171717,#0d0d0d);box-shadow:inset 0 0 22px rgba(212,175,55,.18)}
/* profile card */
.card.pf-card{padding:0;overflow:auto;position:relative;width:min(430px,100%);text-align:center}
.pf-top{position:relative;padding:46px 16px 40px;color:#fff;overflow:hidden;isolation:isolate}
.pf-top>*{position:relative;z-index:1}
.pf-top .pf-pat{position:absolute;inset:-25% -12%;z-index:0;font-size:1.5rem;opacity:.17;line-height:2.2;letter-spacing:16px;transform:rotate(-12deg);word-break:break-all;pointer-events:none;user-select:none;overflow:hidden}
.pf-x{position:absolute;top:10px;inset-inline-start:10px;z-index:5;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.35);color:#fff;font-size:1rem}
.pf-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px}
.stat{background:rgba(255,255,255,.18);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.32);border-radius:16px;padding:10px 12px;min-width:84px}
.stat b{display:block;font-size:1.35rem;line-height:1.2}
.stat small{font-size:.74rem;opacity:.92}
.frame{position:relative;width:118px;height:118px;display:grid;place-items:center;border-radius:50%;flex:none}
.frame::before{content:"";position:absolute;inset:-6px;border-radius:50%;z-index:0;opacity:0}
.frame .av{position:relative;z-index:1;border:4px solid rgba(255,255,255,.9);background:#222;color:#fff}
.frame.f-gold::before{opacity:1;background:conic-gradient(#fff3b0,#d4af37,#8a6d12,#f5d77a,#fff3b0);animation:spin 6s linear infinite}
.frame.f-neon::before{opacity:1;background:conic-gradient(#00f0ff,#7a00ff,#ff00c8,#00f0ff);box-shadow:0 0 22px #9b30ff;animation:spin 3.5s linear infinite}
.frame.f-rainbow::before{opacity:1;background:conic-gradient(#ff3b3b,#ffd400,#2bd96b,#00c2ff,#7a5cff,#ff3b9a,#ff3b3b);animation:spin 4s linear infinite}
.frame.f-fire::before{opacity:1;background:conic-gradient(#ff3d00,#ffb300,#ff3d00,#d50000,#ff3d00);box-shadow:0 0 24px #ff6d00;animation:spin 2.5s linear infinite}
.frame.f-ice::before{opacity:1;background:conic-gradient(#e0f7ff,#4fc3f7,#0288d1,#b3e5fc,#e0f7ff);box-shadow:0 0 18px #4fc3f7;animation:spin 7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.pf-name{font-size:1.4rem;font-weight:800;margin-top:14px;text-shadow:0 1px 6px rgba(0,0,0,.35)}
.pf-id{opacity:.85;direction:ltr;font-size:.9rem}
.pf-title{display:inline-block;margin-top:8px;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:3px 14px;font-size:.82rem}
.charm{position:absolute!important;font-size:1.9rem;filter:drop-shadow(0 0 10px rgba(255,255,255,.75));animation:flt 3.6s ease-in-out infinite;z-index:2}
.charm.c0{top:16%;inset-inline-start:7%}
.charm.c1{top:20%;inset-inline-end:7%;animation-delay:-1.2s}
.charm.c2{top:62%;inset-inline-end:6%;animation-delay:-2.2s}
@keyframes flt{50%{transform:translateY(-9px) rotate(6deg)}}
.pf-body{background:var(--panel);margin-top:-18px;border-radius:22px 22px 0 0;padding:18px 16px 16px;text-align:start;position:relative;z-index:3}
.pf-bio{background:var(--panel2);border-radius:14px;padding:10px 14px;line-height:1.8;margin-bottom:12px}
.pf-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.pc{background:var(--panel2);border:1px solid var(--line);border-radius:18px;padding:22px 8px 10px;text-align:center;position:relative}
.pci{position:absolute;top:-16px;left:50%;transform:translateX(-50%);width:36px;height:36px;border-radius:50%;background:var(--me);border:2px solid var(--gold-d);display:grid;place-items:center}
.pc b{display:block;font-size:1.4rem}
.pc small{color:var(--mut)}
.lvl-wrap{margin-bottom:12px}
.lvl{height:9px;border-radius:9px;background:var(--panel2);overflow:hidden;margin-bottom:4px}
.lvl i{display:block;height:100%;background:linear-gradient(90deg,var(--gold-d),var(--gold2));border-radius:9px}
.lvl-wrap small{color:var(--mut)}
.pf-tbl{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;font-size:.9rem}
.pf-tbl th{width:34%;text-align:start;background:var(--panel2);padding:10px 12px;color:var(--mut);font-weight:600;border-bottom:1px solid var(--line)}
.pf-tbl td{padding:10px 12px;border-bottom:1px solid var(--line)}
.pf-tbl tr:last-child th,.pf-tbl tr:last-child td{border-bottom:0}
.pf-form .field{text-align:start}
.pf-form .two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sw{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.sw button{width:40px;height:40px;border-radius:12px;border:3px solid transparent}
.sw button.on{border-color:var(--txt)}
.sw.fr button{width:auto;height:auto;padding:6px 12px;border-radius:999px;background:var(--panel2);border:1px solid var(--line);font-size:.85rem}
.sw.fr button.on{border-color:var(--gold);color:var(--gold)}
.lbl{color:var(--mut);font-size:.8rem;margin:6px 0 5px;text-align:start}
.charm-in{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.charm-in input{text-align:center;font-size:1.3rem;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:8px}

/* shop */
#shop{position:fixed;inset:0;z-index:70;background:var(--bg);overflow:auto;padding:0 0 30px}
#shop::before{content:"";position:fixed;inset:0;background:radial-gradient(800px 420px at 50% -10%,rgba(var(--glow),.18),transparent 65%);pointer-events:none}
.shop-head{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:10px;padding:12px 14px;background:var(--panel);border-bottom:1px solid var(--line)}
.shop-head b{flex:1;font-size:1.1rem}
.coinchip{display:flex;align-items:center;gap:6px;background:var(--me);border:2px solid var(--gold);color:var(--gold2);font-weight:800;border-radius:999px;padding:5px 14px}
.shop-in{position:relative;max-width:760px;margin:0 auto;padding:14px}
.shop-in .tabs{margin-bottom:10px}
.rf{display:flex;gap:6px;overflow:auto;margin-bottom:12px;padding-bottom:2px}
.rf button{flex:none;padding:6px 14px;border-radius:999px;background:var(--panel2);border:1px solid var(--line);font-size:.85rem;color:var(--mut)}
.rf button.on{border-color:var(--gold);color:var(--gold)}
#shopGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:620px){#shopGrid{grid-template-columns:repeat(3,1fr)}}
.ic{position:relative;border-radius:22px;padding:14px 10px 12px;text-align:center;cursor:pointer;
  background:radial-gradient(120% 70% at 50% 0%,rgba(var(--rg),.28),transparent 70%),linear-gradient(160deg,var(--panel2),var(--panel));
  border:1.5px solid var(--rc);box-shadow:0 8px 24px rgba(0,0,0,.35),inset 0 0 28px rgba(var(--rg),.1);overflow:hidden;transition:transform .15s}
.ic:active{transform:scale(.97)}
.ic::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.12) 50%,transparent 60%);transform:translateX(-120%);animation:shine 5s infinite}
@keyframes shine{60%,100%{transform:translateX(120%)}}
.ic .code{position:absolute;top:8px;inset-inline-start:8px;font-size:.7rem;background:rgba(0,0,0,.45);color:#fff;padding:2px 9px;border-radius:999px}
.ie{font-size:3.6rem;line-height:1.2;margin:18px 0 4px;filter:drop-shadow(0 6px 14px rgba(var(--rg),.55));animation:flt 4s ease-in-out infinite}
.in{font-weight:800;margin-top:6px}
.ir{color:var(--rc);font-size:.85rem;margin:6px 0 10px}
.price{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(180deg,#ffd45a,#f09a1a);color:#3a2300;font-weight:800;border-radius:999px;padding:6px 18px;box-shadow:0 4px 0 #a86408;border:2px solid #fff3c4}
.price:active{transform:translateY(2px);box-shadow:0 2px 0 #a86408}
.price.poor{filter:grayscale(.7);opacity:.7}
.own-b{display:inline-block;color:#38d26b;font-weight:700;padding:6px 10px}
.ic.own{opacity:.96}
.big-ic{margin:0 auto 6px;max-width:240px}
.big-ic .ie{font-size:5.2rem}
.mini-col{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.mini-ic{display:flex;align-items:center;gap:6px;background:rgba(var(--rg),.14);border:1px solid var(--rc);border-radius:12px;padding:4px 10px;font-size:.82rem}
.mini-ic span{font-size:1.2rem}
.sec-t{color:var(--mut);font-size:.8rem;margin:2px 0 6px}
@keyframes pop{0%{transform:scale(.4) rotate(-8deg);opacity:0}70%{transform:scale(1.08)}100%{transform:scale(1);opacity:1}}
.pop{animation:pop .6s cubic-bezier(.2,1.3,.4,1)}

/* v5 home redesign */
.vh{position:fixed;left:-9999px;top:0;width:1px;height:1px;opacity:0}
.av{border-color:var(--ring,var(--gold-d))}
.avw{position:relative;flex:none}
.avw .av{color:var(--ring,var(--gold))}
.av.ring-gold{--ring:var(--gold);font-size:1.4rem}
.odot{position:absolute;bottom:1px;right:1px;width:13px;height:13px;border-radius:50%;background:#555;border:2px solid var(--panel)}
.odot.on{background:#38d26b;box-shadow:0 0 8px #38d26b}
.icon.on{background:var(--me);box-shadow:inset 0 0 0 1px var(--gold-d)}
.nb{position:absolute;top:-4px;right:-3px;min-width:18px;height:18px;border-radius:9px;background:#ff3b4e;color:#fff;font-size:.68rem;font-weight:700;display:grid;place-items:center;padding:0 4px;font-style:normal;line-height:1}
.bellb{position:relative}
.top{display:flex;align-items:center;gap:8px;padding:12px 14px 6px}
.top .av{width:52px;height:52px}
.top .nm b{font-size:1.1rem}
#sideScroll{flex:1;overflow:auto}
#list{flex:none;overflow:visible}
.banner{margin:8px 12px 6px;border-radius:20px;padding:16px;position:relative;overflow:hidden;border:1.5px solid var(--gold-d);display:flex;align-items:center;min-height:128px;
  background:radial-gradient(120% 140% at 15% 50%,rgba(var(--glow),.38),transparent 60%),linear-gradient(135deg,var(--panel2),var(--panel))}
.bn-txt{position:relative;z-index:2;flex:1}
.bn-txt b{font-size:1.05rem;display:block;line-height:1.7}
.bn-txt small{color:var(--mut);display:block;margin:2px 0 10px}
.bn-btn{background:linear-gradient(135deg,var(--gold2),var(--gold) 55%,var(--gold-d));color:var(--on);font-weight:800;border-radius:12px;padding:8px 16px}
.bn-art{position:relative;width:120px;height:112px;flex:none}
.bn-art span{position:absolute;filter:drop-shadow(0 6px 16px rgba(var(--glow),.7));animation:flt 4s ease-in-out infinite}
.bn-art .c1{font-size:4.6rem;left:12px;top:14px}
.bn-art .c2{font-size:2.2rem;left:0;top:0;animation-delay:-1s}
.bn-art .c3{font-size:1.6rem;right:6px;bottom:2px;animation-delay:-2s}
.tiles{display:flex;gap:10px;overflow-x:auto;padding:6px 12px 10px;scrollbar-width:none}
.tiles::-webkit-scrollbar{display:none}
.tiles button{flex:none;width:84px;background:var(--panel2);border:1px solid var(--line);border-radius:18px;padding:12px 4px 9px;display:flex;flex-direction:column;align-items:center;gap:6px;position:relative}
.tiles button:active{transform:scale(.96)}
.tiles .ti{font-size:1.8rem;filter:drop-shadow(0 3px 8px rgba(var(--glow),.45))}
.tiles small{font-size:.76rem}
.row.gold{background:linear-gradient(270deg,rgba(var(--glow),.24),rgba(var(--glow),.05));border:1px solid var(--gold-d);box-shadow:0 0 22px rgba(var(--glow),.16);margin-bottom:4px}
.row.newg{color:var(--gold);justify-content:center;border:1px dashed var(--gold-d);margin-bottom:6px}
.pin{font-size:.85rem;opacity:.9}
.badge.dotb{min-width:10px;height:10px;padding:0}
#nav{display:flex;align-items:flex-end;justify-content:space-around;padding:6px 6px calc(8px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:linear-gradient(180deg,var(--panel),var(--bg))}
#nav button{position:relative;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 8px;color:var(--mut);flex:1}
#nav button span{font-size:1.4rem}
#nav button small{font-size:.72rem}
#nav button.on{color:var(--gold)}
#nav button.on::after{content:"";position:absolute;bottom:-5px;width:30px;height:3px;border-radius:3px;background:var(--gold)}
#nav .plus{flex:none;width:60px;height:60px;border-radius:50%;border:3px solid var(--gold);color:var(--gold2);font-size:2rem;padding:0;margin-top:-26px;background:var(--panel);box-shadow:0 0 22px rgba(var(--glow),.55);display:grid;place-items:center}
#nav .nb{top:0;right:14px}
.av-edit{position:relative;display:block;cursor:pointer}
.camb{position:absolute;bottom:2px;right:2px;z-index:3;width:32px;height:32px;border-radius:50%;background:var(--gold);color:var(--on);display:grid;place-items:center;font-size:1rem;border:2px solid #fff}
.menu-list{display:grid;gap:8px;margin-top:12px}
.menu-list button{display:flex;align-items:center;gap:12px;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:12px 14px;font-weight:600;text-align:start}
.menu-list span{font-size:1.3rem}

/* v6: effects, VIP, admin */
.fx{position:absolute!important;inset:0;z-index:0!important;overflow:hidden;pointer-events:none}
.fx i{position:absolute;display:block}
.fx-rain i,.fx-storm i{top:-12%;width:2px;height:30px;background:linear-gradient(transparent,rgba(190,215,255,.9));animation:rainfall .8s linear infinite}
@keyframes rainfall{to{transform:translateY(540px)}}
.fx-storm{background:linear-gradient(rgba(8,12,30,.5),rgba(8,12,30,.15))}
.fx-bolt{background:rgba(8,12,30,.38)}
.fx-snow i{top:-6%;width:6px;height:6px;border-radius:50%;background:#fff;opacity:.9;box-shadow:0 0 6px #fff;animation:snowfall 6s linear infinite}
@keyframes snowfall{0%{transform:translate(0,0)}50%{transform:translate(16px,270px)}100%{transform:translate(-8px,540px)}}
.fx-stars i{width:4px;height:4px;border-radius:50%;background:#fff;box-shadow:0 0 8px #fff;animation:twk 2.4s ease-in-out infinite}
@keyframes twk{0%,100%{opacity:.1;transform:scale(.6)}50%{opacity:1;transform:scale(1.6)}}
.fx-embers i{bottom:-6%;width:5px;height:5px;border-radius:50%;background:#ffb300;box-shadow:0 0 8px #ff6d00;animation:rise 4s linear infinite}
@keyframes rise{0%{transform:translateY(0);opacity:1}100%{transform:translateY(-500px) translateX(22px);opacity:0}}
.fx .flash{position:absolute;inset:0;background:#fff;opacity:0;animation:flashA 5s infinite}
@keyframes flashA{0%,90%,100%{opacity:0}91%{opacity:.75}93%{opacity:.05}94%{opacity:.55}97%{opacity:0}}
.fx .bolt{position:absolute;top:0;left:34%;width:72px;height:215px;background:#fff6c2;clip-path:polygon(45% 0,100% 0,62% 38%,92% 38%,18% 100%,40% 52%,8% 52%);filter:drop-shadow(0 0 14px #ffe66b);opacity:0;animation:flashA 5s infinite}
.vipb{display:inline-block;background:linear-gradient(135deg,#ffe27a,#d4af37);color:#3a2800;font-weight:800;font-size:.62rem;border-radius:6px;padding:1px 6px;margin-inline-start:5px;vertical-align:middle}
#admin{position:fixed;inset:0;z-index:70;background:var(--bg);overflow:auto}
.areq{background:var(--panel2);border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:10px;text-align:start}
.areq .gbtns{margin-top:8px;width:100%}
.gift-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.gg{position:relative;background:rgba(var(--rg),.14);border:1.5px solid var(--rc);border-radius:14px;padding:8px 4px;text-align:center;font-size:.78rem}
.gg span{display:block;font-size:1.8rem}
.gg.own::after{content:"✓";position:absolute;top:4px;right:7px;color:#38d26b;font-weight:800}
.amt{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin:10px 0}
.amt button{background:var(--panel2);border:1px solid var(--gold-d);border-radius:999px;padding:6px 14px;color:var(--gold)}

/* v8: gift cards, music, trash, staff */
.ic{background:radial-gradient(110% 70% at 50% 18%,rgba(255,255,255,.28),transparent 62%),linear-gradient(160deg,var(--a,#2a2a3a),var(--b,#14141c));border-color:rgba(255,255,255,.3);color:#fff}
.ic .tgp,.gs-top .tgp,.mc .tgp{position:absolute;inset:-20% -15%;font-size:1.25rem;line-height:2.1;letter-spacing:12px;opacity:.15;transform:rotate(-12deg);word-break:break-all;overflow:hidden;pointer-events:none;user-select:none}
.ic .ie,.ic .in,.ic .ir,.ic .price,.ic .own-b{position:relative;z-index:1}
.ic .in{color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.4)}
.ic .ir{color:#fff;opacity:.85}
.ic .ie{filter:drop-shadow(0 8px 16px rgba(0,0,0,.45))}
.col-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.mc{position:relative;overflow:hidden;border-radius:16px;padding:10px 4px 6px;border:1.5px solid rgba(255,255,255,.3);color:#fff;text-align:center;
  background:radial-gradient(110% 70% at 50% 15%,rgba(255,255,255,.28),transparent 60%),linear-gradient(160deg,var(--a),var(--b))}
.mc .ie{display:block;font-size:2.3rem;position:relative;z-index:1}
.mc small{position:relative;z-index:1;font-size:.7rem;opacity:.92}
.gs-top{position:relative;overflow:hidden;padding:36px 16px 24px;color:#fff;text-align:center;
  background:radial-gradient(90% 60% at 50% 30%,rgba(255,255,255,.32),transparent 65%),linear-gradient(160deg,var(--a),var(--b))}
.gs-top>*:not(.tgp){position:relative;z-index:1}
.gs-art{font-size:6rem;line-height:1.1;filter:drop-shadow(0 12px 24px rgba(0,0,0,.45));animation:flt 4s ease-in-out infinite}
.gs-name{font-size:1.3rem;font-weight:800;margin-top:8px}
.gs-name small{opacity:.75;font-weight:600}
.gs-sub{opacity:.85}
.pct{display:inline-block;background:rgba(var(--glow),.18);color:var(--gold2);border-radius:999px;padding:0 8px;font-size:.78rem;margin-inline-start:6px}
.own-l{color:#4da3ff;cursor:pointer;display:inline-flex;align-items:center;gap:8px}
.own-l .av{width:26px;height:26px;border-width:1px;font-size:.75rem}
.mus{width:100%;display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,rgba(var(--glow),.22),rgba(var(--glow),.06));border:1px solid var(--gold-d);border-radius:14px;padding:10px 14px;margin-bottom:10px;text-align:start}
.mus b{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.mus i{font-style:normal;color:var(--gold);font-size:1.1rem}
.mus.ghost{background:var(--panel2);border-style:dashed}
.trash{font-size:.95rem;opacity:.55;padding:2px 4px;border-radius:8px;cursor:pointer}
.trash:hover{opacity:1;background:rgba(229,72,77,.18)}
.ph{display:flex;align-items:center;gap:12px}
.ph img{width:84px;height:84px;border-radius:50%;object-fit:cover;border:2px solid var(--gold-d)}

/* modal */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:grid;place-items:center;z-index:80;padding:16px}
.card{width:min(400px,100%);max-height:90vh;overflow:auto;background:var(--panel);border:1px solid var(--gold-d);border-radius:20px;padding:22px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.6)}
.card h3{margin:8px 0 2px}
.card .id{color:var(--mut);direction:ltr}
.acts2{display:grid;gap:8px;margin-top:16px}
.pick{max-height:220px;overflow:auto;text-align:start;margin-top:8px}
.pick label{display:flex;align-items:center;gap:10px;padding:8px;border-radius:10px;cursor:pointer}
.pick label:hover{background:var(--panel2)}
.pick input{accent-color:var(--gold);width:18px;height:18px}
.rpick{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-top:12px}
.rpick button{font-size:1.6rem;padding:6px 8px;border-radius:12px;background:var(--panel2)}
.themes{display:flex;gap:10px;justify-content:center;margin:12px 0}
.themes button{width:40px;height:40px;border-radius:50%;border:3px solid transparent}
.themes button.on{border-color:var(--txt)}
.setrow{display:flex;align-items:center;justify-content:space-between;padding:10px 4px;border-top:1px solid var(--line);text-align:start}
#lightbox img{max-width:96vw;max-height:90vh;border-radius:12px}
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--panel);border:1px solid var(--gold-d);padding:10px 18px;border-radius:12px;z-index:99;font-size:.9rem;max-width:90vw}

@media(max-width:760px){
  #side{position:absolute;inset:0;width:100%;border:0}
  #app.chat #side{display:none}
  #back{display:grid}
  .msg{max-width:90%}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;scroll-behavior:auto!important}}

/* v9: update banner + stories */
#updBanner{position:fixed;top:0;left:0;right:0;z-index:99999;display:flex;align-items:center;gap:12px;padding:12px 16px;padding-top:calc(12px + env(safe-area-inset-top,0px));background:linear-gradient(135deg,#ffe27a,#d4af37 55%,#a8801a);color:#3a2800;box-shadow:0 6px 24px rgba(0,0,0,.45);animation:updSlide .55s cubic-bezier(.2,.9,.3,1.1) both;direction:rtl}
#updBanner .ut{flex:1;min-width:0}
#updBanner .ut b{display:block;font-size:1rem;font-weight:800}
#updBanner .ut small{display:block;margin-top:3px;font-size:.84rem;line-height:1.6;opacity:.9;white-space:pre-line}
#updBanner button{background:#3a2800;color:#ffe27a;font-weight:800;border-radius:10px;padding:9px 16px;font-size:.9rem;flex-shrink:0}
@keyframes updSlide{from{transform:translateY(-110%);opacity:0}to{transform:translateY(0);opacity:1}}
#storyBar:empty{display:none}
#storyBar .srow{display:flex;gap:12px;overflow-x:auto;padding:10px 12px 4px;scrollbar-width:none}
#storyBar .srow::-webkit-scrollbar{display:none}
.sitem{display:flex;flex-direction:column;align-items:center;gap:5px;width:64px;flex-shrink:0}
.sitem small{font-size:.7rem;color:var(--mut);max-width:64px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.sring{width:58px;height:58px;border-radius:50%;padding:3px;background:linear-gradient(135deg,var(--gold2),var(--gold-d));display:grid;place-items:center}
.sring.add{background:var(--panel2);border:2px dashed var(--gold-d);font-size:1.5rem;color:var(--gold)}
.sav{width:100%;height:100%;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:var(--panel2);border:2px solid var(--bg);font-weight:800}
.sav img{width:100%;height:100%;object-fit:cover}
#storyView{position:fixed;inset:0;z-index:300;background:#000;display:flex;flex-direction:column}
#storyView video{flex:1;min-height:0;width:100%;object-fit:contain;background:#000}
#storyView .sh{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;gap:10px;padding:calc(12px + env(safe-area-inset-top,0px)) 14px 24px;background:linear-gradient(#000a,transparent);color:#fff;z-index:2}
#storyView .sh b{flex:1}
#storyView .sh button{color:#fff;font-size:1.3rem;padding:4px 8px}
#storyView .sc{position:absolute;bottom:0;left:0;right:0;padding:24px 16px calc(18px + env(safe-area-inset-bottom,0px));background:linear-gradient(transparent,#000b);color:#fff;text-align:center;z-index:2}
#storyView .sload{margin:auto;color:#fff}

/* v9.1 */
#storyView .sprog{position:absolute;top:calc(6px + env(safe-area-inset-top,0px));left:10px;right:10px;height:3px;border-radius:3px;background:rgba(255,255,255,.3);z-index:3;overflow:hidden}
#storyView .sprog i{display:block;height:100%;width:0;background:#fff;border-radius:3px}
#storyView .sh{padding-top:calc(22px + env(safe-area-inset-top,0px))}
#storyView .sh .sav{width:38px;height:38px;flex:none;border:2px solid #fff}
#storyView .sh b{display:flex;flex-direction:column;line-height:1.3}
#storyView .sh small{font-weight:400;font-size:.72rem;opacity:.8}
.sviews{position:absolute;bottom:calc(16px + env(safe-area-inset-bottom,0px));inset-inline-start:16px;z-index:4;background:rgba(0,0,0,.55);color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:8px 16px;font-size:.9rem;backdrop-filter:blur(6px)}
#storyView .sc{bottom:calc(60px + env(safe-area-inset-bottom,0px))}
.svlist{position:absolute;inset:0;background:rgba(0,0,0,.6);display:flex;align-items:flex-end;z-index:6}
.svbox{width:100%;max-height:65%;overflow:auto;background:var(--panel);border-radius:22px 22px 0 0;padding:16px;color:var(--txt)}
.svbox h4{margin-bottom:10px;text-align:center}
.svrow{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)}
.svrow .sav{width:38px;height:38px;flex:none}
.svrow b{flex:1}.svrow small{color:var(--mut)}
.svbox .btn{margin-top:12px;width:100%}
.sring.seen{background:var(--line)}
/* پیام‌ها: جمع‌وجور و پلکانی */
#msgs{gap:12px;padding:16px 12px 20px}
.msg{width:fit-content;max-width:min(76%,520px);align-items:flex-end;gap:6px}
.msg:not(.mine){margin-inline-end:auto;margin-inline-start:2px}
.msg.mine{margin-inline-start:auto;margin-inline-end:4px}
.bub{display:flex;flex-direction:column;min-width:64px;max-width:100%;padding:7px 12px;box-shadow:0 3px 10px rgba(0,0,0,.2)}
.bub img.pic{align-self:flex-start}
.acts{position:static;order:99;display:none;margin:7px 0 1px;flex-wrap:wrap;justify-content:center;border-radius:12px}
.msg:hover .acts{display:none}
.msg.sel .acts{display:flex}
.rq{flex:none;align-self:center;width:30px;height:30px;border-radius:50%;background:var(--panel2);border:1px solid var(--line);color:var(--gold);font-size:1rem;opacity:.6}
.rq:active{opacity:1;transform:scale(.9)}
/* فروشگاه/کارت */
.tiles button{width:76px;padding:10px 2px 8px}
.tiles .ti{font-size:1.55rem}
.charm{cursor:pointer;pointer-events:auto}
.charm:active{transform:scale(1.25)}
.gs-pill{display:inline-block;margin-top:4px;padding:3px 14px;border-radius:999px;background:rgba(0,0,0,.35);border:1px solid var(--rc);color:var(--rc);font-weight:800;font-size:.82rem;box-shadow:0 0 14px var(--rc)}
.gs-top::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.22) 50%,transparent 60%);transform:translateX(-120%);animation:shine 4s infinite;pointer-events:none}
.gs-art{text-shadow:0 0 40px rgba(255,255,255,.5)}
.pf-card{animation:cardIn .35s cubic-bezier(.2,.9,.3,1.15) both}
@keyframes cardIn{from{transform:translateY(30px) scale(.92);opacity:0}to{transform:none;opacity:1}}

/* ============ v10: بازی کوییز ============ */
#navGames{color:var(--gold)}
#navGames span{filter:drop-shadow(0 0 8px rgba(var(--glow),.7))}
#qz{position:fixed;inset:0;z-index:75;background:#050505;overflow:auto;padding-bottom:30px;--qg:#d4af37;--qg2:#f5d77a;--qgd:#8a6d12;--qok:#2fd18b;--qbad:#e5484d;--qp:#101010;--qp2:#171717;color:#f3ead0}
#qz::before{content:"";position:fixed;inset:0;background:radial-gradient(800px 420px at 50% -10%,rgba(212,175,55,.2),transparent 65%);pointer-events:none}
#qz .shop-head{background:#101010}
.qz-in{position:relative;max-width:640px;margin:0 auto;padding:14px}
.qz-hc{display:flex;align-items:center;gap:14px;width:100%;padding:16px;margin-bottom:12px;border-radius:20px;text-align:start;background:linear-gradient(135deg,#2b2208,#101010 70%);border:1.5px solid var(--qgd);box-shadow:0 6px 22px rgba(0,0,0,.4)}
.qz-hc:active{transform:scale(.98);border-color:var(--qg)}
.qz-hc .ic{font-size:2.3rem;width:62px;height:62px;border-radius:18px;display:grid;place-items:center;background:#050505;border:1px solid var(--qgd);flex:none}
.qz-hc b{display:block;font-size:1.15rem;color:var(--qg2)}.qz-hc small{color:#9a9078}
.qz-hc .ar{margin-inline-start:auto;color:var(--qg);font-size:1.3rem}
.qz-cats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0 14px}
.qz-cat{padding:12px 4px;border-radius:14px;background:var(--qp2);border:1.5px solid #2a2410;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:.8rem}
.qz-cat span{font-size:1.7rem}
.qz-cat.on{border-color:var(--qg);background:#2b2208;color:var(--qg2);box-shadow:0 0 16px rgba(212,175,55,.3)}
.qz-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.qz-btns .full{grid-column:1/-1;padding:14px;font-size:1.05rem}
.qz-codein{display:flex;gap:8px;margin-bottom:12px}
.qz-codein input{flex:1;text-align:center;letter-spacing:.35em;font-size:1.2rem;direction:ltr;background:var(--qp2);border:1.5px solid #2a2410;border-radius:12px;padding:10px;color:#f3ead0}
.qz-codein .btn{width:auto;padding:10px 20px}
.qz-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:16px;background:var(--qp2);border:1px solid #2a2410;margin-bottom:8px}
.qz-row .nm{flex:1;min-width:0}.qz-row .nm small{display:block;color:#9a9078}
.qz-row .btn{width:auto;padding:8px 16px}
.qz-av{width:40px;height:40px;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:var(--qp2);border:2px solid var(--qgd);font-weight:800;flex:none}
.qz-av img{width:100%;height:100%;object-fit:cover}
.qz-code{font-size:2.3rem;font-weight:800;letter-spacing:.3em;color:var(--qg2);text-align:center;padding:14px 8px 14px 0;border:2px dashed var(--qgd);border-radius:18px;margin:10px 0;direction:ltr;user-select:all;background:#101010}
.qz-cnt{text-align:center;color:#9a9078;margin:8px 0}.qz-cnt b{color:var(--qg2);font-size:1.3rem}
.qz-slots{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}
.qz-slot{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 6px;border-radius:18px;background:var(--qp2);border:1px solid var(--qgd);min-height:104px;justify-content:center;text-align:center}
.qz-slot .qz-av{width:52px;height:52px}
.qz-slot.empty{border-style:dashed;border-color:#2a2410;color:#9a9078}
.qz-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;gap:8px}
.qz-chips span{display:inline-block;padding:4px 10px;border-radius:999px;background:#2b2208;border:1px solid var(--qgd);color:var(--qg2);font-size:.78rem;margin-inline-end:6px}
.qz-rd{color:#9a9078;font-size:.9rem}.qz-rd b{color:var(--qg2)}
.qz-mid{display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:14px}
.qz-ring{position:relative;width:76px;height:76px;margin-bottom:-6px}
.qz-ring svg{transform:rotate(-90deg)}
.qz-ring .bg{stroke:#2a2410}
.qz-ring .fg{stroke:#2fd18b;stroke-linecap:round;transition:stroke .3s}
.qz-ring b{position:absolute;inset:0;display:grid;place-items:center;font-size:1.6rem;color:#f3ead0}
.qz-q{width:100%;border-radius:22px;padding:18px 16px;text-align:center;background:linear-gradient(160deg,#2b2208,#171717 65%);border:2px solid var(--qg);box-shadow:0 0 28px rgba(212,175,55,.35),inset 0 0 30px rgba(212,175,55,.08);animation:qzIn .4s ease both}
.qz-big{font-size:3.4rem;line-height:1.15}
.qz-clue{color:var(--qg2);line-height:1.95;margin:8px 0;font-size:.98rem}
.qz-ask{font-weight:800;font-size:1.15rem;line-height:1.8}
@keyframes qzIn{from{transform:translateY(14px) scale(.97);opacity:0}to{transform:none;opacity:1}}
.qz-opts{display:grid;grid-template-columns:1fr;gap:10px}
.qz-opt{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:14px;background:var(--qp2);border:1.5px solid var(--qgd);text-align:start;font-weight:700;color:#f3ead0;transition:opacity .25s,background .25s}
.qz-opt i{font-style:normal;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#2b2208;color:var(--qg2);flex:none;font-size:.85rem}
.qz-opt:not(:disabled):active{transform:scale(.97);border-color:var(--qg2)}
.qz-opt.ok{background:rgba(47,209,139,.18);border-color:var(--qok);animation:qzPulse .6s ease 2}
.qz-opt.bad{background:rgba(229,72,77,.18);border-color:var(--qbad);animation:qzShake .45s}
.qz-opt.dim{opacity:.4}
@keyframes qzPulse{0%{box-shadow:0 0 0 0 rgba(47,209,139,.75)}100%{box-shadow:0 0 0 20px rgba(47,209,139,0)}}
@keyframes qzShake{20%,60%{transform:translateX(-9px)}40%,80%{transform:translateX(9px)}}
.qz-note{min-height:26px;text-align:center;margin:10px 0 4px;color:var(--qg2);font-weight:700;font-size:.92rem}
.qz-pl{display:flex;flex-direction:column;gap:6px}
.qz-p{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:14px;background:var(--qp2);border:1px solid #2a2410}
.qz-p.me{border-color:var(--qg);background:#2b2208}
.qz-p.out{opacity:.45}
.qz-p .qz-av{width:34px;height:34px}.qz-p b{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.qz-p .st{font-size:.9rem;min-width:46px;text-align:center}
.qz-p .st.g{color:var(--qok);font-weight:800}.qz-p .st.r{color:var(--qbad)}
.qz-p i{font-style:normal;font-weight:800;color:var(--qg2);min-width:40px;text-align:end}
.qz-win{position:relative;text-align:center;padding:26px 14px 20px;border-radius:26px;margin:22px 0 14px;background:linear-gradient(135deg,#f5d77a,#d4af37 55%,#8a6d12);color:#1a1400;box-shadow:0 10px 40px rgba(212,175,55,.45)}
.qz-win .qz-av{width:84px;height:84px;margin:0 auto 8px;border-color:#fff;font-size:1.8rem}
.qz-win b{display:block;font-size:1.3rem}.qz-win small{font-weight:700}
.qz-crown{position:absolute;top:-34px;left:50%;transform:translateX(-50%);font-size:3rem;animation:qzFloat 1.6s ease-in-out infinite;filter:drop-shadow(0 4px 8px rgba(0,0,0,.5))}
@keyframes qzFloat{50%{transform:translateX(-50%) translateY(-8px) rotate(4deg)}}
.qz-rk{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:16px;background:var(--qp2);border:1px solid #2a2410;margin-bottom:8px}
.qz-rk .md{font-size:1.5rem;width:34px;text-align:center}.qz-rk b{flex:1}.qz-rk i{font-style:normal;font-weight:800;color:var(--qg2)}
.qz-rk.me{border-color:var(--qg)}
.qz-fx{position:fixed;inset:0;z-index:95;pointer-events:none;overflow:hidden}
.qz-fx i{position:absolute;width:6px;height:6px;border-radius:50%;animation:qzBurst 1.2s ease-out forwards}
.qz-fx s{position:absolute;top:-16px;width:8px;height:14px;border-radius:2px;animation:qzFall linear forwards}
@keyframes qzBurst{from{transform:translate(0,0) scale(1.2);opacity:1}to{transform:translate(var(--dx),var(--dy)) scale(.3);opacity:0}}
@keyframes qzFall{to{transform:translateY(110vh) rotate(720deg)}}
.qz-info{color:#9a9078;line-height:1.9;font-size:.9rem;text-align:center;margin:10px 0}

/* ============ v1.4.0: ظاهر جدید ============ */
:root{--wall:linear-gradient(180deg,#02030a,#0b1030)}
#side{position:relative;background:transparent;padding:10px 10px 0;border-inline-start:0}
.hd{display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:24px;background:linear-gradient(135deg,var(--panel2),var(--panel));border:1.5px solid var(--gold-d);box-shadow:0 8px 28px rgba(0,0,0,.45),inset 0 0 0 1px rgba(var(--glow),.1)}
.hd-av{position:relative;flex:none;width:58px;height:62px;display:grid;place-items:center}
.hd-av .av{width:54px;height:54px;border-radius:18px;border:2.5px solid var(--gold);box-shadow:0 0 16px rgba(var(--glow),.5)}
.hd-av .crown{position:absolute;top:-8px;inset-inline-end:-6px;font-size:1.1rem;font-style:normal;filter:drop-shadow(0 2px 4px #000)}
.hd-mid{flex:1;min-width:0;text-align:center}
.logo{font-family:'Segoe Script','Brush Script MT','Snell Roundhand',cursive;font-size:1.6rem;font-style:italic;font-weight:700;line-height:1.15;background:linear-gradient(135deg,var(--gold2),var(--gold) 60%,var(--gold-d));-webkit-background-clip:text;background-clip:text;color:transparent;direction:ltr}
.logo span{margin-inline-start:3px}
.lvlp{display:inline-block;margin-top:3px;padding:2px 14px;border-radius:999px;background:var(--panel);border:1px solid var(--gold-d);font-size:.76rem;font-weight:800;color:var(--gold2);direction:ltr}
.chip{position:relative;display:flex;align-items:center;gap:6px;height:42px;padding:0 10px;border-radius:14px;background:var(--panel);border:1.5px solid var(--gold-d);color:var(--txt);font-weight:800;flex:none}
.chip.coin{border-color:var(--gold);background:linear-gradient(135deg,rgba(var(--glow),.2),var(--panel))}
.chip.coin .plusi{font-style:normal;width:22px;height:22px;border-radius:50%;background:#2fd18b;color:#04210f;display:grid;place-items:center;font-size:1rem;line-height:1}
.chip.bell,.chip.adm{width:42px;padding:0;justify-content:center;font-size:1.1rem}
.chip .nb{top:-6px;right:-5px}
.tabs1{display:flex;gap:4px;margin:10px 0 0;padding:6px;border-radius:20px;background:var(--panel);border:1.5px solid var(--line)}
.tabs1 button{position:relative;flex:1;padding:11px 2px;border-radius:14px;color:var(--mut);font-weight:700;font-size:.84rem;white-space:nowrap}
.tabs1 button.on,.tabs2 button[data-st].on{background:linear-gradient(135deg,var(--gold2),var(--gold) 60%,var(--gold-d));color:var(--on);box-shadow:0 4px 14px rgba(var(--glow),.4)}
.tabs1 .nb{position:static;display:inline-grid;margin-inline-start:4px;vertical-align:middle}
.tabs2{display:flex;gap:6px;margin:10px 0;padding:5px;border-radius:18px;background:var(--panel);border:1.5px solid var(--line);align-items:center}
.tabs2 button[data-st]{flex:1;padding:12px 6px;border-radius:13px;color:var(--mut);font-weight:700}
#sideScroll{padding:0 0 120px}
#list{padding:0}
.row.rc{display:flex;align-items:center;gap:12px;width:100%;padding:12px;margin-bottom:12px;border-radius:22px;text-align:start;background:linear-gradient(135deg,rgba(255,255,255,.05),rgba(255,255,255,.015));border:1.5px solid var(--rcc,var(--line));box-shadow:0 6px 20px rgba(0,0,0,.28)}
.row.rc:hover{background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.03))}
.row.rc:active{transform:scale(.985)}
.row.rc.on{box-shadow:0 0 0 2px var(--rcc,var(--gold)),0 6px 20px rgba(0,0,0,.3)}
.rc .avw .av{width:62px;height:62px;border:3px solid var(--ring,var(--gold-d));font-size:1.5rem}
.rc .avw .av img{border-radius:50%}
.rc .nm{flex:1;min-width:0}
.rc .nm b{display:flex;align-items:center;gap:6px;font-size:1.02rem}
.rc .nm small{display:block;color:var(--mut);margin-top:3px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.rc .rt{display:flex;flex-direction:column;align-items:flex-start;gap:8px;flex:none}
.rc .rt small{color:var(--mut);font-size:.72rem}
.tag{padding:5px 12px;border-radius:999px;font-size:.76rem;font-weight:700;border:1px solid var(--rcc,var(--gold-d));color:var(--rcc,var(--gold));background:rgba(0,0,0,.25)}
.row.rc.ch{--rcc:#4da3ff;--ring:#4da3ff;background:linear-gradient(135deg,rgba(77,163,255,.2),rgba(77,163,255,.04))}
.row.rc.pub{--rcc:var(--gold);--ring:var(--gold);background:linear-gradient(135deg,rgba(var(--glow),.24),rgba(var(--glow),.05))}
.vb{display:inline-grid;place-items:center;width:18px;height:18px;border-radius:50%;font-style:normal;font-size:.62rem;font-weight:800;flex:none}
.vb.blue{background:#2f8cff;color:#fff}.vb.green{background:#2fd18b;color:#04210f;border-radius:6px}.vb.gold{background:linear-gradient(135deg,#ffe27a,#d4af37);color:#3a2800;border-radius:6px}
.gd{display:flex;gap:12px;padding:14px;margin-bottom:10px;border-radius:20px;background:var(--panel);border:1.5px solid var(--line)}
.gdi{font-size:1.8rem;width:50px;height:50px;border-radius:16px;display:grid;place-items:center;background:var(--panel2);border:1px solid var(--gold-d);flex:none}
.gd b{display:block;color:var(--gold2);margin-bottom:3px}.gd p{color:var(--mut);font-size:.86rem;line-height:1.95}
/* نوار پایین شناور */
#nav{position:absolute;inset-inline:12px;bottom:calc(10px + env(safe-area-inset-bottom));z-index:20;display:flex;align-items:center;justify-content:space-between;padding:8px 6px;border-radius:30px;border:1.5px solid var(--gold-d);background:linear-gradient(180deg,var(--panel2),var(--panel));box-shadow:0 10px 34px rgba(0,0,0,.65)}
#nav button{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;color:var(--mut)}
#nav button span{font-size:1.55rem}
#nav button small{font-size:.7rem}
#nav button.on{color:var(--gold2)}
#nav button.on::after{display:none}
#nav .center{flex:none;width:78px;margin-top:-36px;color:var(--txt)}
#nav .center span{width:64px;height:64px;border-radius:22px;display:grid;place-items:center;font-size:2rem;background:linear-gradient(135deg,var(--gold2),var(--gold) 55%,var(--gold-d));border:3px solid var(--panel);box-shadow:0 8px 24px rgba(var(--glow),.55);filter:none}
#nav .center em{font-style:normal;margin-top:6px;padding:3px 14px;border-radius:999px;background:var(--gold);color:var(--on);font-weight:800;font-size:.72rem}
#nav .nb{top:0;right:12px}
/* سربرگ چت */
#main{background:var(--wall)}
#main .head{padding:10px 12px;gap:10px;background:linear-gradient(180deg,rgba(0,0,0,.55),rgba(0,0,0,.3));border-bottom:1.5px solid var(--gold-d);backdrop-filter:blur(8px)}
#main .head .back{width:46px;height:46px;border-radius:14px;border:1.5px solid var(--gold-d);background:rgba(0,0,0,.3)}
#main .head .icon{width:42px;height:42px;border-radius:13px;background:rgba(255,255,255,.07)}
#hAv{width:52px;height:52px;border:3px solid var(--ring,var(--gold));flex:none}
.head .t b{display:flex;align-items:center;gap:6px;font-size:1.05rem}
.head .t small.on{color:#38d26b}
#msgs{background:transparent!important}
.wl-light .bub{color:#1c1a14}
#pinbar{margin:10px 12px 0;padding:10px 14px;border-radius:18px;background:rgba(var(--glow),.14);border:1.5px solid var(--gold-d);border-bottom:1.5px solid var(--gold-d)}
#pinbar .pi{flex:none;color:var(--gold)}
#pinbar .pt{flex:1;min-width:0;display:flex;flex-direction:column}
#pinbar .pt b{font-size:.78rem;color:var(--gold2)}
#pinbar .pt span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:var(--txt)}
.msg .bub{border-radius:22px!important;background:rgba(14,12,26,.62);border:1.5px solid rgba(var(--glow),.22);backdrop-filter:blur(6px)}
.msg.mine .bub{background:rgba(var(--glow),.2);border-color:var(--gold-d)}
.msg.big .bub{background:transparent!important;border-color:transparent!important;backdrop-filter:none}
.bub .txt{background:rgba(0,0,0,.28);border-radius:14px;padding:6px 12px}
.msg.big .txt{background:transparent;padding:0}
[data-theme=light] .msg .bub{background:rgba(255,255,255,.88)}
[data-theme=light] .bub .txt{background:rgba(0,0,0,.05)}
.rq{width:40px!important;height:40px!important;opacity:.85!important;background:rgba(0,0,0,.35)!important;border:1.5px solid var(--gold-d)!important}
.bub.rel{border-color:var(--gold)!important;background:linear-gradient(135deg,rgba(var(--glow),.3),rgba(0,0,0,.5))!important}
.bub.rel .txt{background:transparent;padding:0;line-height:2}
/* پیام صوتی و موزیک */
.ap{display:flex;align-items:center;gap:10px;min-width:210px;margin-top:4px;padding:6px 8px;border-radius:16px;background:rgba(0,0,0,.28);direction:ltr}
.apb{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold2),var(--gold) 60%,var(--gold-d));color:var(--on);font-size:1rem;flex:none}
.apw{display:flex;align-items:center;gap:2px;height:34px;flex:1;direction:ltr;cursor:pointer}
.apw i{flex:1;min-width:2px;border-radius:2px;background:var(--mut);opacity:.55;transition:background .15s}
.apw i.p{background:var(--gold2);opacity:1}
.apt{font-size:.72rem;color:var(--mut);min-width:34px;text-align:center}
.apn{font-size:.78rem;color:var(--gold2);margin:4px 2px 0}
#np,#recBar{display:flex;align-items:center;gap:10px;padding:8px 12px;margin-bottom:8px;border-radius:18px;background:rgba(0,0,0,.42);border:1.5px solid var(--gold-d)}
#np .apw,#recBar .apw{height:40px}
#np .npx{font-size:1.5rem;color:var(--gold2);width:40px;height:40px;border-radius:50%;display:grid;place-items:center;flex:none}
#npT,#recT{font-weight:800;font-size:.85rem;min-width:40px;text-align:center;direction:ltr}
#recBar .recx,#recBar .recok{width:42px;height:42px;border-radius:50%;flex:none;font-size:1.1rem}
#recBar .recx{background:rgba(229,72,77,.2);color:#ff7b80}
#recBar .recok{background:linear-gradient(135deg,var(--gold2),var(--gold) 60%,var(--gold-d));color:var(--on)}
#recBar .apw i{opacity:1;background:var(--gold);transition:height .1s}
/* نوار پیام و منوی ＋ */
#composer{position:relative;background:rgba(0,0,0,.5);border-top:1.5px solid var(--gold-d);backdrop-filter:blur(8px)}
#composer .bar{direction:ltr;align-items:center;gap:10px}
#composer .bar textarea{direction:rtl;text-align:right;border-radius:24px;padding:12px 16px;background:rgba(255,255,255,.07);border:1.5px solid var(--gold-d)}
.plusb{width:48px;height:48px;border-radius:50%;border:2px solid var(--gold-d);background:rgba(0,0,0,.3);color:var(--gold2);font-size:1.7rem;flex:none;transition:transform .2s}
.plusb.x{transform:rotate(0);border-color:var(--gold);color:var(--gold)}
#composer .send{width:50px;height:50px;box-shadow:0 6px 18px rgba(var(--glow),.45)}
#attach{position:absolute;left:12px;bottom:calc(100% - 6px);z-index:30;display:flex;flex-direction:column;gap:10px;padding:12px;border-radius:32px;background:rgba(28,24,40,.94);border:1.5px solid var(--gold-d);box-shadow:0 14px 40px rgba(0,0,0,.6);backdrop-filter:blur(10px);animation:atIn .18s ease-out}
#attach button{width:52px;height:52px;border-radius:50%;border:1.5px solid var(--gold-d);background:rgba(255,255,255,.07);font-size:1.45rem;display:grid;place-items:center}
#attach button:active{transform:scale(.9);background:rgba(var(--glow),.2)}
@keyframes atIn{from{opacity:0;transform:translateY(10px) scale(.96)}to{opacity:1;transform:none}}
#emojiPanel{border-radius:18px;margin-bottom:8px}
#btnMic.rec{background:#e5484d!important}
/* کارت دعوت به بازی در چت */
.gcard-in{display:flex;align-items:center;gap:10px;margin-top:4px;padding:10px;border-radius:16px;background:rgba(0,0,0,.3);border:1px solid var(--gold-d)}
.gci{font-size:1.8rem}.gct{flex:1;min-width:0}.gct b{display:block}.gct small{color:var(--mut)}
.gcard-in .btn{width:auto;padding:8px 18px}
.gm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.gm-grid button{display:flex;flex-direction:column;align-items:center;gap:4px;padding:14px 4px;border-radius:16px;background:var(--panel2);border:1px solid var(--gold-d);font-size:1.8rem}
.gm-grid small{font-size:.74rem;color:var(--txt)}
.gm-cats{display:flex;gap:6px;margin:8px 0}
.gm-cats button{flex:1;padding:10px 2px;border-radius:12px;background:var(--panel2);border:1.5px solid var(--line);font-size:.8rem}
.gm-cats button.on{border-color:var(--gold);color:var(--gold2)}
/* زمینه‌ها */
.wl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0;max-height:44vh;overflow:auto}
.wl{position:relative;height:130px;border-radius:16px;border:2px solid var(--line);overflow:hidden;display:flex;align-items:flex-end;padding:8px;cursor:pointer}
.wl.on{border-color:var(--gold);box-shadow:0 0 14px rgba(var(--glow),.6)}
.wl b{font-size:.74rem;color:#fff;text-shadow:0 1px 4px #000}
.wl-dl{position:absolute;top:6px;left:6px;width:30px;height:30px;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:.9rem}
.lb-tabs{display:flex;gap:6px;margin:10px 0}.lb-tabs button{flex:1;padding:9px 2px;border-radius:12px;background:var(--panel2);border:1.5px solid var(--line);font-size:.82rem}.lb-tabs button.on{border-color:var(--gold);color:var(--gold2)}
.lb-list{max-height:52vh;overflow:auto}
.lb-row{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border-radius:14px;background:var(--panel2);border:1px solid var(--line);margin-bottom:6px;text-align:start}
.lb-row.me{border-color:var(--gold)}.lb-row .md{width:32px;text-align:center;font-size:1.2rem}.lb-row b{flex:1;display:flex;align-items:center;gap:6px;min-width:0}.lb-row i{font-style:normal;font-weight:800;color:var(--gold2)}.lb-row small{font-weight:400;color:var(--mut)}
/* v1.5.0 */
.cl-photo{width:92px;height:92px;border-radius:50%;margin:8px auto;display:grid;place-items:center;font-size:2rem;background:var(--panel2);border:2px dashed var(--gold-d);overflow:hidden;cursor:pointer}
.cl-photo img{width:100%;height:100%;object-fit:cover}
.pick label .icon{margin-inline-start:auto;width:32px;height:32px;color:#ff7b80}
.rp-list{display:grid;gap:8px;margin:10px 0}
.rp-list button{padding:12px 14px;border-radius:14px;background:var(--panel2);border:1.5px solid var(--line);text-align:start}
.rp-list button.on{border-color:var(--gold);color:var(--gold2)}
.sg-txt{width:100%;min-height:110px;padding:12px;border-radius:14px;background:var(--panel2);border:1.5px solid var(--gold-d);color:var(--txt);resize:vertical}

/* ============ v1.6.0: پادشاهی (ظاهر فانتزی) ============ */
#side{background:radial-gradient(ellipse 120% 38% at 50% 100%,rgba(255,130,30,.35),transparent 62%),var(--scene) bottom center/cover no-repeat,linear-gradient(180deg,#16082a 0%,#3b1634 40%,#7a3318 72%,#150a10 100%)!important;overflow:hidden}
#side::before,#side::after{content:"";position:absolute;top:34%;width:14px;height:100px;border-radius:5px 5px 3px 3px;pointer-events:none;z-index:0;background:radial-gradient(circle at 50% 8px,#fff4b0 0 3px,#ffb02e 6px,rgba(255,90,0,0) 15px) no-repeat,linear-gradient(180deg,transparent 14px,#8a5a2a 14px,#2a170a);box-shadow:0 0 34px 14px rgba(255,140,30,.3);animation:torch 1.6s ease-in-out infinite}
#side::before{left:3px}#side::after{right:3px;animation-delay:.6s}
@keyframes torch{0%,100%{filter:brightness(1)}50%{filter:brightness(1.35)}}
.topbar,.hd,.tabs1,#sideScroll{position:relative;z-index:1}
.topbar{display:flex;align-items:center;justify-content:space-between;direction:ltr;padding:2px 2px 8px;gap:6px}
.tb-l{display:flex;gap:8px;align-items:center}
.chip{height:44px;border:2px solid #8a6d12;background:rgba(10,8,16,.82);border-radius:999px;color:#fff}
.chip.bell,.chip.gear{width:46px;padding:0;justify-content:center;font-size:1.25rem;border-radius:50%}
.chip.coin{padding:0 12px 0 6px;border-color:var(--gold);background:rgba(10,8,16,.82)}
.chip.coin .plusi{font-style:normal;width:26px;height:26px;border-radius:50%;background:#2fd18b;color:#052612;display:grid;place-items:center;font-size:1.1rem;line-height:1;font-weight:800}
.ttl{display:flex;flex-direction:column;align-items:center;line-height:1;pointer-events:none;margin-top:-4px}
.ttl i{font-style:normal;font-size:1.5rem;margin-bottom:-6px;filter:drop-shadow(0 2px 8px rgba(255,170,40,.9))}
.ttl b{font-family:'Lalezar','Aref Ruqaa','Segoe UI',Tahoma,sans-serif;font-size:2.2rem;font-weight:400;letter-spacing:1px;background:linear-gradient(180deg,#fff6bf 0%,#f5d77a 38%,#d4af37 68%,#8a6d12 100%);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 2px 0 #3a2800) drop-shadow(0 0 14px rgba(255,160,40,.65))}
.hd{display:flex;align-items:center;gap:12px;padding:14px 12px;border-radius:22px;border:2.5px solid transparent;background:linear-gradient(135deg,rgba(14,10,20,.93),rgba(26,14,32,.9)) padding-box,linear-gradient(135deg,#ffe27a,#8a6d12 45%,#ffe27a) border-box;box-shadow:0 12px 32px rgba(0,0,0,.6),inset 0 0 34px rgba(212,175,55,.1)}
.hd-av{position:relative;flex:none;width:80px;height:82px;display:grid;place-items:center}
.hd-av .av{width:76px;height:76px;border-radius:50%;border:3px solid var(--gold);box-shadow:0 0 22px rgba(var(--glow),.7)}
.hd-av .crown{position:absolute;bottom:-4px;top:auto;left:50%;right:auto;inset-inline-end:auto;transform:translateX(-50%);font-size:1.2rem;font-style:normal;filter:drop-shadow(0 2px 4px #000)}
.hd-mid{flex:1;min-width:0;text-align:start}
.hd-name{display:flex;align-items:center;gap:6px;font-weight:800;font-size:1.15rem;color:#fff;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.hd-name .nmc{font-size:1rem}
.lvlp{display:inline-block;margin:5px 0;padding:2px 16px;border-radius:999px;background:rgba(0,0,0,.45);border:1.5px solid #8a6d12;font-size:.8rem;font-weight:800;color:var(--gold2)}
.xp{position:relative;height:16px;border-radius:999px;background:rgba(0,0,0,.55);border:1.5px solid #8a6d12;overflow:hidden}
.xp i{display:block;height:100%;width:0;background:linear-gradient(90deg,#b8860b,#ffe27a);transition:width .5s}
.xp span{position:absolute;inset:0;display:grid;place-items:center;font-size:.68rem;font-weight:700;color:#fff;text-shadow:0 1px 2px #000;direction:ltr}
.crest{display:flex;flex-direction:column;align-items:center;gap:3px;flex:none;width:74px}
.crest.hidden{display:none}
.shield{position:relative;display:block;width:64px;height:74px;clip-path:polygon(0 0,100% 0,100% 64%,50% 100%,0 64%);background:linear-gradient(160deg,#ffe27a,#8a6d12 55%,#ffe27a);filter:drop-shadow(0 4px 10px rgba(0,0,0,.6))}
.sh-in{position:absolute;inset:3px;clip-path:polygon(0 0,100% 0,100% 64%,50% 100%,0 64%);background:radial-gradient(circle at 50% 30%,#a8232d,#3a0b12);display:grid;place-items:center;overflow:hidden}
.sh-in img{width:100%;height:100%;object-fit:cover}
.sh-in b{font-size:2.1rem;line-height:1;margin-top:-8px;filter:drop-shadow(0 3px 5px #000)}
.crest small{font-size:.64rem;color:var(--gold2);max-width:74px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-shadow:0 1px 3px #000}
.tabs1{margin-top:12px;padding:6px;border-radius:20px;border:2.5px solid transparent;background:linear-gradient(rgba(10,8,16,.9),rgba(10,8,16,.9)) padding-box,linear-gradient(135deg,#8a6d12,#ffe27a,#8a6d12) border-box}
.tabs1 button{display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 2px;font-size:.78rem;color:#b9ad92;background:none!important;box-shadow:none!important;border:2px solid transparent}
.tabs1 button span{font-size:1.35rem}
.tabs1 button.on{color:var(--gold2)!important;border-color:var(--gold);background:linear-gradient(180deg,rgba(212,175,55,.26),rgba(212,175,55,.06))!important;box-shadow:0 0 16px rgba(var(--glow),.55),inset 0 0 12px rgba(var(--glow),.22)!important}
.tabs1 .nb{position:absolute;top:2px;inset-inline-end:6px;margin:0}
.tabs2{border:2px solid #4a3c14;background:rgba(10,8,16,.85)}
.tabs2 button[data-st].on{box-shadow:0 0 14px rgba(var(--glow),.5)}
/* کارت‌ها با تصویر */
.row.rc{position:relative;min-height:96px;border-radius:20px;border:2.5px solid transparent;background:linear-gradient(90deg,rgba(6,5,12,.3) 0%,rgba(6,5,12,.9) 65%) padding-box,var(--art,linear-gradient(#17121f,#17121f)) center/cover padding-box,linear-gradient(135deg,var(--f1,#ffe27a),var(--f2,#8a6d12),var(--f1,#ffe27a)) border-box;box-shadow:0 8px 22px rgba(0,0,0,.5)}
.row.rc:hover{filter:brightness(1.08)}
.rc .nm b{text-shadow:0 2px 6px #000}.rc .nm small{color:#d6cdb6;text-shadow:0 1px 4px #000}
.row.rc.ch{--art:var(--art-ch);--f1:#a9d6ff;--f2:#2563c9}
.row.rc.pub{--art:var(--art-pub);--f1:#c4f0a0;--f2:#2f8a2f}
.row.rc.sv{--art:var(--art-sv);--f1:#ffb0a0;--f2:#a02020}
.row.newg{display:flex;align-items:center;gap:14px;justify-content:center;width:100%;min-height:78px;margin-bottom:12px;border-radius:20px;border:2.5px solid transparent;font-weight:800;font-size:1.05rem;color:#fff;background:linear-gradient(90deg,rgba(14,5,30,.35),rgba(14,5,30,.85) 60%) padding-box,var(--art-vip) center/cover padding-box,linear-gradient(135deg,#e7ccff,#6b2fb0,#e7ccff) border-box}
.vipb{display:grid;place-items:center;width:58px;height:58px;font-style:normal;font-weight:900;font-size:.82rem;color:#3a2800;background:linear-gradient(135deg,#ffe27a,#d4af37);clip-path:polygon(25% 5%,75% 5%,100% 50%,75% 95%,25% 95%,0 50%);flex:none}
/* نوار پایین */
#nav{border:2.5px solid transparent;background:linear-gradient(180deg,rgba(18,12,24,.97),rgba(8,6,12,.97)) padding-box,linear-gradient(135deg,#ffe27a,#8a6d12,#ffe27a) border-box;box-shadow:0 12px 36px rgba(0,0,0,.75)}
#nav button:not(.center) span{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,#2c2336,#0d0912);border:1.5px solid #3a2e18;font-size:1.5rem}
#nav button.on:not(.center) span{border-color:var(--gold);box-shadow:0 0 14px rgba(var(--glow),.5)}
#nav .center span{width:68px;height:68px;border-radius:50%;box-shadow:0 0 28px rgba(var(--glow),.8),0 8px 24px rgba(0,0,0,.6)}
.wl.up{border-style:dashed;display:grid;place-items:center;text-align:center;background-color:var(--panel2)}

/* ===== v1.6.1: ظاهر فروشگاه و گیفت‌ها مثل پوستر «ممد فرعون» (آبی نئونی + نارنجی درخشان + چرخ‌دنده‌های چرخان) ===== */
#shop{background:#03050a}
#shop::before{background:radial-gradient(760px 400px at 12% -6%,rgba(0,191,255,.24),transparent 65%),radial-gradient(760px 400px at 92% 0,rgba(255,157,0,.18),transparent 65%)}
#shop .shop-head{background:rgba(3,5,10,.94);border-bottom:1px solid rgba(0,191,255,.38);box-shadow:0 6px 24px rgba(0,160,255,.12)}
#shop .shop-head b{background:linear-gradient(#fff3c4,#ffb347 55%,#ff7a00);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 8px rgba(255,157,0,.45))}
.ph-hero{position:relative;border-radius:26px;overflow:hidden;margin-bottom:14px;border:1px solid rgba(114,217,255,.45);box-shadow:0 0 60px rgba(0,160,255,.2),0 0 80px rgba(255,130,0,.1)}
.ph-hero>img{display:block;width:100%;height:auto}
.ph-hero .gears{position:absolute;left:50%;top:73.7%;width:28%;aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none;filter:drop-shadow(0 0 10px #00bfff) drop-shadow(0 0 20px #ff9d00)}
.ph-hero .gear{position:absolute;transform-origin:50% 50%}
.ph-hero .ph-g1{width:62%;left:18%;top:10%;animation:phSpin 6s linear infinite}
.ph-hero .ph-g2{width:42%;right:8%;bottom:12%;animation:phSpinR 4s linear infinite}
.ph-hero .ph-g3{width:25%;left:8%;bottom:7%;animation:phSpin 3s linear infinite}
.ph-hero .gear svg{width:100%;height:100%;display:block}
@keyframes phSpin{to{transform:rotate(360deg)}}
@keyframes phSpinR{to{transform:rotate(-360deg)}}
.ph-cap{position:absolute;inset:auto 0 0 0;padding:26px 14px 10px;text-align:center;background:linear-gradient(transparent,rgba(3,5,10,.92))}
.ph-cap b{display:block;font-size:1.45rem;font-weight:900;background:linear-gradient(#fff3c4,#ffb347 55%,#ff7a00);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 10px rgba(255,157,0,.55))}
.ph-cap small{color:#9fdcff;font-size:.8rem;letter-spacing:.5px}
@media(prefers-reduced-motion:reduce){.ph-hero .gear{animation:none}}
#shop #dailyBtn{background:linear-gradient(135deg,#ffb347,#ff7a00);color:#1b0d00;font-weight:800;box-shadow:0 0 18px rgba(255,157,0,.45)}
#shop .tabs{background:rgba(7,19,29,.85);border:1px solid rgba(0,191,255,.3)}
#shop .tabs button.on,#shop .rf button.on{background:linear-gradient(135deg,#00bfff,#0073d9);color:#fff;border-color:transparent;box-shadow:0 0 14px rgba(0,191,255,.55)}
#shop .rf button{border-color:rgba(0,191,255,.3)}
#shop .coinchip{border:1px solid rgba(255,157,0,.6);box-shadow:0 0 12px rgba(255,157,0,.35);color:#ffd48a}
#shop .ic{border:1px solid rgba(114,217,255,.55);box-shadow:0 0 0 1px rgba(0,0,0,.45),0 0 16px rgba(0,191,255,.3),0 8px 22px rgba(255,157,0,.12)}
#shop .ic .price{background:linear-gradient(135deg,#ffb347,#ff7a00);color:#1b0d00;font-weight:800;border:0;box-shadow:0 0 14px rgba(255,157,0,.55)}
#shop .ic .price.poor{background:linear-gradient(135deg,#3b3b44,#26262e);color:#9aa;box-shadow:none}
#shop .ic .own-b{background:rgba(0,191,255,.2);color:#9fdcff;border:1px solid rgba(0,191,255,.5)}
#shop .btn{box-shadow:0 0 14px rgba(0,191,255,.25)}
/* گیفت‌ها: دکمه‌ی 🎁 پروفایل و پنجره‌ی هدیه */
.pf-gift{background:radial-gradient(circle,#0a2a44,#03050a);border:1px solid rgba(114,217,255,.6);box-shadow:0 0 12px rgba(0,191,255,.6),0 0 18px rgba(255,157,0,.35)}
@keyframes giftPulse{50%{transform:scale(1.12);box-shadow:0 0 16px rgba(0,191,255,.85),0 0 24px rgba(255,157,0,.6)}}
.gf-card{background:rgba(7,19,29,.85);border-color:rgba(0,191,255,.3)}
.gf-card.on{border-color:#00bfff;box-shadow:0 0 14px rgba(0,191,255,.65),0 0 20px rgba(255,157,0,.2)}
.gf-amt button{border-color:rgba(0,191,255,.35);background:rgba(7,19,29,.85)}
.gift-grid .gg{box-shadow:0 0 10px rgba(0,191,255,.2)}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lalezar&family=Aref+Ruqaa:wght@700&display=swap" rel="stylesheet">
</head>
<body>

<div id="net" class="hidden">اتصال برقرار نیست. VPN را روشن کنید؛ خودکار دوباره تلاش می‌کنم…</div>

<div id="splash" class="hidden"><div><div class="logo gold-text">پرو چت</div><div class="sp"></div></div></div>
<!-- ورود / ثبت نام -->
<div id="auth">
  <div class="auth-card" id="authCard">
    <div class="logo gold-text">پرو چت</div>
    <p class="sub">گفتگوی عمومی، خصوصی و کلن</p>
    <div class="tabs"><button id="tabLogin" class="on">ورود</button><button id="tabReg">ثبت نام</button></div>
