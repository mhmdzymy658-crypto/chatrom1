    $('pvBox').innerHTML = profileTop(d);
    $('swB').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.b === (d.banner || autoBanner(d.uid))));
    $('swF').querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.f === (d.frame || 'none')));
  };
  paint();
  $('pvBox').onclick = e => { if (e.target.closest('#pfAv')) $('fileAvatar').click(); };
  $('fileAvatar').onchange = async e => { const f = e.target.files[0]; e.target.value = ''; if (!f) return; d.photo = await shrinkImage(f, 256, .8); paint(); };
  $('swB').onclick = e => { const b = e.target.closest('[data-b]'); if (b) { d.banner = b.dataset.b; paint(); } };
  $('swF').onclick = e => { const b = e.target.closest('[data-f]'); if (b) { d.frame = b.dataset.f; paint(); } };
  const bind = (id, k) => $(id).addEventListener('input', e => { d[k] = e.target.value; $('pvBox').innerHTML = profileTop(d); });
  bind('pvName', 'name'); bind('pvBadge', 'badge'); bind('pvTitle', 'title'); bind('pvPat', 'pattern');
  $('modalCard').querySelectorAll('[data-c]').forEach(i => i.addEventListener('input', () => {
    d.charms = [...$('modalCard').querySelectorAll('[data-c]')].map(x => x.value.trim()).filter(Boolean); $('pvBox').innerHTML = profileTop(d);
  }));
  $('pX').onclick = $('pvCancel').onclick = closeModal;
  $('pvSave').onclick = async () => {
    const name = $('pvName').value.trim(); if (!name) return toast('نام را وارد کنید');
    try {
      await updateDoc(doc(db, 'users', me.uid), {
        name, photo: d.photo || '', bio: $('pvBio').value.trim().slice(0, 80), title: ($('pvTitle').value || '').trim().slice(0, 18),
        badge: ($('pvBadge').value || '').trim().slice(0, 4), pattern: ($('pvPat').value || '').trim().slice(0, 4),
        banner: d.banner || '', frame: d.frame || 'none', charms: (d.charms || []).slice(0, 3)
      });
      closeModal(); toast('پروفایل ذخیره شد');
    } catch { toast('ذخیره نشد'); }
  };
}

/* تنظیمات */
$('btnSettings').onclick = () => {
  const T = { gold: '#d4af37', ocean: '#4da3ff', emerald: '#2fd18b', rose: '#ff5f8f', light: '#f2e6b8' };
  openModal(`<h3>تنظیمات</h3><div class="themes">${Object.entries(T).map(([k, c]) => `<button data-t="${k}" style="background:${c}" class="${document.documentElement.dataset.theme === k ? 'on' : ''}" aria-label="تم ${k}"></button>`).join('')}</div>
    <div class="setrow"><span>صدای پیام جدید</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="sndBtn">${soundOn ? 'روشن' : 'خاموش'}</button></div>
    <div class="setrow"><span>اعلان مرورگر</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="ntfBtn">${'Notification' in window && Notification.permission === 'granted' ? 'فعال' : 'فعال‌سازی'}</button></div>
    <div class="setrow"><span>ویرایش پروفایل</span><button class="btn ghost" style="width:auto;padding:6px 16px" id="prfBtn">باز کردن</button></div>
    <div class="acts2"><button class="btn ghost" id="mClose">بستن</button></div>`);
  $('modalCard').querySelectorAll('[data-t]').forEach(b => b.onclick = () => { setTheme(b.dataset.t); $('modalCard').querySelectorAll('[data-t]').forEach(x => x.classList.toggle('on', x === b)); });
  $('sndBtn').onclick = e => { soundOn = !soundOn; localStorage.setItem('snd', soundOn ? '1' : '0'); e.target.textContent = soundOn ? 'روشن' : 'خاموش'; if (soundOn) beep(); };
  $('ntfBtn').onclick = async e => { if ('Notification' in window) { const p = await Notification.requestPermission(); e.target.textContent = p === 'granted' ? 'فعال' : 'مسدود'; } else toast('مرورگر پشتیبانی نمی‌کند'); };
  $('prfBtn').onclick = editProfile; $('mClose').onclick = closeModal;
};

/* گروه */
$('btnNewGroup').onclick = () => {
  const others = Object.values(users).filter(u => u.uid !== me.uid).sort((a, b) => a.name.localeCompare(b.name, 'fa'));
  openModal(`<h3>گروه جدید</h3>
    <div class="field" style="margin-top:12px;text-align:start"><label>نام گروه</label><input id="gName" maxlength="30"></div>
    <div class="field" style="text-align:start"><label>ایموجی گروه</label><input id="gEmoji" value="👥" maxlength="4"></div>
    <div style="text-align:start;color:var(--mut);font-size:.8rem">اعضا</div>
    <div class="pick">${others.map(u => `<label><input type="checkbox" value="${u.uid}"><div class="av sm">${avatarHtml(u)}</div><b>${esc(u.name)}</b></label>`).join('') || '<p class="empty">هنوز کاربر دیگری نیست</p>'}</div>
    <div class="err" id="gErr"></div>
    <div class="acts2"><button class="btn" id="gMake">ساخت گروه</button><button class="btn ghost" id="mClose">انصراف</button></div>`);
  $('mClose').onclick = closeModal;
  $('gMake').onclick = async () => {
    const name = $('gName').value.trim(), sel = [...$('modalCard').querySelectorAll('.pick input:checked')].map(i => i.value);
    if (!name) return $('gErr').textContent = 'نام گروه را بنویسید.';
    if (!sel.length) return $('gErr').textContent = 'حداقل یک عضو انتخاب کنید.';
    const id = 'g_' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
    try {
      await setDoc(doc(db, 'rooms', id), { type: 'group', name, emoji: $('gEmoji').value.trim() || '👥', owner: me.uid, members: [me.uid, ...sel], created: Date.now() });
      closeModal(); openRoom(id);
    } catch { $('gErr').textContent = 'ساخته نشد. قوانین Firestore را بررسی کنید.'; }
  };
};
function showGroup() {
  const r = rooms[room]; if (!r) return;
  const mem = (r.members || []).map(id => users[id]).filter(Boolean);
  openModal(`<div class="av lg" style="margin:auto">${esc(r.emoji || '👥')}</div><h3>${esc(r.name)}</h3>
    <small style="color:var(--mut)">${fa(mem.length)} عضو</small>
    <div class="pick">${mem.map(u => `<label data-u="${u.uid}"><div class="av sm">${avatarHtml(u)}</div><b>${esc(u.name)}${u.uid === r.owner ? ' 👑' : ''}</b></label>`).join('')}</div>
    <div class="acts2">${r.owner !== me.uid ? '<button class="btn danger" id="gLeave">ترک گروه</button>' : ''}<button class="btn ghost" id="mClose">بستن</button></div>`);
  $('mClose').onclick = closeModal;
  $('modalCard').querySelectorAll('[data-u]').forEach(l => l.onclick = () => showProfile(l.dataset.u));
  $('gLeave')?.addEventListener('click', async () => {
    if (!confirm('از گروه خارج می‌شوید؟')) return;
    try { await updateDoc(doc(db, 'rooms', room), { members: arrayRemove(me.uid) }); closeModal(); delete rooms[room]; openRoom('public'); } catch { toast('انجام نشد'); }
  });
}
</script>
</body>
</html>
