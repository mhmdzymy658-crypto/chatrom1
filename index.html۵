      <div class="bub">${acts}
        ${showName ? `<div class="who" data-prof="${m.uid}">${esc(u.name || m.name)}<small>@${esc(u.handle || m.handle)}</small></div>` : ''}
        ${body}${rx ? `<div class="rx">${rx}</div>` : ''}
        <div class="meta">${m.edited && !m.deleted ? '<span>ویرایش‌شده</span>' : ''}<span>${hhmm(ms)}</span>${tick}</div>
